# --- Database (Neon Postgres) ---
# Pooled connection (with ?pgbouncer=true&connect_timeout=10) — used by the app
DATABASE_URL="postgresql://USER:PASS@HOST-pooler.neon.tech/dbname?sslmode=require&pgbouncer=true&connect_timeout=10"
# Direct connection (no pooler) — used by Prisma migrate
DIRECT_URL="postgresql://USER:PASS@HOST.neon.tech/dbname?sslmode=require"

# --- NextAuth ---
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="generate with: openssl rand -base64 32"

# --- Cloudflare R2 (object storage for SCORM packages, certificates, uploads) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="bhn-scorm"
# Public URL of the bucket (R2.dev dev URL or custom domain).
# Example: https://pub-abc123.r2.dev
R2_PUBLIC_URL=""
# Migration aid: comma-separated OLD public bases that should still resolve to
# keys in the CURRENT bucket. Set this to the previous host at an R2/account
# cutover so existing absolute URLs in the DB keep working with no rewrite.
# Example: R2_LEGACY_PUBLIC_URLS="https://pub-old123.r2.dev,https://files.old-domain.com"
R2_LEGACY_PUBLIC_URLS=""

# --- AI (free-tier providers) ---
# Cloudflare Workers AI — primary provider. Required for embeddings.
# CF_ACCOUNT_ID is the same one used for R2; CF_AI_TOKEN needs "Workers AI:Read" scope.
CF_ACCOUNT_ID=""
CF_AI_TOKEN=""

# Google Gemini — fallback for chat when CF is unavailable.
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# --- AutoPipette behaviour-assist (proactive "you look stuck" hints) ---
# Master switch for the whole assist subsystem: client telemetry tracker,
# stuck-scoring, the hint chip dock, the assist_stuck AI inference, and the
# weekly-summary cron. DISABLED by default. Set to "true" to turn it back on.
NEXT_PUBLIC_ASSIST_ENABLED=""

# --- Google Ads conversion tracking ---
# Public tag identifiers only. The Google tag loads after marketing consent,
# and conversion events fire only after each application is stored successfully.
NEXT_PUBLIC_GOOGLE_ADS_ID="AW-18353525375"
NEXT_PUBLIC_GOOGLE_ADS_ENGAGE_LABEL=""
NEXT_PUBLIC_GOOGLE_ADS_EXPERIENCE_LABEL=""
NEXT_PUBLIC_GOOGLE_ADS_VENTURE_CONNECT_LABEL=""

# --- SMTP (login codes, email verification, notifications) ---
# Any SMTP provider works. Verify with Admin → System status → "Send test".
#
# Google Workspace (production sends from info@biohubnet.ca):
#   1. On that mailbox: enable 2-Step Verification, then create an App Password
#      (Google Account → Security → App passwords). Use the 16-char value, no spaces.
#   2. SMTP_USER must equal the From address (Gmail rewrites unverified From).
#   SMTP_HOST="smtp.gmail.com"   SMTP_PORT="465"   SMTP_USER="info@biohubnet.ca"
#   SMTP_PASS="<16-char app password>"   SMTP_FROM="BHN Training <info@biohubnet.ca>"
#   Deliverability: enable DKIM in Workspace Admin (Apps → Gmail → Authenticate email)
#   and keep SPF (include:_spf.google.com) on the domain.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="BHN Training <noreply@example.com>"

# --- Mailchimp newsletter integration ---
# When set, signups that opt in (CASL-compliant active tick) are pushed
# to Mailchimp with status="pending" → Mailchimp emails the user to
# confirm → click flips them to "subscribed". The confirmation click
# is the audit trail; we never single-opt-in.
#
# Where to find these:
#   API key:        Mailchimp Account → Extras → API keys
#   List ID:        Audience → Settings → Audience name and defaults
#   Server prefix:  The "us10" / "us19" / etc. part of the API key
#                   suffix. Optional — derived automatically when omitted.
#   Webhook secret: Generate a random ≥32-char string. Put the same
#                   value in the webhook URL on Mailchimp's side:
#                   https://<your-domain>/api/webhooks/mailchimp?secret=<this>
MAILCHIMP_API_KEY=""
MAILCHIMP_LIST_ID=""
MAILCHIMP_SERVER_PREFIX=""
MAILCHIMP_WEBHOOK_SECRET=""

# --- Algolia (admin global search: users / courses / postings) ---
# Get App ID + keys from the Algolia dashboard's Overview page.
# ALGOLIA_ADMIN_API_KEY has write access — server-only, never expose to the client.
# Run `npx tsx scripts/algolia-sync.ts` after setting these to (re)populate the indices.
ALGOLIA_APP_ID=""
ALGOLIA_ADMIN_API_KEY=""
ALGOLIA_SEARCH_API_KEY=""
