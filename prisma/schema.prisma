generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Roles: user | admin | superadmin | evaluating
model User {
  id                     String    @id @default(cuid())
  name                   String?
  email                  String    @unique
  emailVerified          DateTime?
  image                  String?
  password               String?
  role                   String    @default("trainee") // trainee | evaluating | employer | hr | industrial_mentor | engage_hqp_advisor | equip_grant_reviewer | instructor | admin | superadmin
  isActive               Boolean   @default(true)
  credits                Float     @default(200)
  /// Employer-only: whether they can browse the rest of the platform
  /// (Engage / Experience nav). Off by default — employers see their
  /// portal; admins flip on if a partner needs broader access.
  allowPlatformContent   Boolean   @default(false)
  /// Employer-only: company they post on behalf of. Free text.
  employerCompany        String?
  /// Employer-only company-profile fields. AI auto-fill populates them
  /// from the website on demand; user can edit.
  companyWebsite         String?
  companyLogo            String?
  /// How the logo is masked when rendered on /employer and on
  /// employer-facing surfaces. One of:
  ///   • null / ""   — natural (current behaviour: contained in a
  ///                  circular disc)
  ///   • "circle"    — explicit circle crop
  ///   • "rounded"   — rounded-rectangle mask (rounded-2xl)
  ///   • "square"    — square crop, no rounding
  /// Settable from /employer (Edit Profile modal → Logo shape).
  companyLogoShape       String?
  /// Pan + zoom transform applied to the company logo inside its
  /// shape mask. Stored as JSON `{ offsetX: number, offsetY: number,
  /// scale: number }` where offsets are pixels relative to the
  /// preview-size container (display-resolution agnostic — the
  /// renderer normalises). null === no transform === default
  /// `(0, 0, 1)`.
  ///
  /// Settable from /employer's Edit Profile modal → Crop & centre.
  /// Auto-fit computes the transform from the image's non-
  /// transparent bounding box; the manual cropper lets the
  /// operator dial it in by hand if Auto-fit gets it wrong.
  companyLogoTransform   Json?
  /// Per-company brand tokens — drives the hero gradient + accent
  /// colours on /employer so every company page reads as its own
  /// brand. JSON blob populated either by the brand-fetch endpoint
  /// (which scans the homepage for theme-color, CSS vars, and asks
  /// the LLM for a second opinion) or hand-tuned in the Edit
  /// Profile modal's Brand section.
  ///
  /// Shape (all optional, all hex strings unless noted):
  ///   {
  ///     primary?:    "#RRGGBB",
  ///     secondary?:  "#RRGGBB",
  ///     accent?:     "#RRGGBB",
  ///     style?:      "gradient" | "solid"
  ///   }
  ///
  /// See src/lib/employer/brand.ts.
  companyBrand           Json?
  companyIndustry        String?
  companySize            String? // "1-10" | "11-50" | etc.
  companyLocation        String?
  companyDescription     String?
  companyFounded         String? // year as string (free-form)
  // Main business + flagship products, one-line. Surfaced beside the
  // company About-quote on /employer. Optional — auto-filled from the
  // website's homepage when the operator runs URL auto-fill.
  companyMainBusiness    String?
  // Stock ticker, e.g. "BAYN.DE", "MRK", "NVDA". Optional — only
  // present for publicly-listed employers. Surfaced as a small badge.
  companyTicker          String?
  lastLoginAt            DateTime?
  newsletterSubscribed   Boolean   @default(false)
  newsletterSubscribedAt DateTime?
  /// Three-state intent declared at signup:
  ///   "subscribe" — wants to be added (default UI choice)
  ///   "no"        — not interested
  ///   "already"   — already on the BioHubNet list
  /// Admins use this to filter the "new opt-ins to export" view.
  newsletterStatus       String    @default("no")
  /// When an admin last copied this user to the clipboard from
  /// /admin/newsletter. Null = not yet exported. Filtered against this
  /// to only show new sign-ups in the export view.
  newsletterExportedAt   DateTime?
  /// Mailchimp audience-member ID (md5(lowercased email)) — set when
  /// the register API successfully pushed a "pending" subscribe to
  /// Mailchimp. Used to PATCH/DELETE the member idempotently on
  /// subsequent state changes.
  mailchimpMemberId      String?
  /// Last-known Mailchimp-side state:
  ///   pending      — DOI confirmation email sent, not yet clicked
  ///   subscribed   — user clicked the confirmation link, on the list
  ///   unsubscribed — left via a Mailchimp email (webhook updated us)
  ///   cleaned      — bounced + scrubbed by Mailchimp
  ///   error        — last push failed; admin can retry from the
  ///                  /admin/newsletter page.
  /// Null = never pushed to Mailchimp (legacy users, or signup was
  /// before the integration shipped).
  mailchimpStatus        String?
  /// When the BHN side last reconciled with Mailchimp (push attempt
  /// or inbound webhook event). Helps the audit trail + lets admins
  /// see which rows are stale.
  mailchimpSyncedAt      DateTime?
  /// Account category: "real" | "sandbox" | "demo" | "showcase" | "phantom".
  ///   sandbox  — admin's personal play pair (one employer + one trainee
  ///              per admin). Never auto-deletes.
  ///   demo     — time-limited demo workspace claimed by a prospective
  ///              partner. Cleaned up when demoExpiresAt < NOW().
  ///   showcase — single global "showcase trainee" account used for
  ///              sales calls and training-team demos. Pre-populated
  ///              with the full advanced-trainee journey: completed
  ///              courses, completed pathway, certificates, both
  ///              earned merch rewards, full job profile (resume +
  ///              1-min video + elevator pitch), scheduled
  ///              interviews. Refreshable; never expires.
  ///   phantom  — ephemeral test trainee/employer spawned by an admin
  ///              for one-day testing (e.g. populate the Manage
  ///              Enrollments page with throwaway rows). Cleaned up
  ///              when demoExpiresAt < NOW() by the phantom sweeper —
  ///              separate cleanup path from demos so the two volumes
  ///              don't tangle. Default TTL 24 h, admin-extendable.
  /// All admin counts and stats default to filtering for "real" only.
  accountKind            String    @default("real")
  /// Set on demo + phantom accounts; the respective sweepers delete the
  /// user + all owned rows once this passes. Null on real, sandbox,
  /// and showcase accounts. (Name kept for backwards compatibility —
  /// the field is effectively a generic "auto-delete after" timestamp.)
  demoExpiresAt          DateTime?
  /// Set on sandbox + demo accounts; tracks the admin who minted them
  /// so the admin sees their own sandboxes first in the panel.
  createdByAdminId       String?
  createdByAdmin         User?     @relation("CreatedSandboxes", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  createdSandboxes       User[]    @relation("CreatedSandboxes")
  /// Bearer-token magic link for sandbox + demo accounts only. Anyone
  /// holding this token can sign in as the user via /sandbox/[token].
  /// Real accounts have null here — the route refuses to issue a JWT
  /// for accountKind="real" even if a token were somehow set, so a leak
  /// can never escalate to a real-user takeover.
  magicToken             String?   @unique
  /// Email-verification token (distinct from magicToken so revoking
  /// one doesn't disturb the other). Set on register, cleared when
  /// the user clicks the verification link. emailVerifyExpires gates
  /// reuse — typically 7 days from issue.
  emailVerifyToken       String?   @unique
  emailVerifyExpires     DateTime?
  /// MFA / TOTP. Opt-in per user; admins can require for their role
  /// in a follow-up. Secret is base32 + works with any RFC 6238
  /// authenticator (Google Authenticator, 1Password, Authy, …).
  totpSecret             String?
  totpEnabledAt          DateTime?
  /// Brute-force lockout. Threshold 5 → 30-min lock; resets on a
  /// successful sign-in. lastFailedLoginAt drives an audit trail
  /// surface; the count itself controls the gate.
  failedLoginCount       Int       @default(0)
  lockedUntil            DateTime?
  lastFailedLoginAt      DateTime?
  /// 21 CFR Part 11 §11.300(b) — periodic password revisions.
  /// Backfilled from createdAt for existing accounts.
  passwordUpdatedAt      DateTime?
  /// How the user wants to be addressed in greetings ("Welcome
  /// back, X."). Independent from `name` (their legal/full name) so
  /// users can be greeted by their preferred form — first name,
  /// first + middle, Dr./Mr./Mrs./Prof. + last, or any custom
  /// string — without changing how their name appears in records,
  /// emails, certificates, etc. Null until the user has chosen
  /// (after first login the dashboard surfaces a small prompt;
  /// they can change later via the pencil-icon next to the
  /// greeting). When null, the greeting falls back to the full
  /// `name`.
  preferredName          String?
  /// Trainee-facing "My Application" artifacts. Stored on the user
  /// so they survive across talent-application submissions; the
  /// trainee manages them from /profile/application.
  resumeUrl              String?
  videoIntroUrl          String?
  elevatorPitch          String?
  applicationUpdatedAt   DateTime?
  /// Onboarding progress: { version, seenStepIds[], minimized, dismissed, completedAt }
  onboarding             Json?
  /// First-login gamified ritual — flips true the moment the user
  /// finishes the "split a cell" interactive walkthrough at
  /// /welcome/split-a-cell. Trainee / evaluating roles that hit
  /// /dashboard with this still false get redirected to the game.
  /// Admins can replay any time via /welcome/split-a-cell?replay=1.
  hasSplitCell           Boolean   @default(false)
  /// GDPR/CCPA consent: { necessary, analytics, marketing, version, acceptedAt }
  consent                Json?
  /// Preferred UI language ISO code: en | es | fr | zh
  locale                 String    @default("en")
  phone                  String?
  bio                    String?
  organization           String?
  jobTitle               String?
  country                String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  accounts                 Account[]
  sessions                 Session[]
  enrollments              Enrollment[]
  courseFavorites          CourseFavorite[]
  scormSessions            ScormSession[]
  xapiStatements           XapiStatement[]
  certificates             Certificate[]
  certificationCredentials CertificationCredential[]
  instructedCourses        Course[]                  @relation("Instructor")
  assessmentAttempts       AssessmentAttempt[]
  creditTransactions       CreditTransaction[]
  groupMemberships         GroupMembership[]
  auditLogs                AuditLog[]
  creditApplications       CreditApplication[]       @relation("Applicant")
  reviewedApplications     CreditApplication[]       @relation("Reviewer")
  roleRequests             RoleChangeRequest[]       @relation("RoleRequester")
  reviewedRoleRequests     RoleChangeRequest[]       @relation("RoleReviewer")
  buddiesInitiated         BuddyPair[]               @relation("InitiatorBuddies")
  buddiesPartnered         BuddyPair[]               @relation("PartnerBuddies")
  buddyMessages            BuddyMessage[]            @relation("BuddyMessageSender")

  // Phase 1–5 additions
  skills                UserSkill[]
  applicationStatuses   ApplicationStatus[]   @relation("Applicant")
  statusEdits           ApplicationStatus[]   @relation("StatusEditor")
  interviews            Interview[]           @relation("Interviewee")
  scheduledInterviews   Interview[]           @relation("Interviewer")
  accessRequestsHandled AccessRequest[]       @relation("AccessRequestHandler")
  formSubmissions       EventFormSubmission[] @relation("FormSubmitter")
  savedPostings         UserSavedPosting[]    @relation("SavedPostingUser")
  reviewBookmarks       ReviewBookmark[]
  signatures            ElectronicSignature[]
  // Users can own multiple structured resumes (a base + tailored
  // copies per posting). The 20260706 migration dropped the
  // @unique constraint on Resume.userId; this relation is now
  // one-to-many. Callers that want "the user's main resume" look up
  // most-recently-edited non-archived (see lib/resume/active.ts).
  resumes               Resume[]              @relation("UserResume")
  resumeComments        ResumeComment[]       @relation("ResumeCommentAuthor")
  /// Singleton master resume — the user's library of every bullet
  /// they've ever written. See model MasterResume.
  masterResume          MasterResume?         @relation("UserMasterResume")

  /// AI Job-Tailoring module — external jobs, tailoring attempts, and
  /// the user's learned rules. See model TailoringJob.
  tailoringJobs  TailoringJob[]  @relation("UserTailoringJobs")
  tailoringRuns  TailoringRun[]  @relation("UserTailoringRuns")
  tailoringRules TailoringRule[] @relation("UserTailoringRules")

  // Loyalty / merch rewards. `merchRewards` is the trainee's own
  // claimed/unclaimed reward records; `fulfilledMerch` is the queue
  // an admin has personally marked as shipped.
  merchRewards   MerchReward[]
  fulfilledMerch MerchReward[] @relation("MerchFulfiller")

  // Launch readiness checklist — admin tooling only.
  ownedChecklistItems   LaunchChecklistState[] @relation("ChecklistOwner")
  updatedChecklistItems LaunchChecklistState[] @relation("ChecklistUpdater")

  // ── Events module relations ──
  // Single-tenant Events module. See models grouped at the bottom of
  // this schema. Adding back-relations here so Prisma can validate.
  eventRegistrations       Registration[]
  workshopBookings         WorkshopBooking[]
  personalAgenda           PersonalAgendaEntry[]
  eventQuestions           SymposiumQuestion[]
  eventQuestionVotes       SymposiumQuestionVote[]
  eventPollResponses       PollResponse[]
  // Approver back-relations — populated when this user (an admin)
  // approves another attendee's Registration or WorkshopBooking out
  // of `pending`. SetNull on User delete so the audit row survives.
  approvedRegistrations    Registration[]          @relation("RegistrationApprover")
  approvedWorkshopBookings WorkshopBooking[]       @relation("WorkshopBookingApprover")
  // Event-host attribution + broadcast authorship (Phase 3).
  hostedEvents             EventHost[]             @relation("UserEventHost")
  authoredBroadcasts       EventBroadcast[]        @relation("UserEventBroadcast")

  // Research synthesis authoring — per-period "what users told us"
  // notes on /admin/insights. SetNull on delete keeps the synthesis
  // row but loses the author link.
  authoredResearchInsights ResearchInsight[] @relation("ResearchInsightAuthor")
  updatedResearchInsights  ResearchInsight[] @relation("ResearchInsightUpdater")

  // Application-prep + STAR-story relations. Cascade on user delete:
  // both rows are user-private artefacts with no audit value once the
  // owner is gone.
  prepSessions PrepSession[] @relation("UserPrepSession")
  starStories  StarStory[]   @relation("UserStarStory")

  // Hiring pipeline relations — offers + interview scores authored
  // (HR side) and offers received (trainee side).
  offersAuthored  Offer[]          @relation("OfferAuthor")
  offersReceived  Offer[]          @relation("OfferRecipient")
  interviewScores InterviewScore[] @relation("InterviewScorer")

  // ── Theme feedback relations ──
  // Per-user theme votes + theme proposals (user-submitted ideas).
  // Admin reviews via /admin/theme-proposals; "ship + bounty"
  // optionally issues a tier-3 MerchReward.
  themeVotes             ThemeVote[]
  themeProposals         ThemeProposal[] @relation("ThemeProposals")
  reviewedThemeProposals ThemeProposal[] @relation("ThemeProposalReviewer")

  // ── Application-comment + feedback relations ──
  // Admin / employer comments authored on talent-application
  // submissions; the talent-pool exit-survey row when they leave;
  // any feedback invites issued or received.
  applicationComments     ApplicationComment[] @relation("ApplicationCommentAuthor")
  poolExitFeedback        PoolExitFeedback[]   @relation("PoolExitFeedbackUser")
  feedbackInvitesReceived FeedbackInvitation[] @relation("FeedbackInvitationUser")
  feedbackInvitesSent     FeedbackInvitation[] @relation("FeedbackInvitationInvitedBy")

  // ── AI behaviour-assist relations ──
  // Raw behaviour events, daily / weekly rollups, surfaced hints,
  // per-user prefs. All cascade-delete with the user — privacy
  // posture is "if the user leaves, their assist trail leaves
  // with them".
  assistEvents       AssistEvent[]
  assistRollups      AssistDailyRollup[]
  assistSummaries    AssistWeeklySummary[]
  assistHints        AssistHint[]
  assistHintFeedback AssistHintFeedback[]
  assistPreferences  AssistPreferences?

  // Equip — funding-application pipeline (third pillar after
  // Engage / Experience). One user can hold multiple applications
  // across the two streams (VentureConnect ≤ $5K, VentureLift
  // ≤ $25K), and the same admin user can also be the reviewer on
  // other people's apps — hence two named relations.
  equipApplications EquipApplication[]        @relation("EquipApplicant")
  equipReviewed     EquipApplication[]        @relation("EquipReviewer")
  equipMessages     EquipApplicationMessage[]

  // Committee memberships — see CommitteeMembership model. A user
  // can belong to zero or more committees (Equip review, HQP, …).
  // Each membership unlocks a sidebar section + welcome-screen
  // badge for that user, and (for the equip_review committee)
  // grants /admin/equip review access without needing the admin
  // primary role.
  committees CommitteeMembership[]

  // Equip deadline audit relations — who created / closed /
  // extended each funding window. The triple relation is needed
  // because Prisma's relation discovery requires unambiguous
  // names when one model points at the same target three times.
  equipDeadlinesCreated  EquipDeadline[] @relation("EquipDeadlineCreator")
  equipDeadlinesClosed   EquipDeadline[] @relation("EquipDeadlineCloser")
  equipDeadlinesExtended EquipDeadline[] @relation("EquipDeadlineExtender")

  // HQP advisory committee — member applications + the open-
  // call windows. See models below for the workflow.
  hqpApplications   HqpMemberApplication[] @relation("HqpApplicant")
  hqpAppsDecided    HqpMemberApplication[] @relation("HqpAppDecider")
  hqpWindowsCreated HqpApplicationWindow[] @relation("HqpWindowCreator")

  // HQP feedback rounds — admin-published topic sets that
  // committee members respond to.
  hqpRoundsCreated HqpFeedbackRound[]    @relation("HqpRoundCreator")
  hqpResponses     HqpFeedbackResponse[] @relation("HqpResponder")

  // HQP meetings / action items / COI relations
  hqpMeetingsCreated HqpMeeting[]           @relation("HqpMeetingCreator")
  hqpAttendance      HqpMeetingAttendance[] @relation("HqpAttendee")
  hqpActionsCreated  HqpActionItem[]        @relation("HqpActionCreator")
  hqpActionsAssigned HqpActionItem[]        @relation("HqpActionAssignee")
  hqpCoiDisclosures  HqpCoiDisclosure[]     @relation("HqpCoiDeclarer")

  // CMS-authored pages — author + last-editor relations.
  pagesCreated Page[] @relation("PageCreatedBy")
  pagesUpdated Page[] @relation("PageUpdatedBy")

  // Role-play simulator — generated templates and per-trainee attempts.
  // SetNull on user delete preserves the generated template for reuse.
  simulationsCreated   Simulation[]        @relation("SimulationCreator")
  simulationAttempts   SimulationAttempt[]
  simulationRequests   SimulationRequest[] @relation("SimulationRequestRequester")
  simulationsProcessed SimulationRequest[] @relation("SimulationRequestProcessor")

  /// Job folders — per-application bundles owned by this user. Each
  /// folder ties together a JD snippet (or full posting), a tailored
  /// resume, a cover letter, and an interview prep guide. See
  /// JobFolder model below + /profile/job-folders.
  jobFolders JobFolder[] @relation("UserJobFolders")

  /// Per-user sidebar / feature preferences. JSON blob with shape:
  ///   {
  ///     hidden: string[];  // feature ids the user has toggled off
  ///     order:  string[];  // explicit ordering for visible items;
  ///                        // any id not in this array uses the
  ///                        // registry's default order.
  ///   }
  ///
  /// Null / empty → use registry defaults. Per-user only — never
  /// affects other users' view of the platform. See
  /// src/lib/preferences/registry.ts for the source of truth on
  /// what's toggleable; whenever a sidebar nav item is added or
  /// removed, also update that registry.
  featurePrefs Json?

  // ── Employer team portal — back-relations ──
  // See docs/plans/employer-team-portal.md for the full architecture.
  // Promotes the employer surface from single-seat to a shared
  // company workspace. Existing employer User rows get a mirrored
  // Company + owner CompanyMember from the backfill script.
  companyMemberships         CompanyMember[]          @relation("CompanyMembership")
  companyMemberInvitedBy     CompanyMember[]          @relation("CompanyMemberInviter")
  companyInvitesSent         CompanyInvite[]          @relation("CompanyInviteSender")
  companyInvitesAccepted     CompanyInvite[]          @relation("CompanyInviteAccepter")
  companyJoinRequestsMade    CompanyJoinRequest[]     @relation("CompanyJoinRequester")
  companyJoinRequestsDecided CompanyJoinRequest[]     @relation("CompanyJoinDecider")
  activityActions            EmployerActivityLog[]    @relation("ActivityActor")
  activityAsApplicant        EmployerActivityLog[]    @relation("ActivityApplicant")
  activityAsTarget           EmployerActivityLog[]    @relation("ActivityTarget")
  applicantTeamComments      ApplicantTeamComment[]   @relation("ApplicantTeamCommentAuthor")
  postingTeamMemberships     PostingTeamMember[]      @relation("PostingTeamMembership")
  postingTeamAdded           PostingTeamMember[]      @relation("PostingTeamAdder")
  emailTemplatesAuthored     EmailTemplate[]          @relation("EmailTemplateAuthor")
  scorecardsSubmitted        ScorecardSubmission[]    @relation("ScorecardInterviewer")
  notifications              Notification[]           @relation("NotificationRecipient")
  notificationPreferences    NotificationPreference[] @relation("NotificationPrefUser")
  postingsLastTouched        InternshipPosting[]      @relation("PostingLastTouch")
  statusesLastTouched        ApplicationStatus[]      @relation("StatusLastTouch")
  employerPresencePings      EmployerPresencePing[]   @relation("EmployerPresenceUser")

  // Reporting suite — back-relations.
  hiringTargetsOwned      HiringTarget[]             @relation("HiringTargetOwner")
  hiringTargetsAuthored   HiringTarget[]             @relation("HiringTargetAuthor")
  recruitingCostsAuthored RecruitingCost[]           @relation("RecruitingCostAuthor")
  statusHistoryActions    ApplicationStatusHistory[] @relation("StatusHistoryActor")

  @@index([newsletterStatus, newsletterExportedAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Short-lived 6-digit codes emailed to users for passwordless login.
/// codeHash is bcrypt; we never store the plaintext. Single-use — the
/// row is deleted on successful verification. attempts caps brute force.
model LoginCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email, expiresAt])
}

/// Editable registration / signup forms. The `fields` JSON stores an
/// array of FormField objects (see src/lib/forms/types.ts). Admins can
/// edit labels / required-flags / options without a migration.
model EventForm {
  id          String                @id @default(cuid())
  slug        String                @unique
  title       String
  description String?
  fields      Json
  active      Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  submissions EventFormSubmission[]
}

/// One-time invite issued by an admin so an Employer HR partner can
/// self-sign-up and land directly on the employer role. The token is a
/// long random string; the recipient hits /signup/employer/[token] to
/// claim. Used invites stay around for the audit trail.
model EmployerInvite {
  id             String    @id @default(cuid())
  email          String
  token          String    @unique
  /// Optional: company name pre-filled at claim time.
  companyName    String?
  /// Optional: company website pre-filled at claim time.
  companyWebsite String?
  invitedById    String?
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  usedAt         DateTime?
  usedById       String?
  /// Phase 6 demo-mode: read-only preview link admins can hand to a
  /// prospective partner so they can browse the portal before committing.
  demoMode       Boolean   @default(false)
  /// Each magic-link click bumps these. Useful for the admin's
  /// "did they open the link" signal.
  openCount      Int       @default(0)
  lastOpenedAt   DateTime?

  @@index([email])
  @@index([invitedById, createdAt])
}

/// Public access-request inbox. The /for-employers and /for-trainees
/// marketing pages let visitors leave their email; admins triage from
/// /admin/access-requests and approve into an EmployerInvite or a
/// trainee welcome.
model AccessRequest {
  id          String    @id @default(cuid())
  kind        String // "employer" | "trainee"
  email       String
  name        String?
  company     String?
  website     String?
  message     String?
  source      String    @default("for-employers")
  status      String    @default("pending") // pending | approved | rejected
  handledAt   DateTime?
  handledById String?
  handledBy   User?     @relation("AccessRequestHandler", fields: [handledById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([status, createdAt])
  @@index([kind])
}

/// Skill ontology — every Course, InternshipPosting, and User attaches
/// to canonical Skill rows so the matching engine can reason about a
/// shared vocabulary instead of free strings.
model Skill {
  id           String                      @id @default(cuid())
  name         String                      @unique
  slug         String                      @unique
  category     String?
  description  String?
  /// 384-d BGE-small embedding; managed via raw SQL (pgvector).
  embedding    Unsupported("vector(384)")?
  status       String                      @default("active") // active | deprecated | merged
  mergedIntoId String?
  mergedInto   Skill?                      @relation("SkillMerge", fields: [mergedIntoId], references: [id])
  mergedFrom   Skill[]                     @relation("SkillMerge")
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt

  aliases  SkillAlias[]
  courses  CourseSkill[]
  users    UserSkill[]
  postings PostingSkill[]
  // STAR stories tagged with this skill. Drives the "you have a
  // story for this skill" hint in the prep flow.
  stories  StarStorySkill[]

  @@index([status])
  @@index([category])
}

model SkillAlias {
  id        String   @id @default(cuid())
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  alias     String   @unique
  createdAt DateTime @default(now())

  @@index([skillId])
}

model CourseSkill {
  id         String   @id @default(cuid())
  courseId   String
  skillId    String
  weight     Float    @default(0.5)
  source     String   @default("ai") // ai | admin | seed
  confidence Float?
  createdAt  DateTime @default(now())
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([courseId, skillId])
  @@index([skillId])
}

model UserSkill {
  id        String   @id @default(cuid())
  userId    String
  skillId   String
  level     Float    @default(0.5)
  source    String   @default("inferred") // self | resume | ai | inferred | admin
  /// JSON: { courseIds?: string[], resumeLine?: string, note?: string }
  evidence  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
}

model PostingSkill {
  id         String            @id @default(cuid())
  postingId  String
  skillId    String
  weight     Float             @default(0.5)
  required   Boolean           @default(true)
  source     String            @default("ai") // ai | admin | employer
  confidence Float?
  createdAt  DateTime          @default(now())
  posting    InternshipPosting @relation(fields: [postingId], references: [id], onDelete: Cascade)
  skill      Skill             @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([postingId, skillId])
  @@index([skillId])
}

/// Phase 4 kanban: tracks an applicant's status per posting. One row
/// per (postingId, applicantId) — created lazily when the employer
/// first interacts with the application.
///
/// Status string is free-form but conventionally one of:
///   new | reviewing | shortlisted | interview_scheduled |
///   interviewed | offer | hired | passed | withdrawn | closed
///
/// `stageEnteredAt` is updated by the transition service every time
/// `status` changes — drives pipeline-analytics time-in-stage. The
/// older `updatedAt` reflects ANY column change; `stageEnteredAt`
/// reflects status-only.
model ApplicationStatus {
  id              String   @id @default(cuid())
  postingId       String
  applicantId     String
  status          String   @default("new") // see header comment
  /// When the current `status` was set. Stamped by the transition
  /// service so pipeline analytics can compute time-in-stage without
  /// needing a separate event-log query.
  stageEnteredAt  DateTime @default(now())
  notes           String?
  rating          Int?
  /// Cover letter the trainee writes at apply time — "why I'm a fit
  /// for this role". Distinct from `notes` (which is trainee-
  /// private); the cover letter IS surfaced to the employer on the
  /// applicant detail view.
  coverLetter     String?
  /// Reason the application was passed/rejected/withdrawn — visible
  /// to the trainee on transition emails when set. Null = no public
  /// reason (we may still email a polite "moved on" note).
  rejectionReason String?
  /// Internal-only note the employer team uses for deliberation.
  /// Never surfaced to the trainee.
  employerNote    String?
  /// Reporting: where this application originated. Captured at apply
  /// time; null on pre-existing rows + imports → reported as "Unknown".
  /// "bhn_board" | "direct_email" | "employer_site" | "referral" |
  /// "talent_pool" | "import" | "unknown".
  source          String?
  /// Free-text qualifier for `source` (referrer name, campaign tag).
  sourceDetail    String?
  updatedById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  /// Employer-team-portal: denormalised last-touch attribution for
  /// the inline chip on the applicant card ("Touched by Sarah · 14m
  /// ago"). Distinct from `updatedById` because comment writes update
  /// `lastTouched*` without touching `updatedById` (which today only
  /// records status/note/rating edits).
  lastTouchedAt   DateTime?
  lastTouchedById String?

  posting   InternshipPosting @relation(fields: [postingId], references: [id], onDelete: Cascade)
  applicant User              @relation("Applicant", fields: [applicantId], references: [id], onDelete: Cascade)
  updatedBy User?             @relation("StatusEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  offer     Offer?

  // Employer team portal back-relations.
  lastTouchedBy User?                  @relation("StatusLastTouch", fields: [lastTouchedById], references: [id], onDelete: SetNull)
  teamComments  ApplicantTeamComment[]
  scorecards    ScorecardSubmission[]  @relation("ApplicationStatusScorecards")

  // Reporting back-relations.
  statusHistory ApplicationStatusHistory[]
  demographics  ApplicationDemographics?

  @@unique([postingId, applicantId])
  @@index([status])
  @@index([postingId, status, stageEnteredAt])
  @@index([postingId, source])
}

/// Phase 5 interview scheduling. Lightweight: employer proposes time
/// slots, applicant accepts one. No external calendar integration in v1.
model Interview {
  id            String    @id @default(cuid())
  postingId     String
  applicantId   String
  scheduledById String
  proposedSlots Json // ISO[] strings
  acceptedSlot  DateTime?
  status        String    @default("proposed") // proposed | accepted | declined | completed | cancelled
  format        String? // phone | video | onsite
  location      String?
  notes         String?
  respondedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  posting         InternshipPosting @relation(fields: [postingId], references: [id], onDelete: Cascade)
  applicant       User              @relation("Interviewee", fields: [applicantId], references: [id], onDelete: Cascade)
  scheduledBy     User              @relation("Interviewer", fields: [scheduledById], references: [id], onDelete: Cascade)
  interviewScores InterviewScore[]

  @@index([postingId])
  @@index([applicantId])
  @@index([status])
}

// ───────────────────────────────────────────────────────────────
// Employer team portal — multi-user company workspace.
// See docs/plans/employer-team-portal.md for the full architecture.
//
// The unit of ownership moves from User (single-seat employer) to
// Company. Existing employer Users get mirrored into a Company +
// owner CompanyMember by the backfill script; postings, applicants,
// activity, and notifications scope to the Company. Per-posting
// `PostingTeamMember` rows narrow notification fan-out to "the
// people actually working on this req."
// ───────────────────────────────────────────────────────────────

/// The employer account itself — promoted out of the User row so a
/// company can have many member users. All company-shaped data
/// (brand, logo, profile copy, postings) hangs off this. Existing
/// User-side company fields stay populated through the migration
/// for read-path fallback; a later migration drops them.
model Company {
  id     String  @id @default(cuid())
  /// Display name — what shows on the brand-stage banner and on
  /// every posting card. Free-form; not unique.
  name   String
  /// Lower-cased canonical domain (e.g. "sanofi.com"). Drives the
  /// signup-time auto-suggest panel + brand-fetch defaults. Not
  /// unique — two companies with the same domain is rare but legal
  /// (consultancies, parent/subsidiary).
  domain String?

  // ── Brand / profile fields (mirrored off User during migration) ──
  website       String?
  logo          String?
  logoShape     String?
  logoTransform Json?
  brand         Json?
  industry      String?
  size          String?
  location      String?
  description   String?
  founded       String?
  mainBusiness  String?
  ticker        String?

  /// "real" | "demo" | "sandbox" — mirrors User.accountKind so demo
  /// companies can be swept on expiry by the same cleanup job.
  kind          String    @default("real")
  demoExpiresAt DateTime?

  /// Gates the Diversity/DEI pipeline report. OFF until voluntary
  /// self-ID capture + legal/compliance sign-off are in place. When
  /// false, /employer/reports/diversity shows a gated empty state and
  /// no demographics are collected at apply time.
  deiReportingEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members           CompanyMember[]
  invites           CompanyInvite[]
  joinRequests      CompanyJoinRequest[]
  postings          InternshipPosting[]
  activityEntries   EmployerActivityLog[]
  templates         EmailTemplate[]
  notifications     Notification[]
  notificationPrefs NotificationPreference[]
  hiringTargets     HiringTarget[]
  recruitingCosts   RecruitingCost[]

  @@index([domain])
  @@index([kind, demoExpiresAt])
}

/// A user's membership in a company. (companyId, userId) is unique
/// — a user has at most one role per company.
model CompanyMember {
  id          String    @id @default(cuid())
  companyId   String
  userId      String
  /// "owner" | "manager" | "generalist" | "viewer"
  role        String
  /// User-supplied job title for display ("HR Director", "Talent
  /// Partner — North America"). Optional; UI falls back to the role
  /// label when null.
  title       String?
  /// Who invited this member in. Null for the seed-owner row
  /// created during the single-seat → multi-seat migration.
  invitedById String?
  joinedAt    DateTime  @default(now())
  /// Last time this member loaded any /employer/* page — drives
  /// the "active in last 7 days" chip on the team menu.
  lastSeenAt  DateTime?

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User    @relation("CompanyMembership", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User?   @relation("CompanyMemberInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([companyId, userId])
  @@index([userId])
  @@index([companyId, role])
}

/// A pending invite — issued by an Owner/Manager, redeemed when the
/// invitee follows the link and accepts. Tokens are single-use,
/// random enough that we never need to rate-limit guessing.
model CompanyInvite {
  id          String  @id @default(cuid())
  companyId   String
  email       String
  /// Role they'd hold after accepting.
  role        String
  /// User-supplied title hint, surfaced on the accept page.
  title       String?
  token       String  @unique
  invitedById String
  /// Optional personal note from the inviter; surfaced on the
  /// accept page so the invitee knows the context.
  note        String?

  /// "pending" | "accepted" | "revoked" | "expired"
  status       String    @default("pending")
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?
  createdAt    DateTime  @default(now())

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy  User    @relation("CompanyInviteSender", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedBy User?   @relation("CompanyInviteAccepter", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([email, status])
}

/// Pending request from a user who signed up with a matching email
/// domain but no Owner has approved them yet. Owner / Manager sees
/// these in the team panel and approves with one click — the
/// suggested role is pre-filled by the title→role auto-detect at
/// request time, but the approver can override before approving.
model CompanyJoinRequest {
  id            String    @id @default(cuid())
  companyId     String
  requesterId   String
  /// Pre-filled from title→role auto-detect.
  suggestedRole String
  /// Optional message from the requester.
  note          String?
  /// "pending" | "approved" | "declined" | "superseded"
  status        String    @default("pending")
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requester User    @relation("CompanyJoinRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  decidedBy User?   @relation("CompanyJoinDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([companyId, requesterId, status])
  @@index([companyId, status])
}

/// One row per attributable team action. The /employer/activity
/// feed reads from here. Inline attribution chips read from
/// denormalised `lastTouched*` columns on ApplicationStatus +
/// InternshipPosting — kept in sync from the same write path.
model EmployerActivityLog {
  id           String  @id @default(cuid())
  companyId    String
  actorId      String
  /// "posting_created" | "posting_edited" | "posting_closed" |
  /// "stage_changed" | "applicant_commented" | "interview_scheduled" |
  /// "scorecard_submitted" | "offer_sent" | "offer_accepted" |
  /// "applicant_hired" | "applicant_rejected" | "bulk_email_sent" |
  /// "bulk_rejected" | "template_created" | "template_edited" |
  /// "member_invited" | "member_joined" | "member_role_changed" |
  /// "member_removed" | "join_request_approved" | "join_request_declined"
  kind         String
  /// Structured payload — what changed, prev/next values, ref IDs.
  /// Shape depends on `kind`; the feed renderer has per-kind copy
  /// templates that parse it.
  payload      Json
  /// Optional FKs for the common targets so the feed can join
  /// efficiently without parsing payload JSON.
  postingId    String?
  applicantId  String?
  targetUserId String?

  createdAt DateTime @default(now())

  company    Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actor      User               @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Cascade)
  posting    InternshipPosting? @relation("PostingActivity", fields: [postingId], references: [id], onDelete: SetNull)
  applicant  User?              @relation("ActivityApplicant", fields: [applicantId], references: [id], onDelete: SetNull)
  targetUser User?              @relation("ActivityTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  notifications Notification[]

  @@index([companyId, createdAt])
  @@index([companyId, kind, createdAt])
  @@index([postingId, createdAt])
  @@index([applicantId, createdAt])
}

/// Threaded team discussion on a single applicant — scoped to a
/// (posting, applicant) pair so HR can debate fit per-role. Distinct
/// from the existing ApplicationComment (which is on
/// EventFormSubmission, for talent-pool review).
model ApplicantTeamComment {
  id                  String   @id @default(cuid())
  applicationStatusId String
  authorId            String
  /// Role at write time — preserved through future role changes.
  authorRoleAtWrite   String
  body                String
  /// User IDs the author @mentioned in the body. Drives the
  /// Notification fan-out. We extract IDs at write time and pin them
  /// so future renaming / edit-of-the-body doesn't lose the original
  /// ping target.
  mentions            String[]
  /// Optional FK to a parent comment, for one-level threading.
  parentId            String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  applicationStatus ApplicationStatus      @relation(fields: [applicationStatusId], references: [id], onDelete: Cascade)
  author            User                   @relation("ApplicantTeamCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parent            ApplicantTeamComment?  @relation("ApplicantTeamCommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies           ApplicantTeamComment[] @relation("ApplicantTeamCommentReplies")

  @@index([applicationStatusId, createdAt])
}

/// Who's working on this specific req. A posting has at most one
/// recruiter and at most one hiring_manager (enforced in app code,
/// not at DB level so we can do swaps in one transaction). N
/// interviewers + N observers allowed.
///
/// This is the targeting scope for notifications: @-pings on a
/// candidate notify the posting's team first, not the whole company.
model PostingTeamMember {
  id        String   @id @default(cuid())
  postingId String
  userId    String
  /// "recruiter" | "hiring_manager" | "interviewer" | "observer"
  role      String
  addedById String?
  addedAt   DateTime @default(now())

  posting InternshipPosting @relation(fields: [postingId], references: [id], onDelete: Cascade)
  user    User              @relation("PostingTeamMembership", fields: [userId], references: [id], onDelete: Cascade)
  addedBy User?             @relation("PostingTeamAdder", fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([postingId, userId])
  @@index([userId])
  @@index([postingId, role])
}

/// Reusable email body per company. Pre-seeded on company creation
/// with a starter set (rejection-early, rejection-post-interview,
/// interview-invitation, offer-follow-up); editable from
/// /employer/templates.
///
/// Bodies support double-curly merge variables resolved at send
/// time: {{candidateFirstName}}, {{candidateLastName}}, {{postingTitle}},
/// {{companyName}}, {{interviewerName}}, {{interviewDateTime}},
/// {{senderFirstName}}, {{senderSignature}}.
model EmailTemplate {
  id             String   @id @default(cuid())
  companyId      String
  /// User-facing label ("Rejection — early stage").
  name           String
  /// Stage hint so the bulk-action picker can suggest the right
  /// template: "rejection" | "interview_invite" | "offer" |
  /// "follow_up" | "general"
  kind           String
  subject        String
  body           String
  /// Pre-seeded starter templates carry this flag so the UI can
  /// show a "Starter" chip; users can still edit or delete them.
  isStarter      Boolean  @default(false)
  /// Version label for the starter template this row was created
  /// from — used by the "See the latest starter version" diff so
  /// we never silently overwrite a company's edits.
  starterVersion Int?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("EmailTemplateAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId, kind])
}

/// A per-posting rubric — N criteria the team grades each
/// interviewee against. Owners / Managers define this; each
/// interviewer fills in one ScorecardSubmission per candidate.
model InterviewScorecard {
  id        String   @id @default(cuid())
  postingId String   @unique
  /// Criteria as JSON array:
  ///   [{ id: cuid, label: string, description?: string, scale: 4|5 }]
  criteria  Json
  /// Soft-locked once any submission exists — only Owners can edit.
  locked    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posting     InternshipPosting     @relation(fields: [postingId], references: [id], onDelete: Cascade)
  submissions ScorecardSubmission[]
}

/// One interviewer's filled-in scorecard for one candidate.
model ScorecardSubmission {
  id                  String    @id @default(cuid())
  scorecardId         String
  applicationStatusId String
  interviewerId       String
  /// { [criterionId]: { score: number, note?: string } }
  scores              Json
  /// "strong_yes" | "yes" | "no_decision" | "no" | "strong_no"
  recommendation      String?
  /// Free-text summary the interviewer writes after the meeting.
  summary             String?
  /// "draft" | "submitted". Drafts are visible only to the author;
  /// submitted scorecards are visible to the posting's hiring team.
  status              String    @default("draft")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  submittedAt         DateTime?

  scorecard         InterviewScorecard @relation(fields: [scorecardId], references: [id], onDelete: Cascade)
  applicationStatus ApplicationStatus  @relation("ApplicationStatusScorecards", fields: [applicationStatusId], references: [id], onDelete: Cascade)
  interviewer       User               @relation("ScorecardInterviewer", fields: [interviewerId], references: [id], onDelete: Cascade)

  @@unique([scorecardId, applicationStatusId, interviewerId])
  @@index([applicationStatusId, status])
}

/// Per-user fan-out from EmployerActivityLog events the user cares
/// about. One Notification row per (user × event). Drives both the
/// in-app inbox (sidebar bell) and the daily digest email.
///
/// Created by the `writeEmployerAction` helper after every activity
/// write: looks at the kind + the posting's PostingTeamMembers +
/// @mentions to decide which users get a row.
model Notification {
  id            String    @id @default(cuid())
  userId        String
  companyId     String
  /// FK back to the activity-log row that triggered this — so
  /// rendering can re-use the feed's per-kind copy templates.
  activityLogId String
  /// Why does this user care? Drives the inbox grouping + digest
  /// subject:
  ///   "mention"         — explicitly @-tagged
  ///   "hiring_team"     — they're on the posting's team
  ///   "owner_oversight" — Owner-only signal (member joined, bulk sent)
  ///   "self_action"     — receipt of an action they took
  reason        String
  readAt        DateTime?
  /// Set when the daily digest job has included this row, so we
  /// don't double-send.
  digestSentAt  DateTime?
  createdAt     DateTime  @default(now())

  user        User                @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  activityLog EmployerActivityLog @relation(fields: [activityLogId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([userId, digestSentAt])
}

/// Per-user notification preference per company. Lazy-created on
/// first read with sensible defaults: in-app on, email immediate
/// off (except @mentions which always notify), email digest on.
model NotificationPreference {
  id               String   @id @default(cuid())
  userId           String
  companyId        String
  inAppOn          Boolean  @default(true)
  emailImmediateOn Boolean  @default(false)
  emailDigestOn    Boolean  @default(true)
  /// "daily" | "weekly" | "off"
  digestCadence    String   @default("daily")
  /// Reasons the user has muted — applies to inbox + email both.
  /// "mention" entries are ignored (mentions always notify).
  mutedReasons     String[]

  user    User    @relation("NotificationPrefUser", fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

/// Lightweight presence heartbeat — written when a member loads an
/// applicant row, swept by a daily cron. No websockets; the UI polls
/// every 20s. Cheap enough at our scale.
model EmployerPresencePing {
  id                  String   @id @default(cuid())
  companyId           String
  userId              String
  applicationStatusId String
  expiresAt           DateTime
  createdAt           DateTime @default(now())

  user User @relation("EmployerPresenceUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, applicationStatusId])
  @@index([applicationStatusId, expiresAt])
  @@index([expiresAt])
}

/// Admin-editable list of options that drives the Course catalog
/// filter rail. Seeded from src/lib/courses/filters.ts on first /courses
/// hit (idempotent); admins can add / rename / hide afterwards.
model CourseFilterOption {
  id        String   @id @default(cuid())
  /// "topic" | "delivery" | "provider"
  type      String
  value     String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([type, value])
  @@index([type, sortOrder])
}

/// Internship / job-board posting. Admins create either by filling
/// fields manually or by pasting a job description and letting the
/// AI parser pre-fill the form.
model InternshipPosting {
  id              String    @id @default(cuid())
  /// True for postings created by the HR-side "Seed demo data"
  /// self-service tool on /employer/postings. Lets each employer
  /// stand up a sandbox of postings + applicants at varied pipeline
  /// stages to try things out, and clear them all at the click of
  /// a button. ApplicationStatus / Interview / Offer rows attached
  /// to a demo posting follow it down via ON DELETE CASCADE — we
  /// only need to filter / clear at the posting level.
  isDemoSeed      Boolean   @default(false)
  companyName     String
  website         String?
  title           String
  duration        String?
  hours           String?
  location        String?
  type            String?
  compensation    String?
  deadline        DateTime?
  keySkills       String[]
  positionDetails String
  /// "active" | "closed" | "expired" | "draft"
  ///   active   — live, accepting applications
  ///   closed   — manually closed by HR, no more applications
  ///   expired  — deadline passed or bulk-marked expired
  ///   draft    — being prepped, not visible on the public board
  status          String    @default("active") // active | closed | expired | draft
  /// Apply-direct contact. Email is the primary target; name + phone
  /// are optional. Trainees see these on the posting detail page so
  /// they can email a tailored pitch directly to the hiring contact.
  contactEmail    String?
  contactName     String?
  contactPhone    String?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  /// Employer-team-portal: company that owns this posting. Backfilled
  /// for every existing posting by the team-portal migration script
  /// (creator's User row → mirrored Company → companyId here).
  /// Nullable so the migration is reversible; once every posting has
  /// a companyId a later migration will tighten this to NOT NULL.
  companyId String?

  /// Denormalised last-touch attribution for the inline chip on the
  /// posting row ("last edit by Marcus · 2h ago"). Updated by the
  /// writeEmployerAction helper on every mutation.
  lastTouchedAt   DateTime?
  lastTouchedById String?

  // Phase 1–5 additions
  skills              PostingSkill[]
  applicationStatuses ApplicationStatus[]
  interviews          Interview[]
  saves               UserSavedPosting[]

  // Coaching back-relations — see PrepSession + StarStory models.
  prepSessions   PrepSession[]
  sourcedStories StarStory[]   @relation("StarStorySource")
  offers         Offer[]

  // Employer team portal back-relations.
  company       Company?              @relation(fields: [companyId], references: [id], onDelete: SetNull)
  lastTouchedBy User?                 @relation("PostingLastTouch", fields: [lastTouchedById], references: [id], onDelete: SetNull)
  teamMembers   PostingTeamMember[]
  scorecard     InterviewScorecard?
  activityLogs  EmployerActivityLog[] @relation("PostingActivity")

  // Reporting back-relations.
  hiringTargets   HiringTarget[]
  recruitingCosts RecruitingCost[]
  statusHistory   ApplicationStatusHistory[]

  @@index([status, createdAt])
  @@index([companyId, status, createdAt])
}

/// Trainee bookmarks. Lets a trainee mark postings they want to come
/// back to — deadline tracking, comparison, "apply later" reminder.
/// Surfaced at /profile/applications under the "Saved" tab and via
/// a heart icon on each posting card.
model UserSavedPosting {
  id        String   @id @default(cuid())
  userId    String
  postingId String
  createdAt DateTime @default(now())

  user    User              @relation("SavedPostingUser", fields: [userId], references: [id], onDelete: Cascade)
  posting InternshipPosting @relation(fields: [postingId], references: [id], onDelete: Cascade)

  @@unique([userId, postingId])
  @@index([userId, createdAt])
}

/// Individual answer set for an EventForm. `data` is keyed by field id.
model EventFormSubmission {
  id                    String    @id @default(cuid())
  formId                String
  form                  EventForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  data                  Json
  email                 String?
  userId                String?
  /// Optional FK to User — set null if the user is deleted; submissions
  /// outlive accounts so we keep the row but lose the link.
  user                  User?     @relation("FormSubmitter", fields: [userId], references: [id], onDelete: SetNull)
  /// Review state for talent-pool gating. Default "pending" so any
  /// new submission waits for admin review before becoming visible
  /// in the talent pool / searchable directory. Forms that don't
  /// gate on review (e.g. OBIO bootcamp registration) treat the
  /// field as informational only — UI only shows it when the form
  /// slug is talent-application.
  ///   pending     — fresh submission; not in talent pool yet
  ///   approved    — admin reviewed + admitted
  ///   approved_skip_review — admin "skip approval — add directly"
  ///                  fast-path; same talent-pool membership as
  ///                  "approved" but flagged for audit
  ///   rejected    — admin reviewed + declined
  reviewStatus          String    @default("pending")
  reviewedBy            String?
  reviewedAt            DateTime?
  /// Free-text reviewer note shown to the applicant when status
  /// changes (e.g. "Need supervisor letter" or rejection reason).
  reviewerNote          String?
  /// Eligibility check — a SECOND human-approval gate, distinct from
  /// reviewStatus. reviewStatus = "approved" means "this submission
  /// is admitted to the internal talent pool"; eligibilityApprovedAt
  /// being set means "a human has verified this person is eligible
  /// to be SHOWN TO EMPLOYERS." The employer-facing /talent-pool
  /// view filters on eligibilityApprovedAt != null; the admin view
  /// shows everyone and lets admins toggle the eligibility flag
  /// (single or batch). `eligibilityApprovedBy` stores the userId of
  /// the approving admin/instructor; UI joins on User to render
  /// "approved by Jane" — no FK on the column so admin deletion
  /// doesn't ripple. `eligibilityNote` is an optional free-text
  /// reason the approver can attach.
  eligibilityApprovedAt DateTime?
  eligibilityApprovedBy String?
  eligibilityNote       String?
  /// User-driven exit from the talent pool. Set when an approved
  /// applicant chooses to leave. Pairs with leftPoolReason +
  /// (optionally) a PoolExitFeedback row. A submission with
  /// leftPoolAt set is hidden from employer-facing talent-pool
  /// views even if reviewStatus is approved. Re-submission flips
  /// it back to null on save.
  leftPoolAt            DateTime?
  /// found_job | career_change | not_relevant | platform_quality |
  /// found_elsewhere | other
  leftPoolReason        String?
  createdAt             DateTime  @default(now())

  comments     ApplicationComment[]
  exitFeedback PoolExitFeedback?

  @@index([formId, createdAt])
  @@index([email])
  @@index([userId])
  /// Supports the talent-pool admin queue: "pending submissions
  /// for the talent-application form, oldest first."
  @@index([formId, reviewStatus, createdAt])
  /// Supports "active talent-pool members" — approved AND
  /// haven't left.
  @@index([formId, reviewStatus, leftPoolAt])
  /// Supports the employer-facing pool query — admin-approved
  /// AND eligibility-checked AND haven't left.
  @@index([formId, reviewStatus, eligibilityApprovedAt, leftPoolAt])
}

/// Admin- or employer-authored comment on a talent-application
/// submission. Commenting is gated behind the submission's
/// reviewStatus reaching "approved" (or "approved_skip_review") —
/// the intent is to keep employers from advancing a candidate
/// through review-side conversations before the eligibility check
/// passes.
model ApplicationComment {
  id           String   @id @default(cuid())
  submissionId String
  authorId     String
  /// admin | superadmin | employer | instructor — captured at write
  /// time so the comment renders with role context even if the
  /// author's role later changes. Trainees can't comment via this
  /// model (their input lives on the submission's own form data).
  authorRole   String
  body         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submission EventFormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  author     User                @relation("ApplicationCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  /// Supports "comments for this submission, oldest first" (thread).
  @@index([submissionId, createdAt])
  /// Supports "every comment by this employer" admin view.
  @@index([authorId, createdAt])
}

/// Exit survey response when a trainee leaves the talent pool.
/// One-to-one with EventFormSubmission so re-submitting after a
/// leave (i.e. coming back) doesn't accumulate stale exit rows —
/// re-entering the pool clears the old leftPoolAt and the old
/// PoolExitFeedback gets superseded on the next leave.
model PoolExitFeedback {
  id                 String   @id @default(cuid())
  submissionId       String   @unique
  userId             String
  /// Echoes EventFormSubmission.leftPoolReason for analytics
  /// convenience. The canonical value is on the submission.
  reason             String
  /// All scale ratings 1-10 (0 means "not answered" — UI treats
  /// "not answered" as nullable but we store as nullable Int for
  /// aggregations).
  helpfulness        Int?
  partnerQuality     Int?
  platformExperience Int?
  communicationFreq  Int?
  /// Net Promoter Score 0-10 (industry-standard scale).
  npsScore           Int?
  foundJob           Boolean  @default(false)
  /// Where they found the job, if applicable (free text).
  jobSource          String?
  /// Free-text fields — the qualitative half of the survey.
  whatWorkedWell     String?
  whatToImprove      String?
  additionalComments String?
  /// Whether the BHN team may follow up with this person for
  /// further insights. Off by default; respects post-departure
  /// preference.
  allowFollowUp      Boolean  @default(false)
  createdAt          DateTime @default(now())

  submission EventFormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  user       User                @relation("PoolExitFeedbackUser", fields: [userId], references: [id], onDelete: Cascade)

  /// Supports "all feedback ordered by recency" admin dashboard view.
  @@index([createdAt])
  /// Supports "feedback bucket by reason" stacked-bar / pie chart.
  @@index([reason, createdAt])
}

/// Open-ended feedback invitation — admin-issued or auto-issued
/// (e.g. when a user leaves the pool, we mint one of these so the
/// exit survey can be filled later if they skipped at the time).
/// Token is single-use; on submit it flips to consumed.
model FeedbackInvitation {
  id          String    @id @default(cuid())
  /// Single-use opaque token used in the public /feedback/[token]
  /// URL. 128-bit hex generated server-side; never reused.
  token       String    @unique
  /// User the invite was sent to. If null, this is a "general"
  /// invite that anyone with the link can submit against — used
  /// for the auto-leave path where we don't want to require login
  /// before they share a quick rating.
  userId      String?
  /// Who minted the invite. Null for system-issued (auto-on-leave).
  invitedById String?
  /// found_job | exit_survey | post_completion | nps_check | custom
  /// Drives which question set the form shows; we keep the set
  /// configurable in code rather than DB for now.
  kind        String    @default("exit_survey")
  /// Optional preface admin can add when issuing the invite.
  message     String?
  expiresAt   DateTime
  /// Set when the invitation has been used. Null while pending.
  consumedAt  DateTime?
  /// FK back to the resulting feedback row when consumed.
  feedbackId  String?
  createdAt   DateTime  @default(now())

  user      User? @relation("FeedbackInvitationUser", fields: [userId], references: [id], onDelete: SetNull)
  invitedBy User? @relation("FeedbackInvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  /// Supports "all pending invites I sent" admin filter.
  @@index([invitedById, createdAt])
  /// Supports "is this token still valid?" lookup on the public
  /// /feedback/[token] route.
  @@index([token, expiresAt])
}

model Course {
  id               String    @id @default(cuid())
  /// Short course code shown on the catalog card (e.g. "BIOP210",
  /// "ACRTM101"). Optional — courses without a code render without
  /// the eyebrow on the card.
  code             String?
  title            String
  description      String?
  /// Optional enrollment-deadline date — for cohort-based courses
  /// where the application window closes before the cohort begins.
  /// Used on the catalog card's "Enroll by:" line.
  enrollByDate     DateTime?
  /// Cohort start + end dates for In-Person / Hybrid / Blended
  /// courses. When both are set, the card shows "Duration: {start}
  /// – {end}". For On-Demand / Asynchronous courses these stay
  /// null and the card falls back to `duration` (minutes).
  cohortStartDate  DateTime?
  cohortEndDate    DateTime?
  thumbnail        String?
  /// Non-destructive colour / gradient overlay rendered on top of
  /// `thumbnail` in the catalog. Admins set it from
  /// /admin/course-thumbnails (batch) so a row of cards can share a
  /// visual treatment without re-running SDXL. Shape:
  ///   { mode: "solid"|"gradient", color1, color2?, angle, opacity, blendMode? }
  /// See src/lib/courses/thumbnail-overlay.ts.
  thumbnailOverlay Json?
  category         String?
  tags             String?
  status           String    @default("draft")
  courseType       String    @default("scorm")
  passingScore     Float     @default(80)
  maxAttempts      Int       @default(0)
  duration         Int?
  creditCost       Float     @default(0)
  // Catalog filter facets — see src/lib/courses/filters.ts for the
  // canonical option lists. Free-text so admins can extend later.
  topic            String? // e.g. "Regulatory Affairs"
  delivery         String? // "Asynchronous" | "Online" | "In-Person" | "Blended"
  provider         String? // e.g. "CASTL", "BioTalent Canada"
  isSpecial        Boolean   @default(false) // Special Programs / Workshops flag
  /// When true, enrollment creates an Enrollment row with
  /// status="pending" instead of "active". Admins approve / reject
  /// from /admin/enrollments. Defaults to false so existing courses
  /// stay self-serve.
  requiresApproval Boolean   @default(false)
  /// Admin-controlled catalog display order. Lower numbers render
  /// first; ties fall back to createdAt desc (the previous default).
  /// Admins can drag-reorder tiles on /courses to set this.
  displayOrder     Int       @default(0)
  instructorId     String?
  instructor       User?     @relation("Instructor", fields: [instructorId], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // AI-generated summary of the course (visible to learners; refreshable by staff).
  aiSummary  String?
  embeddedAt DateTime?
  /// 384-d BGE-small embedding; managed via raw SQL (pgvector).
  embedding  Unsupported("vector(384)")?

  scormPackage ScormPackage?
  modules      Module[]
  enrollments  Enrollment[]
  assessments  Assessment[]
  certificates Certificate[]
  groupCourses GroupCourse[]
  pathways     PathwayCourse[]
  skills       CourseSkill[]
  favorites    CourseFavorite[]
}

/// User → Course favorite join. Trainees tap the heart icon on a
/// catalog card to bookmark a course for later; the same heart
/// flips back to remove the favorite. A future surface (a
/// "Favorites" filter on /courses or a dedicated /my-favorites
/// page) reads from this table.
model CourseFavorite {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model ScormPackage {
  id           String         @id @default(cuid())
  courseId     String         @unique
  course       Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  version      String
  entryPoint   String
  manifestData String
  uploadPath   String
  uploadedAt   DateTime       @default(now())
  sessions     ScormSession[]
}

model ScormSession {
  id            String    @id @default(cuid())
  userId        String
  packageId     String
  attemptNumber Int       @default(1)
  status        String    @default("not attempted")
  score         Float?
  scoreMin      Float?
  scoreMax      Float?
  timeSpent     String?
  location      String?
  suspendData   String?
  interactions  String?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  package ScormPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  /// This table is on the critical path of every trainee page view, and until
  /// Jul 2026 it carried no index but its primary key — so each of the queries
  /// below sequential-scanned every row of every user. (`take: 3` gave no
  /// protection: without an index Postgres must scan and sort the whole table
  /// before discarding down to 3.) Postgres does not auto-index FK columns.
  ///   [userId, updatedAt]                 → dashboard "continue learning"
  ///                                         (where userId, order updatedAt desc, take 3)
  ///   [userId, packageId, attemptNumber]  → SCORM player + /api/scorm/session
  ///                                         (where userId+packageId, order attemptNumber desc)
  ///                                         and gradebook (where userId,
  ///                                         order packageId asc, attemptNumber asc)
  @@index([userId, updatedAt])
  @@index([userId, packageId, attemptNumber])
}

model Module {
  id          String                      @id @default(cuid())
  courseId    String
  title       String
  description String?
  order       Int
  type        String                      @default("content")
  content     String?
  videoUrl    String?
  fileUrl     String?
  duration    Int?
  isRequired  Boolean                     @default(true)
  /// 384-d BGE-small embedding; managed via raw SQL (pgvector).
  embedding   Unsupported("vector(384)")?
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt

  course      Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress    ModuleProgress[]
  checkpoints ModuleCheckpoint[]
}

model ModuleProgress {
  id          String    @id @default(cuid())
  userId      String
  moduleId    String
  status      String    @default("not_started")
  score       Float?
  timeSpent   Int?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  status      String    @default("active")
  score       Float?
  progress    Float     @default(0)
  attempts    Int       @default(0)
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?
  dueDate     DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Assessment {
  id           String   @id @default(cuid())
  courseId     String
  title        String
  description  String?
  timeLimit    Int?
  passingScore Float    @default(80)
  maxAttempts  Int      @default(0)
  shuffleQ     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  course    Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  AssessmentAttempt[]
}

model Question {
  id            String             @id @default(cuid())
  assessmentId  String
  text          String
  type          String
  options       String?
  correctAnswer String?
  points        Float              @default(1)
  order         Int
  explanation   String?
  /// Free-text topic label for the mastery heatmap. Author-supplied
  /// — no separate KC ontology yet. Items without a topic fall under
  /// the assessment title in the heatmap aggregation.
  topic         String?
  assessment    Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  bookmarks     ReviewBookmark[]
  checkpoints   ModuleCheckpoint[]
}

/// Trainee-bookmarked questions. Light spaced-repetition: nextReviewAt
/// driven by an expanding-interval ladder (1 → 3 → 7 → 14 → 30 days)
/// gated by self-graded binary quality ("got it" / "still tricky").
/// Auto-generation is deferred — only questions the trainee
/// deliberately bookmarks are scheduled.
model ReviewBookmark {
  id             String    @id @default(cuid())
  userId         String
  questionId     String
  intervalDays   Int       @default(1)
  nextReviewAt   DateTime
  lastReviewedAt DateTime?
  /// 0 = "still tricky" (resets ladder), 1 = "got it" (advances).
  lastQuality    Int?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  question       Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, nextReviewAt])
}

/// Author-placed checkpoint inside a video module. Pauses playback at
/// `timestampSeconds` and (optionally) presents a comprehension
/// question. When `questionId` is null the player just shows a
/// "checkpoint" pause card with a Continue button.
model ModuleCheckpoint {
  id               String    @id @default(cuid())
  moduleId         String
  timestampSeconds Float
  questionId       String?
  orderIndex       Int       @default(0)
  createdAt        DateTime  @default(now())
  module           Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  question         Question? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@index([moduleId, orderIndex])
}

model AssessmentAttempt {
  id           String     @id @default(cuid())
  assessmentId String
  userId       String
  score        Float?
  maxScore     Float?
  passed       Boolean?
  answers      String
  timeSpent    Int?
  startedAt    DateTime   @default(now())
  submittedAt  DateTime?
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model XapiStatement {
  id          String   @id @default(cuid())
  statementId String   @unique
  userId      String
  verb        String
  object      String
  result      String?
  context     String?
  timestamp   DateTime @default(now())
  stored      DateTime @default(now())
  authority   String?
  version     String   @default("1.0.3")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LtiConfig {
  id            String   @id @default(cuid())
  name          String
  issuer        String
  clientId      String
  authEndpoint  String
  tokenEndpoint String
  jwksEndpoint  String
  deploymentId  String
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model Certificate {
  id         String    @id @default(cuid())
  userId     String
  courseId   String?
  pathwayId  String?
  kind       String    @default("course") // course | pathway
  issueDate  DateTime  @default(now())
  expiryDate DateTime?
  metadata   String?
  pdfUrl     String?
  revokedAt  DateTime?
  revokedBy  String?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course?   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  pathway    Pathway?  @relation(fields: [pathwayId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@unique([userId, pathwayId])
}

/// ── Certification framework ─────────────────────────────────────────────
/// A named, multi-level professional certification (e.g. "Biomanufacturing
/// Professional Certification") composed of three ordered tiers —
/// Foundation → Practitioner → Advanced. Each tier bundles courses, has its
/// own passing rigor, and issues a leveled credential; advancing to a tier
/// requires holding the previous tier's credential. Designed from scratch to
/// give the platform a genuine Foundation/Practitioner/Advanced structure
/// (see src/lib/certifications/*).
model CertificationProgram {
  id          String                    @id @default(cuid())
  slug        String                    @unique
  title       String
  summary     String?
  /// Discipline / domain shown as an eyebrow, e.g. "Biomanufacturing".
  discipline  String?
  /// Trainee sub-types this track is designed for (only trainees train):
  /// masters | phd | postdoc | research_associate | lab_technician.
  /// Empty = open to all trainees. See src/lib/certifications/personas.ts.
  audience    String[]                  @default([])
  status      String                    @default("draft") // draft | published
  createdById String?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  levels      CertificationLevel[]
  credentials CertificationCredential[]
}

/// One tier within a CertificationProgram. `tier` is the named level
/// (foundation | practitioner | advanced); `order` (1/2/3) drives the
/// prerequisite chain. `courseIds` are the courses a learner must complete
/// (all of them) to earn the tier; `passingScore` escalates per tier.
model CertificationLevel {
  id           String                    @id @default(cuid())
  programId    String
  tier         String // foundation | practitioner | advanced
  order        Int // 1 | 2 | 3
  title        String
  summary      String?
  passingScore Float                     @default(80)
  courseIds    String[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  program      CertificationProgram      @relation(fields: [programId], references: [id], onDelete: Cascade)
  credentials  CertificationCredential[]

  @@unique([programId, tier])
  @@index([programId])
}

/// A leveled credential a learner has EARNED for one tier. Issuance is
/// automatic (see lib/certifications/progress.ts) once every course in the
/// tier is completed and the previous tier is already held.
model CertificationCredential {
  id               String               @id @default(cuid())
  userId           String
  programId        String
  levelId          String
  credentialNumber String               @unique
  earnedAt         DateTime             @default(now())
  revokedAt        DateTime?
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  program          CertificationProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  level            CertificationLevel   @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([userId, levelId])
  @@index([userId])
  @@index([programId])
}

model Pathway {
  id               String                      @id @default(cuid())
  title            String
  description      String?
  thumbnail        String?
  /// Non-destructive colour / gradient overlay rendered on top of
  /// `thumbnail` wherever the pathway is shown. Same shape as
  /// Course.thumbnailOverlay — see src/lib/courses/thumbnail-overlay.ts.
  /// Set from /admin/cover-art alongside course overlays.
  thumbnailOverlay Json?
  category         String?
  status           String                      @default("draft") // draft | published
  creditCost       Float                       @default(0)
  createdById      String?
  embeddedAt       DateTime?
  /// 384-d BGE-small embedding; managed via raw SQL (pgvector).
  embedding        Unsupported("vector(384)")?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  /// Pathway-level fallback enrollment fields. Used when no
  /// PathwayCohort rows exist (legacy / single-cohort pathways).
  /// When cohorts exist these are ignored and the per-cohort
  /// capacity / window / waitlist values drive the experience.
  enrollmentStatus   String    @default("open") // open | closed | full
  enrollmentOpensAt  DateTime?
  enrollmentClosesAt DateTime?
  capacity           Int?
  allowWaitlist      Boolean   @default(true)

  courses       PathwayCourse[]
  cohorts       PathwayCohort[]
  enrollments   PathwayEnrollment[]
  certificates  Certificate[]
  showcaseLinks ShowcasePathway[]
}

/// One cohort within a Pathway — e.g. "Spring 2026 — OBIO Bootcamp"
/// for the Entrepreneurship Pathway. Each cohort has its own
/// capacity, registration window, and waitlist policy.
///
/// When a Pathway has 0 cohorts → behaves as before (pathway-level
/// fields drive enrollment). When ≥ 1 cohort exists → applicants
/// pick a cohort at enrollment time, capacity / status are
/// computed per cohort, and PathwayEnrollment.cohortId is set on
/// every new enrollment row.
model PathwayCohort {
  id                 String    @id @default(cuid())
  pathwayId          String
  /// URL-safe slug, unique within the pathway (eg. "spring-2026").
  slug               String
  /// Human-readable label shown in the picker. "Spring 2026 cohort"
  name               String
  /// Optional rich-text description shown alongside the cohort
  /// — e.g. "Hybrid format, weekly Wednesdays, in-person retreat
  /// in March". Markdown.
  description        String?
  /// Program dates. End is optional for open-ended self-paced cohorts.
  startDate          DateTime
  endDate            DateTime?
  /// Hard capacity for confirmed seats. Beyond this, applicants
  /// either join the waitlist (if allowWaitlist) or see "full".
  capacity           Int
  /// Whether confirmed-full means waitlist or hard-stop.
  allowWaitlist      Boolean   @default(true)
  /// Optional waitlist cap. Null = unlimited waitlist.
  waitlistCapacity   Int?
  /// Optional registration window. Null on either side = no bound.
  enrollmentOpensAt  DateTime?
  enrollmentClosesAt DateTime?
  /// Operator-driven state. Computed UI state (open / full /
  /// waitlisted / closed) combines this with capacity + window.
  ///   draft     — admin still working on it; hidden from public.
  ///   open      — public; standard rules apply.
  ///   closed    — admin manually closed early.
  ///   archived  — past cohort; visible read-only on detail page.
  status             String    @default("draft") // draft | open | closed | archived
  /// Sort order when listing cohorts; earliest startDate is usually
  /// fine but admins can pin a particular cohort to top via this.
  displayOrder       Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  pathway        Pathway             @relation(fields: [pathwayId], references: [id], onDelete: Cascade)
  enrollments    PathwayEnrollment[]
  showcaseGroups ShowcaseGroup[]

  @@unique([pathwayId, slug])
  /// Supports "list cohorts for this pathway in display order".
  @@index([pathwayId, displayOrder])
}

model PathwayCourse {
  id        String  @id @default(cuid())
  pathwayId String
  courseId  String
  order     Int     @default(0)
  required  Boolean @default(true)
  pathway   Pathway @relation(fields: [pathwayId], references: [id], onDelete: Cascade)
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([pathwayId, courseId])
}

model PathwayEnrollment {
  id                     String         @id @default(cuid())
  userId                 String
  pathwayId              String
  /// Set when the pathway has cohorts. Null on legacy pre-cohort
  /// enrollments and on enrollments to single-cohort pathways
  /// (which keep using pathway-level fields). The (userId,
  /// pathwayId) uniqueness still applies even with cohorts —
  /// one user, one enrollment per pathway, regardless of cohort.
  cohortId               String?
  // pending | approved | rejected | waitlisted | withdrawn | completed
  status                 String         @default("pending")
  /// 1-indexed waitlist position when status="waitlisted". Null
  /// otherwise. Densely renumbered when an earlier waitlister
  /// cancels.
  waitlistPosition       Int?
  requestReason          String?
  reviewerId             String?
  reviewerNote           String?
  reviewedAt             DateTime?
  enrolledAt             DateTime       @default(now()) // request created
  approvedAt             DateTime?
  completedAt            DateTime?
  /// Attendance (enrollment-level). Admins mark who attended from
  /// /admin/pathway-enrollments; the graduate showcase can gate on
  /// `attended` so only those who showed up get to submit.
  attended               Boolean        @default(false)
  sessionsAttended       Int            @default(0)
  attendanceNote         String?
  attendanceRecordedAt   DateTime?
  attendanceRecordedById String?
  pathway                Pathway        @relation(fields: [pathwayId], references: [id], onDelete: Cascade)
  cohort                 PathwayCohort? @relation(fields: [cohortId], references: [id], onDelete: SetNull)

  @@unique([userId, pathwayId])
  @@index([pathwayId, status, enrolledAt])
  /// Supports per-cohort capacity + waitlist queries.
  @@index([cohortId, status, waitlistPosition])
  /// Supports the cohort attendance roster + showcase eligibility check.
  @@index([cohortId, attended])
}

/// Application from a trainee for additional starter credits beyond the
/// 200 granted at registration. Reviewed manually by admin staff.
model CreditApplication {
  id              String    @id @default(cuid())
  userId          String
  status          String    @default("pending") // pending | approved | rejected
  requestedAmount Float     @default(4800)
  approvedAmount  Float?
  fullName        String
  organization    String?
  title           String?
  country         String?
  phone           String?
  useCase         String // why they need the credits
  documents       Json // array of { key, name, size, contentType }
  reviewerId      String?
  reviewerNote    String?
  reviewedAt      DateTime?
  submittedAt     DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user     User  @relation("Applicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, submittedAt])
  @@index([userId, submittedAt])
}

model CreditTransaction {
  id            String    @id @default(cuid())
  userId        String
  amount        Float
  type          String // credit | debit
  reason        String // enrollment | refund | admin_grant | initial | expiry
  courseId      String?
  balanceAfter  Float
  createdAt     DateTime  @default(now())
  /// Expiry timestamp for credit grants (rows where type="credit").
  /// Per the BioHubNet ENGAGE policy, awarded credits expire 365 days
  /// from the grant date. Null on debit rows and on legacy pre-policy
  /// grants. The daily credit-expiry sweep deducts expired balances
  /// from User.credits and writes a matching "expiry" debit row for
  /// audit traceability.
  expiresAt     DateTime?
  /// Set by the sweep when this grant's remaining balance was
  /// expired. Null for live grants. Prevents the sweep from
  /// double-expiring the same row.
  expiredAt     DateTime?
  /// How much of the original `amount` has been expired so far.
  /// Tracks the running deduction so partial debits between grant
  /// and expiry are accounted for. 0 for live grants.
  expiredAmount Float     @default(0)
  /// Notification milestones already sent for this grant. Lets the
  /// daily sweep send 90-/30-/7-day-before-expiry warnings without
  /// re-spamming. Null per field = not yet sent.
  notified90At  DateTime?
  notified30At  DateTime?
  notified7At   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Supports the daily sweep: "find grants past expiresAt that haven't
  /// been expired yet" and "find grants approaching expiry needing
  /// notification."
  @@index([userId, type, expiresAt])
  @@index([expiresAt, expiredAt])
}

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members GroupMembership[]
  courses GroupCourse[]
}

model GroupMembership {
  id      String   @id @default(cuid())
  groupId String
  userId  String
  addedAt DateTime @default(now())
  group   Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model GroupCourse {
  id       String   @id @default(cuid())
  groupId  String
  courseId String
  addedAt  DateTime @default(now())
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([groupId, courseId])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  courseId  String?
  authorId  String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String // user.create | user.deactivate | course.publish | enrollment.create | credit.grant …
  targetType String? // user | course | enrollment | certificate
  targetId   String?
  detail     String? // JSON
  ip         String?
  createdAt  DateTime @default(now())
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
}

/// 21 CFR Part 11 §11.50 + §11.70 — electronic signatures captured
/// when a learner completes a regulated training event. Bound to
/// the underlying record via subjectType + subjectId (kept as
/// strings rather than FKs so a deleted course doesn't cascade away
/// the signature record — the value of an e-sig is its persistence).
model ElectronicSignature {
  id          String   @id @default(cuid())
  signerId    String
  action      String // e.g. "training.complete"
  subjectType String // "AssessmentAttempt" | "ModuleProgress" | "Course"
  subjectId   String
  meaning     String
  performedAt DateTime @default(now())
  /// "password" when re-auth was required at signing; "session"
  /// when the signature relied on the existing authenticated session
  /// (still bound by the audit trail, just less defensible at
  /// audit). Production GMP deployments should require "password".
  method      String   @default("session")
  ipAddress   String?
  userAgent   String?
  signer      User     @relation(fields: [signerId], references: [id], onDelete: Restrict)

  @@index([signerId, performedAt])
  @@index([subjectType, subjectId])
}

/// Audit + cost log for every AI call (chat, embed, summarize, search,
/// tutor). Powers the AI section of the analytics dashboard.
model AIInteraction {
  id               String    @id @default(cuid())
  userId           String?
  kind             String // chat | embed | summarize | search | tutor | classify  (also the feature label)
  provider         String // cloudflare | gemini
  model            String
  promptTokens     Int?
  completionTokens Int?
  /// Computed from tokens × per-model pricing (src/lib/ai/pricing.ts). Null when unknown.
  costUsd          Float?
  /// Version of the prompt template used (src/lib/ai/prompts.ts) — pins what ran.
  promptVersion    String?
  /// Did the structured output pass its schema check? Null = not a validated call.
  validationPassed Boolean?
  /// Human-in-the-loop: thumbs from the end user. +1 up, -1 down, null unrated.
  /// Powers the answer-acceptance rate on /admin/ai-metrics.
  userRating       Int?
  /// Model/heuristic confidence 0..1 for answer-type calls; below threshold the
  /// answer is flagged for human review.
  confidence       Float?
  /// Flagged for human review (thumbs-down or low confidence).
  flaggedForReview Boolean   @default(false)
  /// open | resolved | escalated (null = not in the review queue).
  reviewStatus     String?
  reviewNote       String?
  reviewedById     String?
  reviewedAt       DateTime?
  /// The user-facing answer text, kept only for flagged calls so a reviewer has
  /// context in the queue. Null for normal calls (we don't store every answer).
  answerExcerpt    String?
  /// When the triage agent processed this flagged answer (idempotency marker —
  /// the agent skips rows already stamped).
  agentTriagedAt   DateTime?
  latencyMs        Int?
  success          Boolean   @default(true)
  errorMessage     String?
  createdAt        DateTime  @default(now())

  @@index([createdAt])
  @@index([kind, createdAt])
  @@index([flaggedForReview, reviewStatus])
}

/// One run of the offline eval harness (evals/run.ts). Stores the commit it ran
/// against and the aggregate scores so quality can be tracked over time and the
/// CI gate can compare against a stored baseline.
model EvalRun {
  id        String   @id @default(cuid())
  commitSha String?
  /// "ci" | "local" | "manual"
  trigger   String   @default("local")
  /// Aggregate scores keyed by metric (correctness, groundedness, recallAt3…).
  scores    Json
  passed    Boolean  @default(true)
  summary   String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// One run of the autonomous triage agent (src/lib/inngest/triageAgent.ts).
/// Powers the agent dashboard + the before/after throughput metric.
model AgentRun {
  id             String    @id @default(cuid())
  agent          String    @default("triage")
  /// schedule | manual
  trigger        String    @default("schedule")
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  itemsProcessed Int       @default(0)
  itemsProposed  Int       @default(0)
  durationMs     Int?
  ok             Boolean   @default(true)
  summary        String    @default("")

  @@index([startedAt])
}

/// Persistent cache of m2m100 (and any future translation model)
/// outputs. Keyed by a sha256 of `model:sourceLang:targetLang:sourceText`
/// so the same string is only translated once across the whole platform.
/// The model field is part of the hash, so swapping engines invalidates.
model Translation {
  id             String   @id @default(cuid())
  hash           String   @unique
  sourceLang     String
  targetLang     String
  sourceText     String
  translatedText String
  model          String // e.g. "m2m100-1.2b"
  createdAt      DateTime @default(now())

  @@index([targetLang])
}

/// GDPR / CCPA data-subject request log. Used to record exports and
/// deletion requests with timestamps so we can prove compliance later.
model DataSubjectRequest {
  id          String    @id @default(cuid())
  userId      String
  kind        String // export | delete | rectify
  status      String    @default("completed") // completed | pending | rejected
  detail      String? // free text — what was requested or done
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
}

model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

/// Free-text site copy editable from /admin/copy.
/// Stable code-side defaults live in src/lib/copy-registry.ts;
/// a row here is an override. Missing row = use the code default.
model EditableCopy {
  key         String   @id
  value       String
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@index([updatedAt(sort: Desc)])
}

/// Two-person learning buddy relationship. Either side can end it at any
/// time. Pairs are unique per (initiator, partner); a 'reverse' invite
/// from the partner reuses the same row by flipping who initiated.
model BuddyPair {
  id          String    @id @default(cuid())
  initiatorId String
  partnerId   String
  status      String    @default("invited") // invited | active | declined | ended
  focusType   String? // course | pathway | open
  focusId     String?
  goalNote    String?
  invitedAt   DateTime  @default(now())
  acceptedAt  DateTime?
  endedAt     DateTime?
  endedById   String?

  initiator User           @relation("InitiatorBuddies", fields: [initiatorId], references: [id], onDelete: Cascade)
  partner   User           @relation("PartnerBuddies", fields: [partnerId], references: [id], onDelete: Cascade)
  messages  BuddyMessage[]

  @@unique([initiatorId, partnerId])
  @@index([partnerId, status])
  @@index([initiatorId, status])
}

/// Async messages between buddies — tied to a pair. Optionally anchored
/// to a course/module/pathway via refType+refId for deep-link context.
model BuddyMessage {
  id        String    @id @default(cuid())
  pairId    String
  senderId  String
  body      String
  refType   String? // course | pathway | module
  refId     String?
  createdAt DateTime  @default(now())
  readAt    DateTime?

  pair   BuddyPair @relation(fields: [pairId], references: [id], onDelete: Cascade)
  sender User      @relation("BuddyMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([pairId, createdAt])
}

/// User-initiated request to change their own role. Admins review and
/// approve or reject; on approval, the user's role is updated.
model RoleChangeRequest {
  id           String    @id @default(cuid())
  userId       String
  fromRole     String
  toRole       String
  reason       String?
  status       String    @default("pending") // pending | approved | rejected
  reviewerId   String?
  reviewerNote String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user     User  @relation("RoleRequester", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("RoleReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

/// User activity events. Lightweight, append-only audit of behavior used
/// to power the analytics dashboard and UX research. Distinct from AuditLog
/// (which records sensitive admin actions) and XapiStatement (which records
/// formal SCORM/xAPI learning statements).
model Event {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String?
  name      String // page_view | course_view | enroll | scorm_start | scorm_complete | theme_change | login | register | search | feature_use
  path      String?
  referrer  String?
  props     Json?
  role      String? // snapshot of role at event time
  device    String? // desktop | mobile | tablet
  country   String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([name, createdAt])
  @@index([userId, createdAt])
}

/// Loyalty / engagement reward — once a trainee has SPENT (debited) a
/// cumulative amount of credits on training, a tier unlocks and a
/// MerchReward row is created. The trainee then submits shipping
/// details (CLAIMED) and an admin marks it shipped.
///
/// We use lifetime spent rather than current balance so receiving more
/// credits later doesn't double-count, and so the threshold reads as
/// "you've engaged with this much training" rather than "you have a
/// pile of unspent credits". Tier registry lives in
/// src/lib/rewards/merch.ts (single source of truth for thresholds +
/// bundle contents). The (userId, tier) unique constraint is the
/// natural one-time-per-user lock.
model MerchReward {
  id     String @id @default(cuid())
  userId String

  /// 1 = Apprentice (2500 credits spent), 2 = Champion (5000).
  tier       Int
  /// Snapshot of the threshold at unlock time so historical records
  /// stay accurate even if we later rebalance the tier table.
  threshold  Int
  unlockedAt DateTime @default(now())

  /// Lifecycle:
  ///   UNCLAIMED → trainee hasn't filled out shipping/pickup yet
  ///   CLAIMED   → details captured; in admin fulfillment queue
  ///   SHIPPED   → for SHIP_REQUEST: package out + tracking attached;
  ///               for PICKUP: bundle ready at the BHN office
  ///   DELIVERED → terminal happy state (delivered or picked up)
  ///   CANCELLED → admin cancelled (returned, ineligible, etc.)
  status String @default("UNCLAIMED")

  /// How the trainee gets the bundle:
  ///   PICKUP        — collect in person at the BHN office at Leslie
  ///                   Dan Faculty of Pharmacy, University of Toronto.
  ///                   Default and the cheap path.
  ///   SHIP_REQUEST  — trainee is far from Toronto and asked us to
  ///                   mail it. Admin reviews case-by-case before
  ///                   committing postage; they can convert to PICKUP
  ///                   or CANCELLED if it doesn't fly.
  fulfillmentMethod String @default("PICKUP")

  // Shipping snapshot — frozen at claim time so later edits to the
  // user's profile don't quietly redirect already-queued packages.
  claimedAt     DateTime?
  recipientName String?
  addressLine1  String?
  addressLine2  String?
  city          String?
  region        String?
  postalCode    String?
  country       String?
  phone         String?
  /// T-shirt / hoodie size — both bundles include apparel. Free text
  /// so we can accept "M (Tall)" / "XS women's" without an enum bog.
  shirtSize     String?
  /// Anything else the trainee wants the fulfilment team to know
  /// (allergies for sticker adhesive, gate code, holiday hold, etc.).
  notes         String?

  // Fulfilment metadata.
  shippedAt       DateTime?
  carrier         String?
  trackingNumber  String?
  trackingUrl     String?
  fulfilledById   String?
  cancelledReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  fulfilledBy User? @relation("MerchFulfiller", fields: [fulfilledById], references: [id], onDelete: SetNull)

  /// One reward per tier per user. Trying to insert a duplicate is the
  /// natural idempotency check for the auto-unlock helper.
  @@unique([userId, tier])
  @@index([status, unlockedAt])
}

/// Public release / what's-new feed. Each entry's audience is controlled
/// by the visibleTo array — roles in this list will see the entry on the
/// /changelog page (trainees see it as "What's new", staff as "Change log").
model ChangeLog {
  id          String   @id @default(cuid())
  title       String
  body        String
  kind        String   @default("feature") // feature | fix | improvement | note
  version     String?
  /// Build commit SHA the entry first shipped on. Populated from
  /// NEXT_PUBLIC_COMMIT_SHA at create time. Surfaced only to
  /// admin / superadmin on the changelog page.
  buildSha    String?
  visibleTo   String[] @default(["trainee", "evaluating", "instructor", "admin", "superadmin"])
  publishedAt DateTime @default(now())
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Per-item state for the Launch Readiness dashboard. The canonical
/// list of items lives in src/lib/launch/checklist.ts (so the schema
/// is stable and admins can't break the structure); only mutable
/// state lives here — manual override status, owner, target date,
/// notes. Auto-items don't need a row unless an admin explicitly
/// overrode the auto-detected status.
model LaunchChecklistState {
  id             String    @id @default(cuid())
  /// Stable key from the canonical checklist (e.g. "infra.smtp",
  /// "content.real-courses"). One row per key.
  itemKey        String    @unique
  /// Admin override of the system-detected status. Wins over auto
  /// probes when set. Values: "not_started" | "in_progress" |
  /// "done" | "blocked" | "not_applicable".
  manualStatus   String?
  /// Free text — what's blocking, link to ticket, who's working on it.
  notes          String?
  /// Person responsible. Null = unassigned.
  ownerId        String?
  /// When this item is expected to land. Drives the timeline view.
  targetDate     DateTime?
  /// True when this needs an executive decision (surfaces in the
  /// "Decisions for the boss" panel on the page).
  decisionNeeded Boolean   @default(false)
  /// Last admin who touched the row — populates the audit footer.
  updatedById    String?
  updatedAt      DateTime  @updatedAt
  createdAt      DateTime  @default(now())

  owner     User? @relation("ChecklistOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  updatedBy User? @relation("ChecklistUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
}

// ════════════════════════════════════════════════════════════════
// Events module — single-tenant
//
// Powers the BioHubNet Annual Symposium & Training Week (and future
// editions). Replaces external WordPress + Luma tooling. No tenantId
// fields by design — the platform is single-tenant.
//
// Conventions
//   • State machines stored as commented String fields (matches the
//     rest of the schema — no Prisma enums anywhere in the codebase)
//   • Cascade delete down the Event → Workshop → Booking chain
//   • Restrict on User FKs for Registration + WorkshopBooking
//     (audit-bearing records — matches the ElectronicSignature pattern)
//   • Each Workshop row is one bookable slot. A workshop that runs
//     morning + afternoon is two rows, not one row with two children.
// ════════════════════════════════════════════════════════════════

/// The Training Week umbrella. One BhnEvent spans multiple days and
/// holds workshops (bookable training-week slots), symposium-day
/// agenda sessions, speakers, sponsors, and registrations.
///
/// Named `BhnEvent` rather than `Event` because `Event` is taken by
/// the analytics-telemetry model elsewhere in this schema. In code
/// the relation field is still `event` for readability; only the
/// type name carries the `Bhn` prefix.
model BhnEvent {
  id                   String    @id @default(cuid())
  /// URL-safe identifier, e.g. "2025-annual-symposium".
  slug                 String    @unique
  title                String
  /// Short marketing line shown on the landing-page hero.
  tagline              String?
  /// Long description (markdown).
  description          String?
  startDate            DateTime
  endDate              DateTime
  timezone             String    @default("America/Toronto")
  mainVenueName        String?
  mainVenueAddress     String?
  mainVenueMapUrl      String?
  coverImageUrl        String?
  /// Per-event branding overrides (palette, logo, hero image). Null
  /// = use the platform default theme.
  brandingJson         Json?
  /// "draft" → not visible publicly. "published" → public landing
  /// + registration. "archived" → past event, read-only.
  status               String    @default("draft") // draft | published | archived
  /// Optional registration window. Null = open whenever
  /// status="published".
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  /// Hotel block / accommodation guidance for attendees. Markdown.
  accommodationInfo    String?
  /// When true, new symposium-day Registration rows start in
  /// `pending` status and admins must approve them from
  /// /admin/events/[slug]/registrations before the spot is held.
  /// Mirrors Workshop.requiresApproval but at the event level. Set to
  /// false to allow auto-confirm (e.g. paid-event flows where Stripe
  /// settlement is the only gate).
  requiresApproval     Boolean   @default(true)
  /// Symposium-day capacity. NULL = uncapped (default — symposium
  /// scale). When set, the registration API counts active rows
  /// (pending + confirmed); a new registration that would push past
  /// the cap either lands on the waitlist (waitlistEnabled=true) or
  /// is rejected with "event full" (waitlistEnabled=false).
  /// Workshops have their own per-slot caps; this is the event-
  /// level gate.
  maxAttendees         Int?
  /// Default true. When the event is at capacity and a new
  /// registration comes in, true → set registrationStatus="waitlist"
  /// + waitlistPosition; false → reject with 403 "event full".
  waitlistEnabled      Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  workshops         Workshop[]
  symposiumSessions SymposiumSession[]
  speakers          Speaker[]
  sponsors          Sponsor[]
  registrations     Registration[]
  reminders         EventReminder[]
  hosts             EventHost[]
  customQuestions   CustomRegQuestion[]
  broadcasts        EventBroadcast[]
  ticketTypes       TicketType[]

  /// Supports admin filtering by status (draft / published / archived).
  @@index([status])
}

/// Tracks the timed email reminders the cron has dispatched for a
/// given event. The cron iterates upcoming published events, computes
/// the three reminder windows relative to startDate, and looks for a
/// missing EventReminder row per (event, kind). When found missing
/// AND the window has just passed, it sends the appropriate template
/// to every active registrant and inserts the row to mark sent.
///
/// "kind" values:
///   • "one_week"  — fires ~7 days before startDate
///   • "one_day"   — fires ~24 hours before startDate
///   • "one_hour"  — fires ~1 hour before startDate
///
/// The @@unique([eventId, kind]) constraint guarantees we never
/// double-send for the same window. sentCount is informational —
/// captures how many recipients we tried (for ops + audit).
model EventReminder {
  id          String    @id @default(cuid())
  eventId     String
  kind        String // one_week | one_day | one_hour
  scheduledAt DateTime
  sentAt      DateTime?
  sentCount   Int       @default(0)
  createdAt   DateTime  @default(now())

  event BhnEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, kind])
  @@index([scheduledAt, sentAt])
}

/// A platform user attached as a host / co-host / moderator on an
/// event. Display order drives the order they appear in the public
/// "Hosted by" section. Role is free-text so events can use whatever
/// label fits ("host", "co-host", "moderator", "MC", etc.).
///
/// Hosts also receive admin notifications for new registrations
/// (queued — Phase 4) and have admin access to the event's
/// registrations page (Phase 3 ships display-only).
model EventHost {
  id           String   @id @default(cuid())
  eventId      String
  userId       String
  role         String   @default("host")
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  event BhnEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User     @relation("UserEventHost", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, displayOrder])
}

/// An admin-defined question added to the public registration form
/// for a specific event. Answers are stored in CustomRegAnswer; the
/// pair is queried + displayed in admin views + CSV exports.
///
/// kind values drive the form widget:
///   • "text"        — single-line input
///   • "longtext"    — textarea
///   • "select"      — radio cards (options[] required)
///   • "multiselect" — checkbox group (options[] required)
///   • "checkbox"    — single yes/no acknowledgement
model CustomRegQuestion {
  id           String   @id @default(cuid())
  eventId      String
  /// Stable lowercase-hyphen identifier used in CSV export headers
  /// and admin URLs. Unique per event.
  key          String
  /// Question text shown above the input on the registration form.
  label        String
  /// Optional helper text shown below the input.
  hint         String?
  /// Widget kind — see file comment.
  kind         String   @default("text")
  /// JSON array of options for select / multiselect kinds. Each
  /// option is an object `{ value: string; label: string }`. Other
  /// kinds leave this null.
  options      Json?
  /// When true, the form blocks submission until an answer is provided.
  required     Boolean  @default(false)
  /// Render order on the form + admin list.
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  event   BhnEvent          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  answers CustomRegAnswer[]

  @@unique([eventId, key])
  @@index([eventId, displayOrder])
}

/// An answer to a CustomRegQuestion for one Registration. One row
/// per (registration, question). Stored as a plain string per the
/// question's kind:
///   • text / longtext  — raw input
///   • select           — chosen option's value
///   • multiselect      — comma-joined list of chosen values
///   • checkbox         — "yes" or "no"
model CustomRegAnswer {
  id                  String @id @default(cuid())
  registrationId      String
  customRegQuestionId String
  value               String

  registration Registration      @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  question     CustomRegQuestion @relation(fields: [customRegQuestionId], references: [id], onDelete: Cascade)

  @@unique([registrationId, customRegQuestionId])
  @@index([customRegQuestionId])
}

/// A bookable ticket tier on a paid event. Multiple tiers per event
/// (e.g. "Standard $40", "Student $20", "Industry $100"). priceCents
/// = 0 + currency = "CAD" keeps the existing free-registration flow
/// intact even when the event has paid ticket types.
///
/// Capacity is per-tier (NULL = uncapped, falls back to the event-
/// level maxAttendees). The TicketType is selected on the public
/// registration form when the event has any active ticket types
/// configured; otherwise the free flow runs as before.
model TicketType {
  id            String   @id @default(cuid())
  eventId       String
  name          String
  description   String?
  /// Price in cents (CAD). 0 = free. Lookups in the registration
  /// flow short-circuit Stripe Checkout when the chosen tier is free.
  priceCents    Int      @default(0)
  currency      String   @default("CAD")
  /// Optional per-tier capacity. NULL = uncapped (only event-level
  /// maxAttendees applies).
  capacity      Int?
  /// When false, the tier is hidden from the public form but
  /// existing registrations against it stay intact.
  isActive      Boolean  @default(true)
  displayOrder  Int      @default(0)
  /// Stripe Price ID — created lazily on first checkout and cached
  /// here so subsequent purchases re-use it.
  stripePriceId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  event BhnEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, displayOrder])
}

/// An email broadcast sent by an event host to a slice of attendees.
/// Recorded for audit + ability to re-send to specific recipients
/// later. Kept lightweight — body is stored as markdown, the send
/// loop renders to HTML at dispatch time using the existing
/// markdown helper.
model EventBroadcast {
  id             String    @id @default(cuid())
  eventId        String
  /// User who composed + sent the broadcast.
  sentById       String
  subject        String
  /// Markdown body. Rendered to HTML at send time.
  body           String
  /// "all" | "confirmed" | "pending" | "waitlist" | "checked_in"
  audienceFilter String
  /// Number of recipients the send loop actually attempted.
  recipientCount Int       @default(0)
  /// Number of attempts that returned successfully from SMTP.
  sentCount      Int       @default(0)
  /// Set when the send loop finishes (failures are also recorded
  /// in sentCount mismatch). Kept null while in flight.
  sentAt         DateTime?
  createdAt      DateTime  @default(now())

  event  BhnEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sentBy User     @relation("UserEventBroadcast", fields: [sentById], references: [id], onDelete: Restrict)

  @@index([eventId, createdAt])
}

/// One bookable workshop, tour, or bootcamp slot. The "slot" framing
/// matters: if a workshop runs morning + afternoon, it's two rows
/// (not one row with two children) — this keeps the booking math
/// simple and lets each slot have its own capacity, location,
/// transport requirement, etc.
model Workshop {
  id                  String   @id @default(cuid())
  eventId             String
  /// URL-safe identifier, unique within the parent event.
  slug                String
  title               String
  shortDescription    String?
  /// Long description (markdown) for the workshop's Learn More page.
  longDescription     String?
  /// Hosting partner org, e.g. "OBIO", "CATTI", "BioZone".
  partnerOrganization String?
  /// "workshop" | "tour" | "bootcamp" — drives presentation in UI.
  kind                String   @default("workshop") // workshop | tour | bootcamp
  startDateTime       DateTime
  endDateTime         DateTime
  locationName        String?
  locationAddress     String?
  /// True when attendees need to board a bus from a common pickup.
  requiresTransport   Boolean  @default(false)
  /// Where the bus departs from, e.g. "Chelsea Hotel Front Entrance".
  /// Null unless requiresTransport.
  departureLocation   String?
  /// Hard capacity. Bookings above capacity go to the waitlist.
  /// Default 20 reflects the standard symposium tour/workshop size.
  capacity            Int      @default(20)
  /// Hard cap on the waitlist length. Once both `capacity` confirmed
  /// AND `waitlistCapacity` waitlisted rows are taken, new booking
  /// attempts return a `waitlist_full` error and the UI surfaces a
  /// "waitlist is closed" state. Default 5.
  waitlistCapacity    Int      @default(5)
  /// When true, every new WorkshopBooking starts in `pending` status
  /// and an admin must approve it before the seat is held (or the
  /// waitlist position is assigned). When false, the legacy
  /// auto-confirm-or-waitlist behaviour applies. Default true — the
  /// symposium tours/workshops want admin curation by policy.
  requiresApproval    Boolean  @default(true)
  /// Optional external page (partner site, host org URL).
  learnMoreUrl        String?
  /// Render order within the event's workshop list.
  displayOrder        Int      @default(0)
  /// Soft on/off — false hides the workshop from public listings
  /// without deleting bookings.
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  event    BhnEvent          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bookings WorkshopBooking[]

  @@unique([eventId, slug])
  /// Supports "show me all workshops on day X in chronological order".
  @@index([eventId, startDateTime])
  /// Supports "show only active workshops on the public landing".
  @@index([eventId, isActive])
}

/// A user's booking for a specific Workshop slot. Status flows are
/// enforced at the service layer (Phase 1); the schema only ensures
/// uniqueness per (workshop, user) and supports the two queries that
/// matter at scale: "this user's bookings" (for the max-2 rule) and
/// "this workshop's confirmed + waitlist roster in order".
model WorkshopBooking {
  id               String    @id @default(cuid())
  workshopId       String
  userId           String
  /// "pending"   → admin hasn't approved yet; no seat held, not counted
  ///                toward capacity. Default for new bookings whenever
  ///                the parent Workshop has `requiresApproval=true`.
  /// "confirmed" → has a seat. Counts toward `Workshop.capacity`.
  /// "waitlist"  → queued; promoted when a confirmed booking cancels.
  ///                Counts toward `Workshop.waitlistCapacity`.
  /// "cancelled" → kept for audit; doesn't count toward anything.
  status           String    @default("pending") // pending | confirmed | waitlist | cancelled
  /// 1-indexed position when status="waitlist"; null otherwise.
  /// Re-numbered densely on earlier waitlist cancellation.
  waitlistPosition Int?
  bookedAt         DateTime  @default(now())
  cancelledAt      DateTime?
  /// When the admin moved this row out of `pending` (to confirmed
  /// or waitlist). Stays null on rows that never required approval.
  approvedAt       DateTime?
  approvedById     String?

  workshop   Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  approvedBy User?    @relation("WorkshopBookingApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([workshopId, userId])
  /// Supports the MAX_WORKSHOPS_PER_USER = 2 check at booking time
  /// (count this user's non-cancelled bookings).
  @@index([userId, status])
  /// Supports "next waitlist person to promote on this workshop".
  @@index([workshopId, status, waitlistPosition])
}

/// One slot on the symposium-day agenda. Different from Workshop —
/// these are not bookable individually (everyone with a Registration
/// has access). For parallel breakouts where attendees pick one,
/// isSelectable=true and breakoutGroupId groups the choices.
model SymposiumSession {
  id              String   @id @default(cuid())
  eventId         String
  title           String
  description     String?
  startTime       DateTime
  endTime         DateTime
  room            String?
  /// "registration" | "opening" | "presentation" | "keynote" | "panel"
  /// | "spotlight" | "breakout" | "pitch_competition" | "break" | "meal"
  /// | "networking" | "closing"
  kind            String // registration | opening | presentation | keynote | panel | spotlight | breakout | pitch_competition | break | meal | networking | closing
  /// True only for parallel-breakout slots where attendees must pick
  /// one of N. UI enforces "pick at most one per breakoutGroupId" —
  /// schema doesn't constrain that directly.
  isSelectable    Boolean  @default(false)
  /// Groups concurrent selectable sessions. e.g. two 1:30pm breakouts
  /// both have breakoutGroupId="afternoon-breakouts".
  breakoutGroupId String?
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event         BhnEvent                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  speakers      SymposiumSessionSpeaker[]
  agendaEntries PersonalAgendaEntry[]
  questions     SymposiumQuestion[]
  polls         Poll[]

  /// Supports "render the agenda in chronological order".
  @@index([eventId, startTime])
  /// Supports "show me all sessions in the afternoon-breakouts group".
  @@index([eventId, breakoutGroupId])
}

/// Speaker bio scoped to a specific Event (the same person can appear
/// in multiple events as separate Speaker rows — bio/title might
/// evolve between editions).
model Speaker {
  id           String   @id @default(cuid())
  eventId      String
  fullName     String
  title        String?
  organization String?
  /// Markdown.
  bio          String?
  photoUrl     String?
  /// JSON array of { platform, url } — twitter, linkedin, etc.
  socialLinks  Json?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  event    BhnEvent                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sessions SymposiumSessionSpeaker[]

  /// Supports "show me this event's speaker grid in display order".
  @@index([eventId])
}

/// Many-to-many between SymposiumSession and Speaker, plus the
/// speaker's role within that specific session.
model SymposiumSessionSpeaker {
  sessionId String
  speakerId String
  /// "speaker" | "moderator" | "panelist" | "facilitator"
  role      String @default("speaker") // speaker | moderator | panelist | facilitator
  /// Render order within the session's speaker list.
  order     Int    @default(0)

  session SymposiumSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  speaker Speaker          @relation(fields: [speakerId], references: [id], onDelete: Cascade)

  @@id([sessionId, speakerId])
}

/// Event-level registration. One per (event, user). Holds payment +
/// check-in state. Workshops and breakout picks are separate models —
/// the service layer enforces "must have a CONFIRMED Registration
/// before booking workshops" (not enforced via FK).
model Registration {
  id                   String    @id @default(cuid())
  eventId              String
  /// FK to User when the registrant has a platform account, NULL
  /// when they registered as a guest. Nullability added Dec '26 to
  /// support public registration without sign-in (important for
  /// info sessions where requiring an account would be a barrier).
  /// When userId is null, the guest* fields below carry the
  /// contact info instead.
  userId               String?
  /// When userId is null, the email we'll send the confirmation to.
  /// Lower-cased + trimmed at insert time so duplicate detection
  /// isn't case-sensitive. Unique per event via the @@unique below.
  guestEmail           String?
  /// Display name for badge + attendee list. Required when
  /// registering as a guest; ignored when userId is set (we use
  /// User.fullName).
  guestName            String?
  /// Optional org / institution affiliation for the guest.
  guestOrganization    String?
  /// Optional phone number captured at registration for SMS
  /// reminders. E.164 format (e.g. "+14165551234"). NULL means the
  /// attendee didn't provide a number; the cron skips SMS for them.
  guestPhone           String?
  /// Explicit opt-in for SMS reminders. Even with a phone on file,
  /// the cron only sends SMS when this is true (avoids ambushing
  /// people who typed their number in for some other reason).
  smsOptIn             Boolean   @default(false)
  /// "trainee" | "industry" | "academic" | "student" | "sponsor" | "guest"
  attendeeType         String    @default("trainee") // trainee | industry | academic | student | sponsor | guest
  /// "pending" | "confirmed" | "waitlist" | "cancelled"
  /// Added "waitlist" Dec '26 to support event-level capacity caps.
  /// When BhnEvent.maxAttendees is reached and waitlistEnabled is
  /// true, new registrations land here with waitlistPosition set.
  /// cancelRegistration auto-promotes position 1 on confirmed-seat
  /// cancellations.
  registrationStatus   String    @default("pending") // pending | confirmed | waitlist | cancelled
  /// 1 = next-in-line. Null for pending / confirmed / cancelled rows.
  /// Auto-promotion fills the gap when position 1 cancels — we leave
  /// numeric gaps (don't decrement remaining positions) to keep the
  /// "you were #N" promise stable across cancellations.
  waitlistPosition     Int?
  /// Some attendees register only for the Training Week workshops
  /// and skip the symposium day. Default true.
  includesSymposiumDay Boolean   @default(true)
  /// "moneris" | "stripe" | "invoice" | "free" | "none"
  paymentProvider      String    @default("none") // moneris | stripe | invoice | free | none
  /// "pending" | "paid" | "refunded" | "failed" | "waived"
  paymentStatus        String    @default("pending") // pending | paid | refunded | failed | waived
  /// Provider's payment ID for reconciliation.
  externalPaymentId    String?
  amountCents          Int       @default(0)
  currency             String    @default("CAD")
  /// Random 128-bit hex string. Drives the check-in QR code; unique.
  qrToken              String    @unique
  checkedInAt          DateTime?
  /// Free text. Collected by the registration form so catering plans.
  dietaryRestrictions  String?
  /// Free text. Wheelchair access, hearing loop, etc.
  accessibilityNeeds   String?
  /// Admin-only annotation. VIP / press / speaker flag, special
  /// handling notes, anything the events team wants to remember.
  /// Never shown to the registrant.
  adminNote            String?
  /// When an admin moved this row out of `pending` to `confirmed`.
  /// Null while still pending (or on legacy auto-confirmed rows
  /// migrated in via backfill — those get the row's createdAt to
  /// match the audit story).
  approvedAt           DateTime?
  approvedById         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  event         BhnEvent          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user          User?             @relation(fields: [userId], references: [id], onDelete: Restrict)
  approvedBy    User?             @relation("RegistrationApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  customAnswers CustomRegAnswer[]

  /// Idempotency for signed-in registrants — one row per (event, user).
  /// Per SQL standard NULL != NULL, so multiple guest rows (userId=null)
  /// for the same event don't violate this; they're constrained by the
  /// separate (eventId, guestEmail) unique below.
  @@unique([eventId, userId])
  /// Idempotency for guest registrants — one row per (event, guestEmail).
  /// Guest emails are lower-cased + trimmed at insert so case variants
  /// (Foo@Bar vs foo@bar) can't sneak past the constraint.
  @@unique([eventId, guestEmail])
  /// Supports the admin attendee list — "show me all confirmed
  /// registrations for this event".
  @@index([eventId, registrationStatus])
}

/// A user's saved symposium-day session. Used for two purposes:
///   1. Pick-one breakout selection (multiple agenda entries with
///      the same breakoutGroupId is a UI-level conflict the form
///      prevents — schema allows multiple)
///   2. "Add to my personal schedule" for non-selectable items
model PersonalAgendaEntry {
  id                 String   @id @default(cuid())
  userId             String
  symposiumSessionId String
  createdAt          DateTime @default(now())

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  session SymposiumSession @relation(fields: [symposiumSessionId], references: [id], onDelete: Cascade)

  @@unique([userId, symposiumSessionId])
  /// Supports "render this user's personal schedule".
  @@index([userId])
}

/// Event sponsor / partner / funder. Tier drives logo size on the
/// landing page.
model Sponsor {
  id           String   @id @default(cuid())
  eventId      String
  name         String
  /// "title" | "gold" | "silver" | "bronze" | "partner" | "funder"
  tier         String   @default("partner") // title | gold | silver | bronze | partner | funder
  logoUrl      String?
  website      String?
  description  String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  event BhnEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  /// Supports "render this event's sponsor grid in display order".
  @@index([eventId])
}

/// Live Q&A entry tied to a symposium session. Phase 0 ships the
/// schema only — no creation/voting routes yet. The upvoteCount
/// field is denormalised (incremented in a transaction with the
/// SymposiumQuestionVote insert at Phase 1) so the "top questions"
/// view stays fast under load.
///
/// Named `SymposiumQuestion` rather than `Question` because
/// `Question` is taken by the assessment-quiz model elsewhere in
/// this schema.
model SymposiumQuestion {
  id                 String   @id @default(cuid())
  symposiumSessionId String
  userId             String
  body               String
  upvoteCount        Int      @default(0)
  isAnswered         Boolean  @default(false)
  createdAt          DateTime @default(now())

  session SymposiumSession        @relation(fields: [symposiumSessionId], references: [id], onDelete: Cascade)
  user    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes   SymposiumQuestionVote[]

  /// Supports the live Q&A "top of the room" sort — highest-voted
  /// unanswered questions first.
  @@index([symposiumSessionId, upvoteCount(sort: Desc)])
}

/// One upvote per (question, user).
model SymposiumQuestionVote {
  questionId String
  userId     String
  createdAt  DateTime @default(now())

  question SymposiumQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([questionId, userId])
}

/// Live poll launched by the moderator during a symposium session.
/// Options are stored as JSON to keep them tiny; PollResponse keeps
/// the (poll, user, picked-option) tuple.
model Poll {
  id                 String    @id @default(cuid())
  symposiumSessionId String
  question           String
  /// JSON array of { id: string, label: string }
  options            Json
  isOpen             Boolean   @default(false)
  createdAt          DateTime  @default(now())
  closedAt           DateTime?

  session   SymposiumSession @relation(fields: [symposiumSessionId], references: [id], onDelete: Cascade)
  responses PollResponse[]
}

model PollResponse {
  id        String   @id @default(cuid())
  pollId    String
  userId    String
  /// One of the option ids from Poll.options.
  optionId  String
  createdAt DateTime @default(now())

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
}

// ════════════════════════════════════════════════════════════════
// Theme feedback — user voting + theme-proposal pipeline
//
// Users can pick one favorite + one least-favorite theme from the
// thirteen built-in themes (see THEMES in ThemeProvider.tsx), and
// they can submit ideas for new themes. Admins review proposals at
// /admin/theme-proposals and can optionally "ship + bounty" — which
// issues a tier-3 MerchReward to the proposer.
//
// Conventions
//   • themeId stored as String (not FK) — themes are code constants,
//     not rows. Drift between code and DB is acceptable here; a
//     deleted theme just leaves orphan votes (cleaned up via admin
//     SQL when a theme retires).
//   • One favorite + one least-favorite per user — enforced via
//     @@unique([userId, sentiment]). Changing your mind is an upsert,
//     not a new row.
//   • Tier-3 MerchReward is the bounty surface — see MERCH_TIERS in
//     src/lib/rewards/merch.ts. Existing (userId, tier) unique
//     constraint on MerchReward means each user gets at most ONE
//     bounty across all their shipped proposals — they're rewarded
//     for contributing, not per-idea. Multiple shipped proposals
//     link to the same MerchReward via bountyRewardId.
// ════════════════════════════════════════════════════════════════

/// User vote on a specific theme. Up to MAX_VOTES_PER_SENTIMENT (3,
/// see src/lib/themes/constants.ts) favourites and 3 least-favourites
/// per user — the count cap is enforced at the API layer, not the
/// schema. Schema enforces only that the same (user, sentiment,
/// themeId) triple is unique (idempotent re-vote, not duplicate row).
/// A theme can't appear as both favourite AND least-favourite for the
/// same user; the API enforces that via a delete-the-opposite-side
/// step inside the upsert transaction.
model ThemeVote {
  id        String   @id @default(cuid())
  userId    String
  /// Matches the ThemeId enum in src/components/ui/ThemeProvider.tsx.
  /// Stored as String rather than FK because themes are code
  /// constants, not rows.
  themeId   String
  /// "favorite" | "least_favorite"
  sentiment String // favorite | least_favorite
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// (user, sentiment, theme) is the natural identity of a vote.
  /// Re-voting the same theme with the same sentiment is a no-op;
  /// the count cap (≤ 3 per sentiment per user) lives at the API.
  @@unique([userId, sentiment, themeId])
  /// Supports the aggregated "top loved" / "top disliked" stats on
  /// the admin queue.
  @@index([themeId, sentiment])
}

/// User-submitted theme idea. Admin triages via the
/// /admin/theme-proposals queue. When admin marks "shipped", they
/// can issue a one-time tier-3 MerchReward bounty for the proposer.
model ThemeProposal {
  id             String    @id @default(cuid())
  proposerId     String
  /// Short title, e.g. "Lab Bench" or "Citrus Grove".
  title          String
  /// Markdown — palette ideas, mood, intended use, references.
  description    String
  /// Optional palette / mood notes the proposer wants to call out
  /// separately from the description.
  inspiration    String?
  /// Lifecycle:
  ///   "submitted"    → just in. Admin hasn't looked yet.
  ///   "under_review" → admin acknowledged; deciding.
  ///   "building"     → admin chose to build it.
  ///   "shipped"      → built and deployed. Theme is live.
  ///   "declined"     → not building. reviewerNote explains why.
  status         String    @default("submitted") // submitted | under_review | building | shipped | declined
  reviewerId     String?
  /// Admin's note back to the proposer. Strongly recommended for
  /// "declined" and "shipped" so the proposer always gets context.
  reviewerNote   String?
  reviewedAt     DateTime?
  /// Once shipped, the ThemeId actually deployed (may differ in name
  /// from the proposal). Drives the proposer's "see your theme live"
  /// link on /themes.
  shippedThemeId String?
  /// True when the admin issued the tier-3 MerchReward bounty.
  /// Prevents double-issuing per proposal; not all "shipped"
  /// proposals must trigger a bounty (admin discretion).
  bountyIssued   Boolean   @default(false)
  /// FK to the MerchReward row at bounty time. Null until the admin
  /// clicks "ship + reward". When multiple proposals from the same
  /// user ship, they all link to the same MerchReward (one bundle
  /// per user, by the (userId, tier) unique on MerchReward).
  bountyRewardId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  proposer User  @relation("ThemeProposals", fields: [proposerId], references: [id], onDelete: Cascade)
  reviewer User? @relation("ThemeProposalReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  /// Supports the admin queue's status filter + chronological sort.
  @@index([status, createdAt])
  /// Supports the proposer's "my proposals" page.
  @@index([proposerId])
}

/// Per-period "what users told us" research synthesis.
///
/// The /admin/insights page surfaces every user signal the platform
/// already captures (theme votes, theme proposals, exit-survey
/// responses, access requests, audit-log patterns) — but signals
/// without synthesis stay at level-2 maturity. This model captures
/// the synthesis itself: one admin reads the period's signals,
/// writes a 1–3 paragraph note, optionally publishes it to the
/// changelog so the loop closes back to users.
///
/// One row per period (typically YYYY-MM, but admins can also use
/// YYYY-WW for weekly cadence or "release-N" tied to a deploy).
model ResearchInsight {
  id String @id @default(cuid())

  /// Period key — free text, but conventionally YYYY-MM or
  /// release-NNN. Unique so per-period upserts are natural.
  period String @unique

  /// 1–3 paragraph synthesis. Markdown supported. This is the
  /// answer to "what did users tell us this period?".
  body String

  /// Optional array of `{ kind, id, snippet }` references back to
  /// the signals that informed this insight — theme votes, feedback
  /// rows, etc. Used by /admin/insights to render an evidence
  /// trail so the synthesis isn't taken on faith.
  signalsLinked Json?

  /// When non-null, a copy of the body was published to ChangeLog
  /// as a "What users told us" entry. Idempotency guard for the
  /// publish-to-changelog button.
  publishedToChangelogAt DateTime?
  publishedChangelogId   String?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User? @relation("ResearchInsightAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("ResearchInsightUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  /// Supports the chronological list on /admin/insights.
  @@index([createdAt])
}

/// Per-posting application-prep coaching session.
///
/// Each trainee gets one PrepSession per posting they prepare for.
/// The session walks them through four steps:
///   1. compare    — resume vs JD keyword analysis
///   2. gaps       — actions to close the gaps (resume bullets, courses)
///   3. interview  — common-question drafts
///   4. star       — STAR-story drafts tied to required skills
///
/// State is stored as JSON per step rather than a wide column set —
/// the shape of each step's data is allowed to evolve without a
/// migration. The state shape is documented in
/// src/lib/prep/types.ts as `PrepSessionState`.
model PrepSession {
  id          String   @id @default(cuid())
  userId      String
  postingId   String
  /// Current step the user is on. 1..4 corresponding to the four
  /// stages above. Saved so coming back lands on the right step.
  currentStep Int      @default(1)
  /// Per-step blobs. Each blob is keyed by step name and matches the
  /// PrepSessionState type. Null until the trainee opens the step.
  state       Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User              @relation("UserPrepSession", fields: [userId], references: [id], onDelete: Cascade)
  posting InternshipPosting @relation(fields: [postingId], references: [id], onDelete: Cascade)

  /// One session per (user, posting) — re-opening returns the same row.
  @@unique([userId, postingId])
  @@index([userId, updatedAt])
  @@index([postingId])
}

/// Reusable STAR-format story authored by a trainee.
///
/// Decoupled from PrepSession because stories are valuable beyond one
/// posting — a trainee who writes "the time I troubleshot a stalled
/// bioreactor run" should be able to reuse that story for every
/// posting that needs the corresponding skills. The Story Bank at
/// /profile/stories lists every story the trainee has authored.
///
/// Skills (zero or more) link the story to the skill ontology so the
/// prep flow can suggest "you have a story for this skill" when
/// drafting answers for a new posting. Tags are free-form keywords
/// the trainee adds for their own organisation.
model StarStory {
  id              String   @id @default(cuid())
  userId          String
  /// Short noun phrase the user names the story by. Surfaced in the
  /// Story Bank list + when picking a story to attach to an answer.
  title           String
  /// The four STAR fields. Stored as free text; word count +
  /// structure-hint feedback is computed client-side from these.
  situation       String
  task            String
  action          String
  result          String
  /// Free-form keywords the trainee tags for their own organisation.
  tags            String[] @default([])
  /// AI-suggested revisions, kept as history so the trainee can revert.
  /// Each item: { suggestedAt: ISO string, body: string, accepted?: boolean }.
  /// Null when no polish has run.
  aiHistory       Json?
  /// Where the story was drafted from — kept for analytics so we can
  /// see how often Story Bank entries are reused across postings.
  sourcePostingId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user   User               @relation("UserStarStory", fields: [userId], references: [id], onDelete: Cascade)
  skills StarStorySkill[]
  source InternshipPosting? @relation("StarStorySource", fields: [sourcePostingId], references: [id], onDelete: SetNull)

  /// Supports "every story this trainee has authored, newest first".
  @@index([userId, updatedAt])
}

/// Many-to-many between StarStory and Skill — a single story can
/// demonstrate multiple skills. The platform's matching layer
/// reads this back when suggesting story candidates for a posting:
/// "you already have a story tagged with `cell culture` — reuse it?"
model StarStorySkill {
  storyId String
  skillId String

  story StarStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  skill Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([storyId, skillId])
  @@index([skillId])
}

/// Job offer issued by an employer to a trainee at the end of the
/// hiring pipeline. One per ApplicationStatus row — when a posting
/// is at status `offer` or `hired`, this row holds the actual offer
/// terms + the trainee's response.
///
/// The body is plain markdown rendered into the offer-view page.
/// When the trainee accepts, we record a corresponding
/// ElectronicSignature row (via signatureId) so the acceptance has
/// the same audit trail as a training-completion signature.
model Offer {
  id                  String    @id @default(cuid())
  applicationStatusId String    @unique
  /// Denormalised for query convenience — both also reachable
  /// through applicationStatus.posting / applicationStatus.applicant.
  postingId           String
  applicantId         String
  /// Employer who authored the offer. Null if HR composed via the
  /// admin act-as path and the audit later loses the link.
  createdById         String?
  /// draft | sent | accepted | declined | withdrawn | expired
  status              String    @default("draft")
  /// Which template the offer was drafted from. Free-text; the
  /// template registry lives in src/lib/hiring/offer-templates.ts.
  templateKey         String?
  /// Rendered offer letter body — markdown. Template variables are
  /// already substituted at the time the row is created/edited.
  body                String
  /// Surfaceable summary fields. Optional; the body is the source
  /// of truth but these power list-view chips + analytics filters.
  compensation        String?
  startDate           DateTime?
  endDate             DateTime?
  hoursPerWeek        String?
  location            String?
  /// Hard deadline for the trainee to respond. After this passes the
  /// nightly sweep flips status from `sent` → `expired`.
  acceptDeadline      DateTime?
  sentAt              DateTime?
  respondedAt         DateTime?
  /// Optional reason the trainee gave when declining. Visible to the
  /// employer.
  declineReason       String?
  /// FK to ElectronicSignature when the trainee countersigns on
  /// accept. Null until accepted.
  signatureId         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  applicationStatus ApplicationStatus @relation(fields: [applicationStatusId], references: [id], onDelete: Cascade)
  posting           InternshipPosting @relation(fields: [postingId], references: [id], onDelete: Cascade)
  applicant         User              @relation("OfferRecipient", fields: [applicantId], references: [id], onDelete: Cascade)
  createdBy         User?             @relation("OfferAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([applicantId, status])
  @@index([postingId, status])
}

/// Structured score + rubric for one interviewer's evaluation of an
/// Interview. Multi-stakeholder by design: each interviewer creates
/// their own InterviewScore row; the deliberation view aggregates
/// them. The (interviewId, scorerUserId) unique constraint stops
/// duplicate rows per scorer.
model InterviewScore {
  id             String   @id @default(cuid())
  interviewId    String
  scorerUserId   String
  /// 1..5 — overall fit for the role.
  overallScore   Int
  /// Per-skill scoring. JSON: { [skillId]: 1..5 }. Lets the
  /// deliberation page compare on the same axes across scorers.
  skillScores    Json?
  /// hire | maybe | pass — the recommendation the scorer wants
  /// recorded. Aggregates as a tally on the deliberation page.
  recommendation String
  /// Free-text: what stood out (positively).
  strengths      String?
  /// Free-text: what didn't (concerns / gaps / red flags).
  concerns       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  scorer    User      @relation("InterviewScorer", fields: [scorerUserId], references: [id], onDelete: Cascade)

  @@unique([interviewId, scorerUserId])
  @@index([interviewId])
}

// ──────────────────────────────────────────────────────────────
//  AI behaviour-assist
//  ──────────────────────────────────────────────────────────────
//  See docs in src/lib/assist/* for design. Net of it:
//
//   AssistEvent           — raw behaviour signals (90-day retention)
//   AssistDailyRollup     — per-user-per-surface daily summary (12 mo)
//   AssistWeeklySummary   — LLM-written 2–4 sentence journey (18 mo)
//   AssistHint            — queued / shown / dismissed hint
//   AssistHintFeedback    — implicit + explicit feedback events
//   AssistPreferences     — per-user consent / mute / threshold
//
//  All cascade with User — when the user leaves, their assist
//  trail goes with them.
// ──────────────────────────────────────────────────────────────

model AssistEvent {
  id        String   @id @default(cuid())
  userId    String
  sessionId String
  ts        DateTime @default(now())
  /// "click" | "rage_click" | "dead_click" | "surface.view"
  /// | "form.focus" | "form.field_complete" | "form.abandon"
  /// | "form.submit_attempt" | "error.client" | "dwell"
  /// | "idle.start" | "idle.end"
  kind      String
  /// Surface key (route or `data-surface`), e.g. "/employer/postings".
  surface   String?
  /// Human-readable click target ("Save changes button"), not raw DOM.
  target    String?
  payload   Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, ts])
  @@index([sessionId, ts])
  /// Indexed partial for the stuck-detection pre-filter, which only
  /// ever reads the trailing 30-day window.
  @@index([kind, ts])
}

model AssistDailyRollup {
  id           String   @id @default(cuid())
  userId       String
  surface      String
  /// UTC-midnight of the day this row aggregates.
  day          DateTime
  views        Int      @default(0)
  clicks       Int      @default(0)
  rageClicks   Int      @default(0)
  deadClicks   Int      @default(0)
  formAbandons Int      @default(0)
  errors       Int      @default(0)
  dwellMs      Int      @default(0)
  /// True if at least one task was completed on this surface today
  /// (heuristic: a form.submit_attempt without a subsequent error).
  completed    Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, surface, day])
  @@index([userId, day])
  @@index([day])
}

model AssistWeeklySummary {
  id        String   @id @default(cuid())
  userId    String
  /// Monday 00:00 UTC of the week this row covers.
  weekStart DateTime
  /// 2–4 sentence LLM-written description of the user's week.
  summary   String
  /// Surface keys where the stuck-detection rule scored high.
  stuckOn   String[]
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@index([userId, weekStart])
  @@index([weekStart])
}

model AssistHint {
  id          String    @id @default(cuid())
  userId      String
  /// Stable key into the help-card registry. Always one of the
  /// curated keys; the AI selects, never authors prose.
  helpKey     String
  /// Snapshotted at queue time so registry edits don't retroactively
  /// rewrite history.
  title       String
  body        String
  ctaLabel    String?
  ctaHref     String?
  /// Surface the user was on when the hint was triggered.
  surface     String?
  /// "rule:rage-click" | "rule:form-abandon" | "ai:claude-haiku" | ...
  triggeredBy String
  /// 0..1. Drives whether the hint actually shows
  /// (per-user threshold + global floor).
  confidence  Float     @default(0.5)
  /// pending = queued; shown = currently visible / recently visible;
  /// dismissed = user clicked ✕; clicked = user followed the CTA;
  /// expired = TTL elapsed without a show; suppressed = preferences
  /// killed it before show.
  status      String    @default("pending")
  shownAt     DateTime?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  /// Hints have a short TTL — a stuck-state from 2 days ago is no
  /// longer the right interruption.
  expiresAt   DateTime

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedback AssistHintFeedback[]

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([helpKey, status])
}

model AssistHintFeedback {
  id     String   @id @default(cuid())
  userId String
  hintId String
  /// "shown" | "clicked" | "dismissed" | "ignored" | "rated"
  kind   String
  /// 1..5 — only set when kind = "rated"
  rating Int?
  ts     DateTime @default(now())

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  hint AssistHint @relation(fields: [hintId], references: [id], onDelete: Cascade)

  @@index([hintId, kind])
  @@index([userId, ts])
}

model AssistPreferences {
  userId              String    @id
  /// True once the user has consented to behaviour collection.
  /// Default `true` — the "Help nudges" feature opts new users in
  /// at row-creation time and surfaces a first-run notice banner
  /// (with a one-click opt-out) so they're aware. Existing users
  /// who actively turned it OFF keep their choice — the migration
  /// only flips the column default, not stored values.
  consented           Boolean   @default(true)
  consentedAt         DateTime?
  /// User flipped the kill switch — events still collected (because
  /// consent is on), but hints are suppressed.
  hintsDisabled       Boolean   @default(false)
  /// Per-user calibrated confidence threshold. Starts at the
  /// platform default (0.75), moves up if the user dismisses a lot,
  /// down if they engage with hints.
  confidenceThreshold Float     @default(0.75)
  /// "Don't show me hints for 10 min" — soft mute.
  suppressUntil       DateTime?
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Equip pillar ────────────────────────────────────────────────
// Funding-application pipeline. One row per draft / submission;
// state machine flows draft → submitted → under_review →
// approved | rejected → (if approved) funded. JSONB columns hold
// the stream-specific form body so we can iterate questions
// without per-field migrations.

model EquipApplication {
  id                     String    @id @default(cuid())
  userId                 String
  /// "venture_connect" | "venture_lift"
  stream                 String
  /// Pipeline status — extended set:
  ///   draft | submitted | under_review
  ///   | pre_screen_approved | pre_screen_rejected   ← VL stage-1 outcomes
  ///   | approved | rejected | funded
  /// VentureLift moves through pre_screen_approved before its
  /// applicant can open the full Stage-2 form; VentureConnect
  /// skips that intermediate state.
  status                 String    @default("draft")
  /// Which stage of the application is currently in play.
  ///   pre_screen — only set for VL while it's pre-screening
  ///   full_app   — set when VL has moved past pre-screening and
  ///                the applicant is filling in the full form,
  ///                or when VC (no pre-screen) is anywhere in
  ///                its flow.
  applicationStage       String    @default("pre_screen")
  requestedAmount        Float?
  approvedAmount         Float?
  /// "grad" | "postdoc" | "research_associate" | "founder"
  applicantType          String?
  /// Slug from the curated 14-institution list (see
  /// lib/equip/institutions.ts).
  institution            String?
  institutionOther       String?
  /// "exploring" | "building" | "unsure" — routes stream pick.
  commercializationStage String?
  /// Stream-specific form fields. Typed shape lives in
  /// lib/equip/types.ts.
  formData               Json      @default("{}")
  /// Attachments. Shape: [{ key, name, size, contentType, kind }]
  /// where kind is "pitch_deck" | "prototype_photo" | "letter" |
  /// "video_pitch" | "cv" | "support_letter" | "ip_doc" | "other".
  documents              Json      @default("[]")
  reviewerId             String?
  reviewerNote           String?
  reviewedAt             DateTime?
  submittedAt            DateTime?
  /// VL pre-screening decision timestamp. Distinct from
  /// decidedAt (final approve/reject of the full app).
  preScreenDecidedAt     DateTime?
  /// Reviewer note from the pre-screening decision. Distinct
  /// from reviewerNote which now refers to the final Stage-2
  /// decision.
  preScreenReviewerNote  String?
  /// When the full (Stage-2) application form was submitted.
  /// Null while the applicant is still drafting Stage 2.
  fullAppSubmittedAt     DateTime?
  /// Per-criterion reviewer scores for VL Stage 2. Mirrors the
  /// 6 categories in the Evaluation Guide. Shape:
  ///   { innovation: 1-5, market: 1-5, plan: 1-5,
  ///     commercialization: 1-5, impact: 1-5, budget: 1-5,
  ///     comment?: string }
  reviewerScores         Json?
  decidedAt              DateTime?
  fundedAt               DateTime?
  disbursementNote       String?
  aiAssisted             Boolean   @default(false)
  /// Post-approval check-in templates. Shape: [{ id, title, dueOn,
  /// status, note, updatedAt }].
  milestones             Json      @default("[]")
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user     User                      @relation("EquipApplicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User?                     @relation("EquipReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  messages EquipApplicationMessage[]

  @@index([userId, status])
  @@index([status, submittedAt])
  @@index([reviewerId])
}

model EquipApplicationMessage {
  id            String   @id @default(cuid())
  applicationId String
  userId        String
  body          String
  createdAt     DateTime @default(now())

  application EquipApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
}

// ─── Committee memberships ──────────────────────────────────────
// Per-user, per-committee side relationship. Two committees ship
// initially (see lib/committees/registry.ts): equip_review and
// hqp. Adding a third is a code change to the registry, not a
// schema migration. The unique index on (userId, committee) means
// a user can only join each committee once.

model CommitteeMembership {
  id        String    @id @default(cuid())
  userId    String
  /// One of the slugs in COMMITTEES (lib/committees/registry.ts):
  /// "equip_review" | "hqp" | future. Stored as plain text so
  /// adding a new committee doesn't require a migration.
  committee String
  /// Soft-delete style — admins flip this off rather than deleting
  /// the row, so the audit trail (joinedAt, leftAt) survives.
  active    Boolean   @default(true)
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?
  /// Optional context the admin adds when granting / revoking.
  note      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, committee])
  @@index([committee, active])
}

// ─── Equip application deadlines ─────────────────────────────────
// Each row is one funding window for one stream. VentureConnect
// runs roughly monthly; VentureLift runs roughly quarterly. The
// schema doesn't enforce the cadence — admins create whichever
// windows they want, with whatever cycle labels make sense.
//
// status semantics:
//   • open     — applicants can submit against this window. May
//                be in the future (a scheduled window) or
//                actively running.
//   • closed   — manually closed by an admin, OR the original
//                deadlineAt passed without extension. Submissions
//                blocked.
//   • extended — equivalent to open for gating purposes. The flag
//                preserves the audit trail ("this deadline was
//                originally X, we moved it to Y"). originalDeadlineAt
//                is the pre-extension date; deadlineAt is the
//                current effective deadline.

model EquipDeadline {
  id                 String    @id @default(cuid())
  /// "venture_connect" | "venture_lift" — see lib/equip/types.ts.
  /// Stored as plain text so adding a third stream is a code-only
  /// change, not a migration.
  stream             String
  /// The currently active deadline. Submissions are blocked when
  /// `status = "closed"` OR (`status = "open"` AND now > deadlineAt).
  deadlineAt         DateTime
  /// The original deadlineAt at creation time. Stays put when an
  /// admin extends the window — the audit trail says "shipped
  /// originally at X, extended to Y".
  originalDeadlineAt DateTime
  /// "open" | "closed" | "extended" — see model header.
  status             String    @default("open")
  /// Free-form label admins use to find the right window in the
  /// admin list view. Examples: "May 2026 cycle", "Q2 2026",
  /// "Pilot batch — Toronto". Optional; the date alone is also
  /// fine as a discriminator.
  cycleLabel         String?
  /// Free-form note shown on the admin row + the applicant
  /// deadline card. Useful for "moved from May 1 because of the
  /// holiday Monday."
  note               String?
  /// Who created this window (audit + display).
  createdById        String
  /// Who closed it manually, if anyone (status = "closed" can
  /// also reflect a date-passed close, in which case this is
  /// null and closedAt is the deadlineAt date).
  closedAt           DateTime?
  closedById         String?
  /// When the window was last extended. Null until first extend.
  extendedAt         DateTime?
  extendedById       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  createdBy  User  @relation("EquipDeadlineCreator", fields: [createdById], references: [id])
  closedBy   User? @relation("EquipDeadlineCloser", fields: [closedById], references: [id])
  extendedBy User? @relation("EquipDeadlineExtender", fields: [extendedById], references: [id])

  @@index([stream, status, deadlineAt])
  @@index([deadlineAt])
}

// ─── Opportunity deadlines (KE / MA / Engage highlights) ────────
// Single polymorphic table that surfaces "deadline-driven" cards
// on the trainee dashboard's WE ARE DEADLINE-DRIVEN section for
// content that doesn't have its own dedicated model — Knowledge
// Exchange rounds, Mobility Award windows, and admin-curated
// Engage highlights (special workshops, featured pathways).
//
// `kind` discriminates the source ("knowledge_exchange",
// "mobility_award", "engage_highlight", or any future kind);
// `pillar` is the column it surfaces under ("engage" |
// "experience" | "equip" | "events"). Splitting these means a
// "MA opportunity for Experience" + a "MA opportunity surfaced
// under Equip for a sponsor demo" can both live here without an
// enum change.
model OpportunityDeadline {
  id           String    @id @default(cuid())
  /// Source kind — see model header.
  kind         String
  /// Dashboard pillar column.
  pillar       String
  title        String
  /// Optional short blurb (1–3 lines) rendered under the title.
  blurb        String?
  /// Optional opens-on date (e.g. "Opens May 4, 2026").
  opensAt      DateTime?
  /// Apply-by deadline.
  deadlineAt   DateTime?
  /// "active" | "closed" | "full" — closed/full items still render
  /// with a status pill so trainees see the cycle exists.
  status       String    @default("active")
  /// Optional CTA destination; if absent, the card is non-clickable.
  ctaUrl       String?
  /// Optional CTA label override (e.g. "Apply by May 29").
  ctaLabel     String?
  /// Optional eyebrow-style status pill text (e.g. "FULL · NEXT
  /// COHORT IN FALL"). Overrides the default status-derived pill.
  pillText     String?
  /// Smaller = higher priority within its pillar column.
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([pillar, status, displayOrder])
  @@index([deadlineAt])
  @@index([kind])
}

// ─── HQP Advisory Committee ─────────────────────────────────────
// The committee runs an annual open call for new members. Each
// call lives as a "window" — open + close timestamps mirroring
// the EquipDeadline pattern. Eligible trainees submit an
// application against the active window; admins review and
// approve / reject. Approval creates a CommitteeMembership row
// with slug = "hqp".

model HqpApplicationWindow {
  id          String   @id @default(cuid())
  /// Annual cycle the window belongs to (eg. 2026).
  year        Int
  title       String
  description String?
  opensAt     DateTime
  closesAt    DateTime
  /// "open" | "closed" — manual close OR closesAt passed.
  status      String   @default("open")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy    User                   @relation("HqpWindowCreator", fields: [createdById], references: [id])
  applications HqpMemberApplication[]

  @@index([year])
  @@index([status, opensAt, closesAt])
}

model HqpMemberApplication {
  id           String    @id @default(cuid())
  userId       String
  windowId     String
  /// Form body — see lib/hqp/types.ts for shape:
  ///   motivation, programsParticipating[], perspective,
  ///   areasOfInterest[], timeCommitmentAcknowledged,
  ///   confidentialityAck, nameImageConsent, additionalNotes
  formData     Json      @default("{}")
  /// "draft" | "submitted" | "approved" | "rejected"
  status       String    @default("draft")
  submittedAt  DateTime?
  decidedAt    DateTime?
  decidedById  String?
  reviewerNote String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user      User                 @relation("HqpApplicant", fields: [userId], references: [id], onDelete: Cascade)
  window    HqpApplicationWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)
  decidedBy User?                @relation("HqpAppDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([userId, windowId])
  @@index([windowId, status])
  @@index([userId])
}

// ─── HQP Feedback Rounds ─────────────────────────────────────────
// Replaces the manual "send out a docx, collect them by filename"
// workflow the BHN team currently runs. An admin creates a round
// with N topics; every active HQP committee member sees the same
// set and responds inline. Responses aggregate per-topic for the
// program team.

model HqpFeedbackRound {
  id          String   @id @default(cuid())
  title       String
  description String?
  /// JSON array of topic objects:
  ///   [{ id: string, label: string, question: string, order: number }]
  /// Topics are admin-defined per round so the form can adapt
  /// to whatever the program team wants feedback on this cycle.
  topics      Json     @default("[]")
  opensAt     DateTime
  closesAt    DateTime
  /// "open" | "closed". Manual close OR closesAt passed.
  status      String   @default("open")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User                  @relation("HqpRoundCreator", fields: [createdById], references: [id])
  responses HqpFeedbackResponse[]

  @@index([status, opensAt, closesAt])
}

model HqpFeedbackResponse {
  id          String    @id @default(cuid())
  roundId     String
  userId      String
  /// JSON map { topicId: answerText }. Topics that aren't in the
  /// answers object are treated as unanswered.
  answers     Json      @default("{}")
  /// "draft" | "submitted"
  status      String    @default("draft")
  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  round HqpFeedbackRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user  User             @relation("HqpResponder", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roundId, userId])
  @@index([roundId, status])
  @@index([userId])
}

// ─── HQP Meetings + Action Items + COI ──────────────────────────
// Monthly virtual meetings, per Charter §6. Each meeting carries
// an agenda (markdown), attendance per member, notes (markdown,
// posted after the meeting), and any action items captured.

model HqpMeeting {
  id          String   @id @default(cuid())
  title       String
  scheduledAt DateTime
  durationMin Int      @default(60)
  /// Markdown — pre-meeting agenda.
  agenda      String?
  /// Markdown — post-meeting notes / summary.
  notes       String?
  /// "scheduled" | "held" | "cancelled"
  status      String   @default("scheduled")
  /// Optional virtual-meeting link.
  meetingUrl  String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   User                   @relation("HqpMeetingCreator", fields: [createdById], references: [id])
  attendance  HqpMeetingAttendance[]
  actionItems HqpActionItem[]

  @@index([scheduledAt])
  @@index([status, scheduledAt])
}

model HqpMeetingAttendance {
  id        String   @id @default(cuid())
  meetingId String
  userId    String
  /// "invited" | "attending" | "attended" | "declined" | "absent"
  status    String   @default("invited")
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meeting HqpMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User       @relation("HqpAttendee", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([meetingId, status])
}

model HqpActionItem {
  id             String    @id @default(cuid())
  meetingId      String?
  title          String
  description    String?
  assignedToId   String?
  dueOn          DateTime?
  /// "open" | "in_progress" | "done" | "cancelled"
  status         String    @default("open")
  createdById    String
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  meeting    HqpMeeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  assignedTo User?       @relation("HqpActionAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy  User        @relation("HqpActionCreator", fields: [createdById], references: [id])

  @@index([status, dueOn])
  @@index([assignedToId, status])
  @@index([meetingId])
}

model HqpCoiDisclosure {
  id          String    @id @default(cuid())
  userId      String
  /// Free-text scope — what topic / program / company the COI
  /// applies to. Searched by admins when filtering recusals.
  scope       String
  description String
  /// True while the COI is current. Members flip this off when
  /// the underlying relationship ends.
  active      Boolean   @default(true)
  declaredAt  DateTime  @default(now())
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation("HqpCoiDeclarer", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
  @@index([active, declaredAt])
}

/// CMS-authored standalone pages — for non-admin colleagues to
/// publish announcements, policy pages, and lightweight content
/// without a deploy.
///
///   • slug      — URL slug, unique; used at /p/{slug}.
///   • title     — top-of-page headline.
///   • body      — markdown body. Rendered by react-markdown +
///                 remark-gfm, same renderer the changelog uses.
///   • excerpt   — optional short preview (~140 chars) shown on
///                 listing surfaces.
///   • status    — "draft" hides from the public route; "published"
///                 surfaces it. Allows in-progress drafts that
///                 reviewers can preview at /p/{slug}?preview=1.
///   • audience  — who can see it:
///                   "public"    — anyone (signed-in or not)
///                   "learners"  — trainees + evaluating
///                   "staff"     — instructor+
///                   "admins"    — admin+
model Page {
  id       String  @id @default(cuid())
  slug     String  @unique
  title    String
  body     String
  excerpt  String?
  status   String  @default("draft")
  audience String  @default("public")

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdById String
  updatedById String?

  createdBy User  @relation("PageCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("PageUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([status, audience])
  @@index([updatedAt])
}

/// Role-play simulator: generated template cached by JD content hash so
/// the same posting only needs one AI generation across the whole cohort.
/// payload is a JSON blob shaped per src/lib/simulator/types.ts —
/// roster (team + cross-functional partners), 12 weeks of scenarios with
/// choices and stat effects, and review thresholds.
model Simulation {
  id            String   @id @default(cuid())
  /// sha256 of the normalised JD text + prompt version. Unique so we
  /// dedupe identical postings (RBC posts the same role to LinkedIn,
  /// Indeed, and their own site; one Simulation row covers all three).
  sourceHash    String   @unique
  /// Source URL the trainee pasted, if any. Display only — many will
  /// be expired or auth-walled by the time someone replays.
  sourceUrl     String?
  /// First ~800 chars of the cleaned JD, for the "based on this posting"
  /// preview at the top of an attempt.
  jdSnippet     String
  /// AI-extracted ("Director, Design"). Fallback to "Director" if blank.
  jobTitle      String
  /// AI-extracted ("RBC", "Wealthsimple"). Nullable when the AI can't tell.
  companyName   String?
  /// AI-extracted ("Toronto", "Montreal, hybrid"). Nullable.
  location      String?
  /// JSON blob — see src/lib/simulator/types.ts for SimulationPayload.
  payload       Json
  /// Provider + model used to generate, for analytics and re-generation.
  /// e.g. "cloudflare:llama-3.1-8b-instruct" or "gemini:gemini-2.0-flash".
  modelUsed     String
  /// Total wall-clock time the generation took (for monitoring).
  generationMs  Int
  /// Bumped when we change the prompt or schema in ways that invalidate
  /// existing payloads. Older Simulation rows with a lower version stay
  /// playable but won't be re-used for new attempts.
  promptVersion String   @default("v1")
  createdById   String?
  createdAt     DateTime @default(now())

  createdBy   User?                  @relation("SimulationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  attempts    SimulationAttempt[]
  requests    SimulationRequest[]
  shareTokens SimulationShareToken[]
  comments    SimulationComment[]

  @@index([sourceUrl])
  @@index([createdAt])
}

/// User-submitted request for an admin to generate a simulation.
///
/// Replaces the synchronous self-serve generation path that used to
/// live on /api/simulator/start. Now the user posts a request, an
/// admin runs the AI (or hand-authors a payload) on their schedule,
/// and the requester is notified when the sim is ready. Decouples
/// the user-facing UX from AI quota / cache outages.
///
/// status state machine:
///   pending   ──generate──► generating ──ok──► ready
///                                       ──err─► failed
///             ──hand-author─► ready
///             ──reject──────► rejected
///   failed    ──retry──► generating
///             ──hand-author─► ready
///             ──reject──────► rejected
///   rejected  ──reopen─► pending
model SimulationRequest {
  id            String      @id @default(cuid())
  /// Trainee who submitted the request.
  userId        String
  user          User        @relation("SimulationRequestRequester", fields: [userId], references: [id], onDelete: Cascade)
  /// Source URL the trainee pasted, if any. Display only.
  sourceUrl     String?
  /// Cleaned JD body (after extractJobDescriptionFromText whitespace
  /// normalisation). What the admin reads + what the AI prompt uses.
  jdBody        String
  /// sha256("v1::" + jdBody) — matches Simulation.sourceHash so we can
  /// dedup against the existing payload cache when an admin chooses
  /// "Link existing simulation".
  sourceHash    String
  /// pending | generating | ready | rejected | failed
  status        String      @default("pending")
  /// FK to the produced Simulation once an admin attaches one.
  simulationId  String?
  simulation    Simulation? @relation(fields: [simulationId], references: [id], onDelete: SetNull)
  /// Admin's reason on rejection / the AI error on failure.
  adminNotes    String?
  /// Admin who last acted on this request.
  processedById String?
  processedBy   User?       @relation("SimulationRequestProcessor", fields: [processedById], references: [id], onDelete: SetNull)
  processedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  /// Folders that point at this request. Usually 0 or 1 — modelled
  /// as a list so multiple folders can share a request if a trainee
  /// duplicates a folder in the future.
  jobFolders    JobFolder[] @relation("JobFolderSimRequest")

  @@index([status, createdAt])
  @@index([userId, status])
  @@index([sourceHash])
}

/// One per trainee per simulation. State is checkpointed after every
/// choice so a trainee can close the tab and resume later.
model SimulationAttempt {
  id            String    @id @default(cuid())
  simulationId  String
  userId        String
  /// 1..12. When week > 12 OR finished, the attempt is done.
  week          Int       @default(1)
  /// Index into the scenarios array for the current week.
  scenarioIndex Int       @default(0)
  /// JSON: { morale, vpTrust, velocity, crossFunc, capacity } as 0–100.
  /// Stat keys match Simulation.payload.stats[].key so the same shape
  /// works regardless of role.
  stats         Json
  /// JSON array of decision log entries (week, scenarioId, choiceLabel,
  /// outcome, effects, tag). Used for the end-of-quarter highlights.
  log           Json
  finished      Boolean   @default(false)
  finalScore    Int?
  finalTier     String?
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  updatedAt     DateTime  @updatedAt

  simulation Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([simulationId])
}

/// Tokenised public, no-login share link for a Simulation.
///
/// /share/sim/[token] serves a fully PLAYABLE view — an anonymous
/// visitor runs the same sim entirely client-side (the play engine is
/// pure and the whole payload ships to the browser), with progress
/// checkpointed to localStorage rather than a server attempt. Any
/// signed-in user (any role) can mint a link; possession of the URL is
/// the only auth, mirroring JobFolderShareToken.
model SimulationShareToken {
  id           String     @id @default(cuid())
  simulationId String
  simulation   Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  /// URL-safe random token (~22 chars). Unique + indexed for fast
  /// lookups on the public share page.
  token        String     @unique
  /// Optional label the sharer gave the link ("For the ASCO mentor").
  label        String?
  /// Who minted the link. Plain column (no FK) — display/audit only;
  /// the link must outlive the sharer's account.
  createdById  String?
  /// null = no expiry; otherwise the share page 410s after this time.
  expiresAt    DateTime?
  createdAt    DateTime   @default(now())

  @@index([simulationId, createdAt])
}

/// Public comment on a Simulation, postable by ANYONE via a share link
/// — including logged-out visitors. The commenter's display name is
/// captured as free text (no account required). authorUserId is set
/// only when the poster happens to be signed in. Threads attach to the
/// Simulation so every share link of the same sim shares one discussion.
model SimulationComment {
  id           String     @id @default(cuid())
  simulationId String
  simulation   Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  /// Free-text display name captured from the (possibly anonymous)
  /// commenter. Required — every comment renders with a name.
  authorName   String
  /// Set when a logged-in user posts; null for anonymous visitors.
  /// Plain column (no FK) so anonymous comments survive independently.
  authorUserId String?
  body         String
  /// Coarse abuse signal (first x-forwarded-for hop). Never displayed,
  /// used only for per-IP rate limiting + moderation forensics.
  ip           String?
  /// Soft-moderation: hidden rows stay in the table but don't render
  /// on the public page. Toggled by admins.
  hidden       Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@index([simulationId, createdAt])
  @@index([ip, createdAt])
}

/// Structured resume — a JSON tree of sections → items → bullets,
/// each with a stable id so comments can anchor at any granularity.
/// Lives alongside `User.resumeUrl` (the uploaded blob): the uploaded
/// PDF stays the archival source, and we AI-parse it on first
/// /profile/resume visit to populate `content`. The trainee always
/// owns edits; mentors / instructors / admins / employers can only
/// COMMENT — never edit directly.
///
/// `content` shape (TS type lives in `src/lib/resume/types.ts`):
///   { sections: [
///       { id, kind, position, title?,
///         items: [
///           { id, position, title?, subtitle?, dateRange?,
///             bullets: [{ id, position, body, aiSuggested? }]
///           }
///         ]
///       }
///     ]
///   }
/// A trainee's structured resume. Users can own multiple — typically
/// a "Main resume" they maintain over time + tailored copies created
/// for specific postings. The unique constraint on userId was lifted
/// in the 20260520 migration to make this possible; the lookup of
/// "the user's resume" is now "most-recently-edited non-archived"
/// unless an explicit resumeId is provided.
model Resume {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation("UserResume", fields: [userId], references: [id], onDelete: Cascade)
  /// Human-readable name shown in the picker + on the index page.
  /// Defaults to "Main resume" on first create; tailor-save-as uses
  /// the posting title.
  name                String    @default("Main resume")
  /// Soft-archive flag. Archived resumes are hidden from the picker
  /// and the default-load logic but still exist for restore. We
  /// never hard-delete from the API; old work stays recoverable.
  isArchived          Boolean   @default(false)
  /// When this resume was created by tailoring (or duplicating) from
  /// another one, derivedFromId attributes the source so the index
  /// page can show "Tailored from Main resume". SET NULL on delete
  /// so deleting the source doesn't cascade-kill the derived copies.
  derivedFromId       String?
  derivedFrom         Resume?   @relation("DerivedResumes", fields: [derivedFromId], references: [id], onDelete: SetNull)
  derivedResumes      Resume[]  @relation("DerivedResumes")
  /// Optional posting id this resume was tailored for. Surfaces in
  /// the index as a chip; lets the future "open my tailored copy
  /// for posting X" lookups be a one-shot query.
  derivedForPostingId String?
  sourceFileUrl       String? // upload URL the structure was parsed from
  parsedAt            DateTime? // when AI parsed sourceFileUrl into content
  lastEditedAt        DateTime  @default(now())
  version             Int       @default(1)
  content             Json // the section/item/bullet tree
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  comments   ResumeComment[]
  revisions  ResumeRevision[]
  /// Folders that picked this resume as their tailored copy. SET NULL
  /// on delete means the folder survives if the resume is gone.
  jobFolders JobFolder[]      @relation("JobFolderResume")

  @@index([userId, isArchived])
  @@index([derivedFromId])
}

/// Team-private comments on a structured resume. Mirrors the
/// ApplicationComment pattern on EventFormSubmission. Anchor fields
/// are mutually exclusive in practice — UI uses the most-specific
/// anchor (bullet > item > section > resume-wide).
model ResumeComment {
  id              String   @id @default(cuid())
  resumeId        String
  resume          Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  authorId        String
  author          User     @relation("ResumeCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorRole      String // mentor | instructor | admin | employer | self (snapshot at write time)
  /// Anchor into the JSON tree. NULL on all three → comment on the
  /// whole resume.
  anchorBulletId  String?
  anchorItemId    String?
  anchorSectionId String?
  body            String
  /// open    — needs the trainee's attention
  /// resolved — the trainee acknowledged it (manual close)
  /// applied — the trainee accepted the suggestion into the resume
  status          String   @default("open")
  createdAt       DateTime @default(now())

  @@index([resumeId, createdAt])
  @@index([authorId])
}

/// Snapshot of the entire resume tree at a save point. Cheap row
/// per save; lets mentors see the version history and lets the
/// trainee undo to any prior state. `triggeredBy` distinguishes
/// trainee edits from AI tailoring runs.
model ResumeRevision {
  id          String   @id @default(cuid())
  resumeId    String
  resume      Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  version     Int
  content     Json
  triggeredBy String // user | ai_parse | ai_suggest | ai_tailor
  note        String?
  createdAt   DateTime @default(now())

  @@index([resumeId, version])
}

/// Master resume — a user's central LIBRARY of every accomplishment
/// they've ever written. Singleton per user.
///
/// Mental model: master = wardrobe; tailored Resume rows = outfits.
/// Bullets are first-class (see MasterBullet) — the master holds
/// them as a library, tailored resumes pull from it.
///
/// See docs/plans/master-resume.md for the full design + the five
/// principles that drove the data model.
model MasterResume {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation("UserMasterResume", fields: [userId], references: [id], onDelete: Cascade)

  /// Shared header data — name, email, phone, location, summary.
  /// One source of truth across every tailored resume the user owns.
  /// Same shape as ResumeContent.header in src/lib/resume/types.ts.
  header Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bullets   MasterBullet[]
  snapshots MasterSnapshot[]
}

/// A single accomplishment / line item in the master library.
/// Lives independently of any Resume row. Tailored resumes can
/// reference these bullets, edit them locally, or promote edits
/// back here.
model MasterBullet {
  id       String       @id @default(cuid())
  masterId String
  master   MasterResume @relation(fields: [masterId], references: [id], onDelete: Cascade)

  /// Which section kind this bullet belongs to. Mirrors
  /// ResumeSectionKind in src/lib/resume/types.ts.
  sectionKind String

  /// For experience-type bullets, the anchor identifies the job
  /// (e.g. "Manufacturing Process Intern · STEMCELL Technologies").
  /// Skills bullets have no anchor. Stored loose (free text) —
  /// anchors are a UX affordance for grouping, not a FK.
  anchorTitle     String?
  anchorSubtitle  String?
  anchorDateRange String?

  /// Structured job/role details for experience-type groups. Edited at
  /// the group level (all bullets sharing a job carry the same values);
  /// anchorSubtitle + anchorDateRange are derived from these for display
  /// and stay populated for back-compat. anchorStart/anchorEnd are free
  /// "Mon YYYY" strings; anchorCurrent marks "currently here".
  anchorCompany  String?
  anchorLocation String?
  anchorStart    String?
  anchorEnd      String?
  anchorCurrent  Boolean @default(false)

  /// Current bullet text.
  body String

  /// ── Structured career-fact fields (AI Job-Tailoring grounding) ──
  /// Decompose the bullet into auditable parts so tailoring can ground
  /// every claim and NEVER invent a metric (rule 1). All optional —
  /// legacy bullets keep working with just `body`.
  /// The quantified result, verbatim (e.g. "$2.3M ARR", "14 flasks").
  metric            String?
  /// HOW the result was achieved (e.g. "via a 6-week A/B test").
  mechanism         String?
  /// The canonical, approved wording to preserve when tailoring — the
  /// drafter may reframe around it but must not contradict it.
  canonicalPhrasing String?
  /// 0..1 confidence the fact is accurate / verified. Low-confidence
  /// facts are surfaced for review and never used to fill a hard gap.
  confidence        Float?
  /// Free-text provenance (where this fact comes from / how verified).
  sourceNote        String?

  /// User- or AI-applied tags. Used by the AI picker to short-list
  /// relevant bullets before LLM re-ranking.
  tags String[]

  /// Source attribution. If this bullet was first added by promoting
  /// it from a tailored Resume, this records that Resume's id.
  /// Helps the user trace lineage.
  sourceResumeId String?

  /// Pin order within the section / anchor group.
  position Int @default(0)

  /// Soft archive — bullets the user doesn't currently want
  /// surfaced in AI tailoring or library views, but might revive.
  isArchived Boolean @default(false)

  /// Embedding for AI retrieval (Cloudflare bge-small-en-v1.5, 384d).
  /// Managed via raw SQL (pgvector) — same pattern as Skill /
  /// PostingSkill embeddings elsewhere in the schema.
  embedding     Unsupported("vector(384)")?
  /// The text that produced the current embedding. If `body` !=
  /// `embeddingText`, the embedding is stale and gets re-computed
  /// on the next AI pick.
  embeddingText String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  revisions MasterBulletRevision[]

  @@index([masterId, sectionKind, isArchived])
  @@index([masterId, anchorTitle])
}

/// Per-bullet revision history. New revision row written on every
/// substantive body change (with the same 5-minute coalesce as
/// ResumeRevision).
model MasterBulletRevision {
  id       String       @id @default(cuid())
  bulletId String
  bullet   MasterBullet @relation(fields: [bulletId], references: [id], onDelete: Cascade)

  body String
  tags String[]

  /// Why was this revision made?
  /// "user_edit" | "ai_rewrite" | "promoted_from_resume" | "imported_from_pdf"
  source String

  createdAt DateTime @default(now())

  @@index([bulletId, createdAt])
}

/// Locked, named, downloadable snapshot of the master at a moment
/// in time. Like a git tag.
model MasterSnapshot {
  id       String       @id @default(cuid())
  masterId String
  master   MasterResume @relation(fields: [masterId], references: [id], onDelete: Cascade)

  /// Auto-incremented per master. v1, v2, v3...
  versionNumber Int
  /// User-supplied label. "Fall 2026 polish", "Pre-graduation", etc.
  name          String

  /// Full snapshot of the master's bullets + header at this moment,
  /// stored as ResumeContent JSON so the snapshot can be rendered
  /// in the existing /profile/resume/preview PDF flow later.
  content Json

  /// Pre-generated PDF for download. Optional — the download
  /// endpoint regenerates if absent.
  pdfUrl String?

  createdAt DateTime @default(now())

  @@unique([masterId, versionNumber])
  @@index([masterId, createdAt])
}

/// ════════════════════════════════════════════════════════════════
/// AI Job-Tailoring module (see docs spec). Tailors an application to
/// an EXTERNAL job, grounded only in the master library (CareerFacts
/// on MasterBullet), with a QA gate and a correction-driven rule loop.
/// ════════════════════════════════════════════════════════════════

/// An external job the user is tailoring an application to. Distinct
/// from InternshipPosting (BHN's own employer postings) — this is any
/// job found anywhere on the web, ingested by URL or pasted JD.
model TailoringJob {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("UserTailoringJobs", fields: [userId], references: [id], onDelete: Cascade)

  /// Source URL the JD came from (drives ATS detection). Optional —
  /// a JD can be pasted directly.
  url String?
  /// Detected applicant-tracking system from the URL host:
  /// workday | greenhouse | lever | ashby | successfactors | unknown.
  ats String?

  title    String
  company  String
  location String?
  comp     String?

  mustHaves        String[]
  niceToHaves      String[]
  responsibilities String[]
  /// The full raw JD text, kept for re-analysis + audit.
  rawJD            String   @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs TailoringRun[]

  @@index([userId, createdAt])
}

/// One tailoring attempt for a job: the generated artifacts, the QA
/// report, and the Strong/Partial/Gap fit-check. NEVER auto-submitted —
/// the human reviews and submits.
model TailoringRun {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("UserTailoringRuns", fields: [userId], references: [id], onDelete: Cascade)

  jobId String
  job   TailoringJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  /// Optional FK to a structured Resume produced for this run.
  resumeId String?

  /// Generated documents + the chosen ATS output variant.
  resumeDoc String?
  coverDoc  String?
  format    String?

  /// Structured fit-check scorecard + QA gate report (schema-validated).
  fitCheck Json?
  qaReport Json?

  /// pending | drafting | verified | blocked | done
  status String @default("pending")

  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  corrections TailoringCorrection[]

  @@index([userId, createdAt])
  @@index([jobId])
}

/// Learning loop: a codified correction/preference applied on all
/// future runs in scope. A correction should only be needed once.
model TailoringRule {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation("UserTailoringRules", fields: [userId], references: [id], onDelete: Cascade)

  /// global | roleType | ats | company
  scope    String @default("global")
  /// What activates this rule (a roleType, an ats host, a company, or "*").
  trigger  String @default("*")
  ruleText String

  isActive   Boolean  @default(true)
  codifiedAt DateTime @default(now())

  corrections TailoringCorrection[]

  @@index([userId, scope, isActive])
}

/// A single correction the user made to a run's output. Feeds the rule
/// engine: a repeated correction is promoted to a TailoringRule.
model TailoringCorrection {
  id    String       @id @default(cuid())
  runId String
  run   TailoringRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  before String @default("")
  after  String @default("")

  ruleId String?
  rule   TailoringRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([runId])
}

/// A per-application "job folder" — a self-organising bundle of
/// everything you produce for one role. Holds:
///   • A snippet (or paste) of the job description
///   • An optional link to an InternshipPosting on this platform
///   • An optional link to a Resume tailored for the role
///   • Cover letter text (with AI-generate/tailor button on the UI)
///   • Interview prep notes (with AI-generate from JD + resume)
///   • Status — drafting / submitted / interviewing / offer / closed
///
/// Self-only — never visible to other users. Soft-archive flag for
/// "I'm not actively pursuing this anymore but might come back."
model JobFolder {
  id                  String             @id @default(cuid())
  userId              String
  user                User               @relation("UserJobFolders", fields: [userId], references: [id], onDelete: Cascade)
  /// Short title — usually "Company · Role". Free text; can be
  /// renamed any time.
  title               String
  /// Free-text job description snippet. Either pasted from the
  /// posting URL or summarised by the user. Markdown allowed.
  jdSnippet           String             @default("")
  /// Optional posting on this platform — when set the folder
  /// surfaces a chip linking back to the live posting page.
  postingId           String?
  /// Optional resume this folder was tailored against. Set NULL
  /// on delete so deleting a resume doesn't cascade-kill the
  /// folder (the user might still want the JD + cover letter).
  resumeId            String?
  resume              Resume?            @relation("JobFolderResume", fields: [resumeId], references: [id], onDelete: SetNull)
  /// Long-form cover letter (markdown). Auto-saved on the UI.
  coverLetter         String             @default("")
  /// Interview prep guide (markdown). Auto-saved on the UI.
  interviewPrep       String             @default("")
  /// Free-form scratch notes — recruiter names, salary band, things
  /// said in coffee chats, things to remember before the interview.
  /// Markdown, auto-saved like the other doc fields.
  notes               String             @default("")
  /// ── Application tracker fields ─────────────────────────────────
  /// Optional URL of the live posting / ATS application link the
  /// trainee submitted to. Display only.
  applicationUrl      String?
  /// When the trainee actually clicked Submit. Drives "applied N days
  /// ago" on the dashboard.
  appliedAt           DateTime?
  /// When the posting closes. Drives "deadline in N days" banners.
  deadline            DateTime?
  /// Name of the recruiter or hiring manager the trainee is in
  /// touch with — for the "who do I follow up with" question.
  recruiterName       String?
  recruiterEmail      String?
  /// Internal referral, if any — surfaces on the folder card and
  /// in the cover-letter generator's prompt context.
  referredBy          String?
  /// Optional linked SimulationRequest. When set, the folder has
  /// a role-play sim attached or queued — the linked request
  /// carries its own pending|generating|ready|failed|rejected
  /// status. Once status=ready, request.simulationId points at
  /// the played Simulation and we resolve the user's most recent
  /// attempt against it for the "Play" button.
  simulationRequestId String?
  simulationRequest   SimulationRequest? @relation("JobFolderSimRequest", fields: [simulationRequestId], references: [id], onDelete: SetNull)
  /// drafting | submitted | interviewing | offer | rejected | closed
  status              String             @default("drafting")
  isArchived          Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  /// Auto-logged + manual lifecycle events. Newest-first on the
  /// Timeline tab.
  events      JobFolderEvent[]
  /// Tokenised read-only share links for sending a mentor to view
  /// this folder without an account.
  shareTokens JobFolderShareToken[]

  @@index([userId, isArchived])
  @@index([resumeId])
  @@index([simulationRequestId])
  @@index([userId, deadline])
}

/// Read-only share token for a JobFolder. The trainee mints one
/// from the Share menu; the URL /share/folder/[token] serves a
/// clean view of the folder's documents (JD, resume, cover letter,
/// interview prep, notes) with no platform chrome and no login
/// requirement. Tokens expire on `expiresAt`; setting that to null
/// = "until revoked." Revoke deletes the row.
model JobFolderShareToken {
  id        String    @id @default(cuid())
  folderId  String
  folder    JobFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  /// URL-safe random token, ~22 chars. Indexed unique for fast
  /// lookups on the share page.
  token     String    @unique
  /// Optional label the trainee gave the link ("For Diane", "For
  /// the mentor at ASCO"). Surfaced in the manage-links UI.
  label     String?
  /// null = no expiry, otherwise the share page returns 410 after
  /// this timestamp.
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([folderId, createdAt])
}

/// Lifecycle event on a JobFolder. Auto-logged from the PATCH
/// endpoint (status changes), the sim-request endpoint (sim
/// requested/ready/rejected), the duplicate endpoint, and the
/// folder-create flow. Also accepts manual entries from the
/// Timeline tab so the trainee can record offline events (phone
/// call, coffee chat, etc.).
model JobFolderEvent {
  id        String    @id @default(cuid())
  folderId  String
  folder    JobFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  /// One of: "created" | "status_changed" | "applied" | "sim_requested" |
  /// "sim_ready" | "sim_rejected" | "sim_failed" | "duplicated" |
  /// "interview_scheduled" | "manual" | "deadline_set" | "applied_at_set"
  kind      String
  /// Free-text description shown in the timeline row. Kept readable
  /// without needing the payload — payload is optional context for
  /// future analytics / render variants.
  body      String
  payload   Json?
  createdAt DateTime  @default(now())

  @@index([folderId, createdAt])
}

/// Canadian biomanufacturing facility (company / plant / institute).
///
/// Seeded from a curated xlsx (see `lib/facilities/seed-data.ts`).
/// The `/experience/facilities` map page reads from this table. The
/// optional rescan endpoint refetches `url` via Jina Reader + asks
/// the AI to produce an updated `description` / `specialization`;
/// `lastScannedAt` / `scanError` capture that state.
model Facility {
  id             String    @id @default(cuid())
  name           String
  url            String?
  /// "Being built" | "Already built" | null
  status         String?
  province       String?
  city           String?
  address        String?
  specialization String?
  /// Headcount / sq-ft hint, free-text from the source data.
  scale          String?
  notes          String?
  /// Longer-form description added by the rescan job. Null on first
  /// import; the map UI falls back to `specialization`.
  description    String?
  lat            Float
  lng            Float
  /// When the rescan tool last ran successfully on this row.
  lastScannedAt  DateTime?
  /// Error string from the last rescan attempt, if any.
  scanError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([name])
  @@index([province])
  @@index([city])
}

/// Public "graduate showcase" submission — anyone (no login) can
/// submit their name + LinkedIn handle + a headshot via
/// /showcase/<programSlug>. Admins triage from /admin/showcase:
/// download the photo + info pair, mark when last downloaded, or
/// delete the row + drop the R2 object.
///
/// The first showcase we're shipping is "regulatory-affairs"; the
/// `programSlug` field is here so additional programs (QA, GMP,
/// CGT, …) can plug in later via /showcase/<other-slug> without a
/// schema migration.
model ShowcaseSubmission {
  id               String    @id @default(cuid())
  programSlug      String    @default("regulatory-affairs")
  name             String
  /// As the user typed it — may be "linkedin.com/in/foo" or just
  /// "foo". The form normalises to a canonical URL stored in
  /// `linkedinUrl`; the original raw input stays here for audit.
  linkedinHandle   String
  linkedinUrl      String?
  /// Public R2 URL — `R2_PUBLIC_URL/showcase/<slug>/<id>.<ext>`.
  photoUrl         String
  /// R2 object key (without bucket / base URL) so the delete
  /// endpoint can drop the file.
  photoKey         String
  /// IP + UA captured for basic abuse triage on the admin
  /// dashboard. Not displayed to the public.
  submittedFromIp  String?
  submittedFromUa  String?
  createdAt        DateTime  @default(now())
  /// Updated every time an admin clicks "Download". Lets staff
  /// track which rows have been processed vs are still to do.
  lastDownloadedAt DateTime?
  /// Name / email of the admin who last downloaded.
  lastDownloadedBy String?
  adminNote        String?
  /// Editable membership tags shown as pills on the admin card: an
  /// array of { kind: "workshop" | "pathway" | "cohort", label }.
  /// Admin-managed and free-form — independent of `programSlug`
  /// (which records the single group this person submitted to).
  pills            Json      @default("[]")
  /// Set when the submission came through a GATED (attendance-gated)
  /// cohort: the logged-in trainee's User id, stamped server-side from
  /// the session. Null for public/anonymous submissions.
  userId           String?

  /// Structured group/cohort memberships — the single source of truth
  /// for "which showcases this person belongs to". One row is `isHome`
  /// (mirrors `programSlug`, the public URL + R2 path anchor); the rest
  /// are extra cohorts an admin added without re-uploading a photo.
  memberships ShowcaseMembership[]

  @@index([programSlug, createdAt])
  @@index([programSlug, userId])
}

/// A showcase "group" — a named, slug-addressed graduate showcase. Each
/// group gets its own public, no-login submission link at /showcase/<slug>
/// (rendered by src/app/showcase/[slug]/page.tsx). Admins create + manage
/// these from /admin/showcase. Submissions link to a group loosely by
/// ShowcaseSubmission.programSlug == ShowcaseGroup.slug (matches the
/// existing slug-keyed design; no FK so legacy rows are unaffected).
model ShowcaseGroup {
  id          String   @id @default(cuid())
  /// URL slug — the public link is /showcase/<slug>. Unique.
  slug        String   @unique
  /// Showcase title shown on the public page (e.g. "Graduate Showcase").
  name        String
  /// Small category/eyebrow above the title (e.g. "Learning Pathway · Regulatory Affairs").
  eyebrow     String?
  /// Intro blurb under the title on the public submission page.
  intro       String?
  /// false = the public page hides the form and shows "submissions closed",
  /// and the submit API rejects new entries for this slug.
  active      Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// When set, this group is a COHORT of a pathway: its public branding
  /// comes from the pathway, and `name` holds the cohort label (e.g.
  /// "Cohort 2"). Null = a standalone showcase (e.g. the legacy
  /// Regulatory Affairs program).
  pathwayId        String?
  pathway          ShowcasePathway? @relation(fields: [pathwayId], references: [id], onDelete: SetNull)
  /// 1-based cohort number within the pathway (auto-incremented on add).
  cohortNumber     Int?
  /// When set, this showcase cohort is BOUND to a real learning-pathway
  /// cohort (PathwayCohort) — the registration + attendance source of
  /// truth. Lets the showcase gate on who actually registered + attended.
  linkedCohortId   String?
  linkedCohort     PathwayCohort?   @relation(fields: [linkedCohortId], references: [id], onDelete: SetNull)
  /// When true (and linkedCohortId set) the public page requires login
  /// and only approved-enrolled + attended trainees can submit. False =
  /// open/public (the interim default; nothing breaks for unbound groups).
  gateOnAttendance Boolean          @default(false)

  /// Structured membership rows for people in this group/cohort (the
  /// single source of truth; supersedes the loose programSlug match).
  memberships ShowcaseMembership[]

  @@index([createdAt])
  @@index([pathwayId])
  @@index([linkedCohortId])
}

/// Join between a showcase person (ShowcaseSubmission) and a group/cohort
/// (ShowcaseGroup) — the single source of truth for cohort/pathway
/// membership, replacing the loose `programSlug` string match and the
/// free-text pills. One `isHome` row mirrors the submission's programSlug
/// (its public page + R2 path); additional rows let one person appear in
/// multiple cohorts without re-uploading a photo. Both FKs cascade, so
/// deleting a group cleanly removes its memberships (no dangling roster).
model ShowcaseMembership {
  id           String   @id @default(cuid())
  submissionId String
  groupId      String
  /// True for the one membership that mirrors the submission's home
  /// `programSlug` group (public URL + R2 path live under it).
  isHome       Boolean  @default(false)
  createdById  String?
  createdAt    DateTime @default(now())

  submission ShowcaseSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  group      ShowcaseGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([submissionId, groupId])
  @@index([groupId])
  @@index([submissionId])
}

/// A learning pathway — the program a showcase belongs to, created ONCE
/// and named WITHOUT a cohort number ("Medical Affairs Learning Pathway").
/// Its cohorts are ShowcaseGroup rows with pathwayId set; each cohort has
/// its own public /showcase/<slug> link but shares the pathway's branding
/// (eyebrow + intro). This is the anchor a future approved-registration
/// list attaches to — one registration per pathway, reused across cohorts.
model ShowcasePathway {
  id              String          @id @default(cuid())
  slug            String          @unique
  name            String
  eyebrow         String?
  intro           String?
  createdById     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  cohorts         ShowcaseGroup[]
  /// When set, bound to a real learning Pathway — the registration anchor
  /// whose approved enrollments + attendance govern the showcase.
  linkedPathwayId String?
  linkedPathway   Pathway?        @relation(fields: [linkedPathwayId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([linkedPathwayId])
}

// ───────────────────────────────────────────────────────────────
// Reporting suite — HR/Talent reports (/employer/reports).
// Targets/OKRs, cost tracking, voluntary DEI self-ID, and a typed
// stage-transition history (so cohort funnels + cycle-time are fast
// and seedable, vs. parsing the untyped AuditLog).
// ───────────────────────────────────────────────────────────────

/// A settable hiring goal (OKR). Reports resolve actual-vs-target and
/// render a RAG status. Company-wide when postingId is null; otherwise
/// scoped to one requisition (a posting-scoped target overrides the
/// company-wide one for the same metricKey).
model HiringTarget {
  id          String   @id @default(cuid())
  companyId   String
  postingId   String?
  /// Stable key the metrics lib looks up. e.g. "time_to_fill_days" |
  /// "offer_accept_rate" | "cost_per_hire" | "apply_to_hire_rate" |
  /// "hires" | "applications" | "stage_sla_<stage>_days".
  metricKey   String
  /// Target in the metric's native unit (days, %, dollars, count).
  /// Percentages stored 0–100 to match the metrics lib output.
  targetValue Decimal  @db.Decimal(12, 2)
  /// "gte" (higher is better) | "lte" (lower is better).
  comparator  String   @default("gte")
  /// Within-band fraction for "at risk" (0.1 = within 10% of goal).
  atRiskBand  Decimal? @db.Decimal(4, 3)
  /// "quarter" | "year" | "month" | "rolling_90".
  period      String   @default("quarter")
  ownerId     String?
  note        String?
  isDemoSeed  Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  posting   InternshipPosting? @relation(fields: [postingId], references: [id], onDelete: Cascade)
  owner     User?              @relation("HiringTargetOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy User?              @relation("HiringTargetAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([companyId, postingId, metricKey, period])
  @@index([companyId, metricKey])
}

/// A recruiting cost line — drives cost-per-hire. Company-wide overhead
/// when postingId is null; otherwise attributed to one requisition.
model RecruitingCost {
  id          String   @id @default(cuid())
  companyId   String
  postingId   String?
  /// "advertising" | "agency_fee" | "referral_bonus" | "tooling" |
  /// "events" | "relocation" | "other".
  costType    String
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("CAD")
  incurredAt  DateTime
  note        String?
  isDemoSeed  Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  posting   InternshipPosting? @relation(fields: [postingId], references: [id], onDelete: Cascade)
  createdBy User?              @relation("RecruitingCostAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId, incurredAt])
  @@index([postingId])
}

/// Voluntary, self-reported demographic self-ID for employment-equity
/// reporting. STRICTLY aggregate-use only — never surfaced at row level
/// in any report; always k-anonymity suppressed (cells < K hidden).
/// A row exists ONLY when the applicant consented. Canada employment-
/// equity context: voluntary self-ID, never inferred. Requires
/// legal/compliance/privacy sign-off before enabling in production.
model ApplicationDemographics {
  id                  String    @id @default(cuid())
  applicationStatusId String    @unique
  /// Hard gate — a row is written ONLY when this is true.
  consent             Boolean   @default(false)
  /// All optional. "prefer not to say" / unanswered = null.
  gender              String?
  raceEthnicity       String?
  disabilityStatus    String?
  veteranStatus       String?
  indigenousStatus    String?
  consentedAt         DateTime?
  /// Version of the consent copy shown when captured.
  consentVersion      String?
  isDemoSeed          Boolean   @default(false)
  createdAt           DateTime  @default(now())

  applicationStatus ApplicationStatus @relation(fields: [applicationStatusId], references: [id], onDelete: Cascade)
}

/// Typed per-candidate stage-transition history. Written by the
/// transition service inside the same transaction as the AuditLog row
/// (AuditLog stays the compliance trail; this is the query-optimised
/// analytics stream). Powers true-cohort funnel conversion + per-stage
/// cycle time. `postingId` is denormalised so company-scoped queries
/// join through the posting without a second hop.
model ApplicationStatusHistory {
  id                  String   @id @default(cuid())
  applicationStatusId String
  postingId           String
  /// null for the synthetic "entered the pipeline" first row.
  fromStage           String?
  toStage             String
  actorId             String?
  isDemoSeed          Boolean  @default(false)
  changedAt           DateTime @default(now())

  applicationStatus ApplicationStatus @relation(fields: [applicationStatusId], references: [id], onDelete: Cascade)
  posting           InternshipPosting @relation(fields: [postingId], references: [id], onDelete: Cascade)
  actor             User?             @relation("StatusHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([postingId, toStage, changedAt])
  @@index([applicationStatusId, changedAt])
}

// ─────────────────────────────────────────────────────────────────────────
// WORKSPACE — internal team tooling, reached from the admin sidebar's
// WORKSPACE section. First surface: Marketing → Video Production. A
// VideoProject holds collaboratively-edited Scripts. Scripts can be opened
// and edited by people who are NOT logged in, via a public ScriptShareToken
// link (they give a name → a ScriptCollaborator row). Every save writes a
// ScriptRevision (live edits + full history + one-click revert).
// ─────────────────────────────────────────────────────────────────────────

/// Workspace → File Sharing. A file shared within the internal team workspace,
/// sibling to Marketing. SKELETON model — extend as the feature grows
/// (versioning, per-user access grants, external share links).
model SharedFile {
  id          String   @id @default(cuid())
  /// Workspace category this file lives under, mirroring VideoProject.
  category    String   @default("file-sharing")
  title       String
  description String   @default("")
  /// Storage key / URL for the uploaded object (R2 is stubbed today).
  storageKey  String   @default("")
  /// Original filename + MIME + size for display.
  fileName    String   @default("")
  mimeType    String   @default("")
  sizeBytes   Int      @default(0)
  /// Free-text status chip: active | archived.
  status      String   @default("active")
  isArchived  Boolean  @default(false)
  /// User.id of the admin who uploaded it (plain id, no FK — mirrors VideoProject).
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, isArchived])
}

model VideoProject {
  id          String   @id @default(cuid())
  /// Workspace category this project lives under. "marketing" today;
  /// reserved for future workspace sections.
  category    String   @default("marketing")
  title       String
  summary     String   @default("")
  /// Free-text status chip: active | wrapped | archived.
  status      String   @default("active")
  isArchived  Boolean  @default(false)
  /// User.id of the admin who created it (plain id, no FK relation — keeps
  /// the User model untouched; attribution by id is enough).
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scripts Script[]

  @@index([category, isArchived])
}

model Script {
  id          String       @id @default(cuid())
  projectId   String
  project     VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  /// Which editor renders this script: "sections" | "richtext". Defaults
  /// to sections; flipped once the user picks the editor in P1.
  format      String       @default("sections")
  /// Rich-text document (TipTap JSON) when format = "richtext"; NULL for
  /// sections-format scripts (their content lives in ScriptSection rows).
  richContent Json?
  /// Display order within the project.
  order       Int          @default(0)
  isArchived  Boolean      @default(false)
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  sections      ScriptSection[]
  revisions     ScriptRevision[]
  comments      ScriptComment[]
  collaborators ScriptCollaborator[]
  shareTokens   ScriptShareToken[]
  presence      ScriptPresence[]

  @@index([projectId, isArchived])
}

model ScriptSection {
  id        String   @id @default(cuid())
  scriptId  String
  script    Script   @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  order     Int      @default(0)
  heading   String   @default("")
  /// Markdown body.
  body      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scriptId, order])
}

model ScriptRevision {
  id           String   @id @default(cuid())
  scriptId     String
  script       Script   @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  /// User.id when a logged-in user saved it; NULL for anonymous.
  authorUserId String?
  /// Display name captured at save time (user name or anon name).
  authorName   String   @default("Someone")
  /// "user" | "anon"
  authorKind   String   @default("anon")
  /// Full content snapshot at this save — { sections: [...] } or
  /// { richContent: {...} }. Enables one-click revert.
  snapshot     Json
  /// Short human summary, e.g. "Edited 'Voice And Tone'".
  summary      String   @default("")
  createdAt    DateTime @default(now())

  @@index([scriptId, createdAt])
}

model ScriptComment {
  id              String    @id @default(cuid())
  scriptId        String
  script          Script    @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  /// Section this comment is anchored to (NULL = whole-script).
  anchorSectionId String?
  /// Optional text-range anchor within the section/doc.
  anchorFrom      Int?
  anchorTo        Int?
  /// Thread parent (NULL = top-level comment).
  parentId        String?
  authorUserId    String?
  authorName      String    @default("Someone")
  authorKind      String    @default("anon")
  body            String
  /// open | resolved
  status          String    @default("open")
  /// Edit tracking — how many times the body was edited + when last edited.
  editCount       Int       @default(0)
  editedAt        DateTime?
  /// Snapshot of the anchored text, for re-locating the highlight after edits.
  anchorQuote     String?
  createdAt       DateTime  @default(now())

  @@index([scriptId, createdAt])
  @@index([parentId])
}

model ScriptCollaborator {
  id               String    @id @default(cuid())
  scriptId         String
  script           Script    @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  /// The name they gave when they opened the link. The row id is stored
  /// in an httpOnly cookie so we recognise them on return.
  name             String
  /// How many edits they've made — drives the "after 3" account offer.
  editCount        Int       @default(0)
  /// Set once they convert via the offer.
  email            String?
  convertedUserId  String?
  /// When they last dismissed the account offer (re-offer later).
  offerDismissedAt DateTime?
  firstSeenAt      DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())

  @@index([scriptId, lastSeenAt])
}

model ScriptShareToken {
  id          String    @id @default(cuid())
  scriptId    String
  script      Script    @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  /// URL-safe random token (~22 chars), unique for fast lookups.
  token       String    @unique
  /// Optional label ("For Molly", "Director cut").
  label       String?
  /// true = link grants editing; false = read-only.
  canEdit     Boolean   @default(true)
  /// null = no expiry; otherwise the public page returns 410 after this.
  expiresAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([scriptId, createdAt])
}

/// Ephemeral live-presence for collaborative script editing. One row per
/// active editor per script, refreshed by a ~2s client heartbeat. Drives the
/// near-real-time "who's here + who's editing which section" highlights —
/// each editor gets a stable colour. Rows go stale (not seen) and are swept.
model ScriptPresence {
  id         String   @id @default(cuid())
  scriptId   String
  script     Script   @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  /// Stable identity for the editor in this script — User.id for a logged-in
  /// user, else the anonymous collaborator id.
  editorKey  String
  name       String   @default("Someone")
  /// Hex colour assigned to this editor (client-derived from editorKey).
  color      String   @default("#3b82f6")
  /// data-sid of the section their caret is currently in (NULL = none).
  activeSid  String?
  /// Comma-separated data-sids they've edited recently (fading highlight).
  recentSids String   @default("")
  lastSeenAt DateTime @default(now())

  @@unique([scriptId, editorKey])
  @@index([scriptId, lastSeenAt])
}

// ─────────────────────────────────────────────────────────────────────────
// WORKSPACE → Marketing → Outreach. Contact lists for cross-promotion of
// BHN programs. Lists carry their own editable column definitions (admins
// can add/rename/remove/reorder columns); contacts store cell values as
// JSON keyed by column key, plus who added them (attribution).
// ─────────────────────────────────────────────────────────────────────────

model OutreachList {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  /// Ordered column definitions: [{ key: string, label: string }]
  columns     Json
  order       Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contacts OutreachContact[]

  memberships OutreachMembership[]

  shareTokens   OutreachShareToken[]
  collaborators OutreachCollaborator[]
  touches       OutreachTouch[]
  campaigns     OutreachCampaign[]

  @@index([order])
}

model OutreachContact {
  id          String       @id @default(cuid())
  listId      String
  list        OutreachList @relation(fields: [listId], references: [id], onDelete: Cascade)
  /// Cell values keyed by the list's column keys.
  values      Json
  order       Int          @default(0)
  /// Attribution — who added this contact. Plain User.id (no FK) + a
  /// denormalised display name so seeded/legacy rows can carry names
  /// like "Roshni" without a platform account.
  addedById   String?
  addedByName String       @default("BHN team")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([listId, order])
}

// ── Outreach v2: central directory ──────────────────────────────────────
// One OutreachPerson per real human (shared fields: org/name/title/email,
// keyed by the global person-column config in PlatformSetting
// "outreachPersonColumns"). OutreachMembership links a person into a list
// and carries the per-list fields (the list's `columns`, e.g. Notes).
// Editing a person updates them in every list; a person can sit in many
// lists without duplication. OutreachContact above is the legacy v1 table —
// rows are migrated into people+memberships at runtime, then removed.

model OutreachPerson {
  id              String    @id @default(cuid())
  /// Shared field values keyed by the global person-column keys.
  values          Json
  addedById       String?
  addedByName     String    @default("BHN team")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  /// When the introduction email was sent. null = net-new contact that still
  /// needs an intro; set = they already know us (gets the returning/thank-you
  /// campaign copy). Backfilled to createdAt for everyone predating this field.
  introSentAt     DateTime?
  /// Set when this contact opts out. CASL requires an unsubscribe that keeps
  /// working for 60 days after the message, and that we honour it within 10
  /// business days — so this is checked on every send, permanently.
  unsubscribedAt  DateTime?
  /// Why, when they told us — free text from the unsubscribe page.
  unsubscribeNote String?

  memberships OutreachMembership[]
  touches     OutreachTouch[]
  sends       OutreachSend[]
}

/// One row per (campaign, person) the platform has tried to email.
///
/// The server's record of what was actually sent, as opposed to
/// OutreachCampaign.sentPersonIds, which is the human ticking off mail they
/// sent from their own client. The unique pair is the idempotency key: a
/// double-click, a retry or a refresh cannot mail the same partner twice.
model OutreachSend {
  id         String           @id @default(cuid())
  campaignId String
  campaign   OutreachCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  personId   String
  person     OutreachPerson   @relation(fields: [personId], references: [id], onDelete: Cascade)
  /// Address used, captured at send time — the directory value can change later.
  email      String
  /// queued | sent | failed | skipped
  /// skipped covers no address, malformed address, and unsubscribed.
  status     String           @default("queued")
  /// Why it was skipped or how it failed. Shown to staff, never to the contact.
  detail     String?
  subject    String           @default("")
  /// Rendered body kept verbatim: the template and its variables both change,
  /// so without this there is no way to know what a partner was actually sent.
  body       String           @default("")
  sentAt     DateTime?
  byId       String?
  byName     String           @default("BHN team")
  createdAt  DateTime         @default(now())

  @@unique([campaignId, personId])
  @@index([campaignId, status])
}

model OutreachMembership {
  id          String         @id @default(cuid())
  listId      String
  list        OutreachList   @relation(fields: [listId], references: [id], onDelete: Cascade)
  personId    String
  person      OutreachPerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  /// Per-list field values keyed by the list's column keys.
  values      Json
  order       Int            @default(0)
  addedById   String?
  addedByName String         @default("BHN team")
  createdAt   DateTime       @default(now())

  @@unique([listId, personId])
  @@index([listId, order])
}

/// Public share link for ONE outreach list — /outreach/<token>. Anyone with
/// the link can view and (when canEdit) add contacts + edit cells, no
/// account needed; they give a name first (OutreachCollaborator) so
/// attribution holds. Mirrors ScriptShareToken.
model OutreachShareToken {
  id          String       @id @default(cuid())
  listId      String
  list        OutreachList @relation(fields: [listId], references: [id], onDelete: Cascade)
  token       String       @unique
  label       String?
  canEdit     Boolean      @default(true)
  expiresAt   DateTime?
  createdById String?
  createdAt   DateTime     @default(now())

  @@index([listId, createdAt])
}

/// Named anonymous editor on a shared outreach list. The row id lives in an
/// httpOnly per-list cookie; contacts they add carry their name.
model OutreachCollaborator {
  id          String       @id @default(cuid())
  listId      String
  list        OutreachList @relation(fields: [listId], references: [id], onDelete: Cascade)
  name        String
  firstSeenAt DateTime     @default(now())
  lastSeenAt  DateTime     @default(now())

  @@index([listId, lastSeenAt])
}

/// One logged reach-out to a directory person — when it happened, what it
/// was (kind + note), and who initiated it. Optionally tied to the list it
/// was made for; survives list deletion (SetNull) so the person's history
/// stays complete.
model OutreachTouch {
  id         String         @id @default(cuid())
  personId   String
  person     OutreachPerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  listId     String?
  list       OutreachList?  @relation(fields: [listId], references: [id], onDelete: SetNull)
  /// email | call | meeting | linkedin | event | other
  kind       String         @default("email")
  note       String         @default("")
  happenedAt DateTime       @default(now())
  byId       String?
  byName     String         @default("BHN team")
  createdAt  DateTime       @default(now())

  @@index([personId, happenedAt])
}

/// An outreach CAMPAIGN — a planned, trackable cross-promotion push using one
/// email template against a target audience (a list, or null = the whole
/// directory). The roster is derived live from the audience; `sentPersonIds`
/// records who's been reached so the campaign shows progress. `vars` holds the
/// campaign-level template fields (program / event / deadline / link) that fill
/// the {{placeholders}}; per-contact name/org/email come from the person.
model OutreachCampaign {
  id                  String         @id @default(cuid())
  name                String
  /// Target list; null = everyone in the directory.
  listId              String?
  list                OutreachList?  @relation(fields: [listId], references: [id], onDelete: SetNull)
  /// Email template id from the outreach templates library — the INTRO version,
  /// used for contacts who haven't been introduced yet (introSentAt null).
  templateId          String
  /// Optional second template for contacts who already know us (introSentAt
  /// set) — opens by thanking them for their earlier support instead of
  /// introducing BHN. Null = use the intro template for everyone.
  returningTemplateId String?
  /// Campaign-level template variables keyed by token (programName, deadline…).
  vars                Json
  /// personIds already reached in this campaign (drives progress).
  sentPersonIds       Json
  /// draft | active | done
  status              String         @default("draft")
  notes               String         @default("")
  createdById         String?
  createdByName       String         @default("BHN team")
  sends               OutreachSend[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([createdAt])
}

// ── Mock Interview practice ──────────────────────────────────────────────
// A self-practice interview session for a trainee. The AI generates
// role-specific questions; the candidate answers by voice (Whisper STT) or
// text; each answer is scored + given feedback; the session ends with an
// overall summary. Voice is optional — typing works everywhere.
model MockInterview {
  id           String   @id @default(cuid())
  userId       String
  role         String
  /// Optional focus / pasted job description the questions are tailored to.
  context      String   @default("")
  status       String   @default("in_progress") // in_progress | complete
  overallScore Int?
  summary      String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  answers MockInterviewAnswer[]

  @@index([userId, createdAt])
}

model MockInterviewAnswer {
  id           String        @id @default(cuid())
  interviewId  String
  interview    MockInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  order        Int
  question     String
  /// behavioral | technical | situational | motivation
  questionKind String        @default("behavioral")
  transcript   String        @default("")
  inputMode    String        @default("text") // voice | text
  score        Int? // 0–100 (content)
  feedback     String        @default("")
  strengths    Json          @default("[]")
  improvements Json          @default("[]")
  /// Voice-confidence read (0–100) + delivery metrics from the recording.
  confidence   Int?
  wpm          Int?
  fillerCount  Int?
  deliveryNote String        @default("")
  /// AI coaching for THIS question — how to approach it + what employers
  /// really want to hear. Generated on demand, cached here.
  /// { intent, approach, wantToHear[], avoid[], modelOutline[] }
  guidance     Json?
  /// Voice-coach read of the spoken answer (voice answers only).
  /// { tone, composure, stumbles, tip } + raw acoustics.
  voice        Json?
  stumbleCount Int?
  answeredAt   DateTime?
  createdAt    DateTime      @default(now())

  @@index([interviewId, order])
}

/// Public, no-login share link for the EQUIP tracking report (the full
/// recipient intelligence dossier at /admin/equip/tracker?view=report).
/// Possession of the token URL grants read-only access to the dossier —
/// there is no session check on /share/equip-report/[token]. Minting and
/// revoking are admin-only; revoke = delete the row (the page then 404s).
/// The dossier itself is not per-row data — every valid token renders the
/// same current curated dossier — so there is no relation column.
model EquipReportShareToken {
  id          String    @id @default(cuid())
  /// URL-safe random token (~22 chars, 128-bit). Unique + indexed for
  /// fast lookups on the public share page.
  token       String    @unique
  /// Optional label the sharer gave the link ("For the DMZ partners").
  label       String?
  /// Who minted the link. Plain column (no FK) — audit/display only; the
  /// link must outlive the sharer's account.
  createdById String?
  /// null = never expires; otherwise the public page shows an expired
  /// state after this time.
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([createdAt])
}

// ── Newsletter workshop ─────────────────────────────────────────
// Colleagues drop raw contributions into an issue; the AI normalises
// each into structured fields and a deterministic renderer emits the
// Mailchimp-safe HTML. Sections mirror the programme vocabulary
// (ENGAGE / EXPERIENCE / EQUIP) plus a per-issue events block.

/// One month's newsletter. Holds the pieces plus the last render.
model NewsletterIssue {
  id           String    @id @default(cuid())
  /// Display title, e.g. "August 2026".
  title        String
  /// Right-aligned dateline printed in the masthead ("August 2026").
  dateline     String
  /// Optional preheader — the hidden preview line email clients show.
  preheader    String?
  /// draft | generated | sent
  status       String    @default("draft")
  /// Last AI-composed Mailchimp HTML. Null until first generate.
  renderedHtml String?
  /// When renderedHtml was last produced, so the UI can warn that
  /// pieces changed since the last render.
  renderedAt   DateTime?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  pieces   NewsletterPiece[]
  comments NewsletterComment[]

  @@index([status, createdAt])
}

/// One contribution. `rawBody` is exactly what the colleague pasted;
/// everything below it is what the AI derived, so a re-run can always
/// start from the original submission.
model NewsletterPiece {
  id         String   @id @default(cuid())
  issueId    String
  /// engage | experience | equip | event
  section    String
  /// Sort order within its section. Lower renders first.
  position   Int      @default(0)
  /// Verbatim submission — never overwritten by the AI.
  rawBody    String
  /// Optional link the contributor wants the CTA to point at.
  sourceUrl  String?
  /// Who dropped it in. Plain column: the piece outlives the account.
  authorName String?
  authorId   String?
  /// submitted | normalised | excluded
  status     String   @default("submitted")
  /// AI-derived layout fields. Shape:
  ///   { headline, subhead, body, glance: [{label,value,accent?}],
  ///     ctaLabel, ctaUrl, people: [{name,detail,org}] }
  /// Null until the piece has been normalised.
  layout     Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  issue NewsletterIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId, section, position])
}

/// One month of newsletter production. Created by the content calendar,
/// which derives every date by walking backwards from the send date in
/// business days (src/lib/newsletter/schedule.ts). Dates are plain
/// calendar days, not timestamps: a production schedule is a human
/// agreement about days, and storing instants invites an off-by-one
/// every time the server and Toronto disagree about the date.
/// A hand-drawn process diagram. Nodes and edges live in one JSON blob
/// rather than as rows: a flow chart is edited as a whole (drag five
/// boxes, redraw two arrows, save once), so per-node rows would mean a
/// transaction per drag and no cheap undo. The shape is
///   { nodes: [{id,x,y,w,h,kind,text}], edges: [{id,from,to,label}] }
/// and is validated at the API boundary, never trusted from the client.
model FlowChart {
  id      String  @id @default(cuid())
  title   String
  /// URL-safe identifier, unique so a chart has a stable link.
  slug    String  @unique
  /// One-line description shown in the chart list.
  summary String?
  data    Json

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([updatedAt])
}

model NewsletterCycle {
  id               String  @id @default(cuid())
  /// First day of the month this issue belongs to, "YYYY-MM-01".
  /// Unique: one issue per month is the whole point of the calendar.
  month            String  @unique
  /// "YYYY-MM-DD" milestones, in the order they happen.
  draftOpen        String
  draftDue         String
  buildStart       String
  approvalDue      String
  sendDate         String
  /// True when a holiday pushed the send date off its configured weekday.
  sendDateAdjusted Boolean @default(false)

  /// planned | active | approved | sent | skipped
  /// A cycle stays `planned` until its draft window opens, so a calendar
  /// generated a year out is visibly provisional.
  status String @default("planned")

  /// The workshop issue this cycle produces, once one exists. Plain
  /// column with no FK, matching NewsletterIssue.createdById — a cycle
  /// is a calendar fact that outlives any issue row it points at.
  issueId String?

  /// Sign-off. The approver has the final say; we record that it
  /// happened and nothing else. Name is snapshotted so the record still
  /// reads correctly if the account is later renamed or removed.
  approvedAt     DateTime?
  approvedById   String?
  approvedByName String?
  approvalNote   String?

  /// The schedule config used to plan this cycle, so a later config
  /// change never silently rewrites history.
  configSnapshot Json?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reminders NewsletterReminder[]

  @@index([sendDate])
  @@index([status, sendDate])
}

/// One scheduled nudge inside a cycle. The unique (cycleId, kind) pair is
/// the idempotency key: the daily sweep claims a row by flipping status
/// before it mails, so a cron that runs twice cannot send twice — the
/// same claim-before-send discipline as OutreachSend.
/// Every send attempt for a reminder — real sends, forwarding copies,
/// tests, and failures. NewsletterReminder only keeps the LAST send on
/// itself, which cannot answer "did we already chase them, and what did
/// we actually say". Append-only; nothing here is ever updated.
model NewsletterSendLog {
  id         String   @id @default(cuid())
  reminderId String
  /// draft_request | draft_due | approval | send_day — copied so the log
  /// still reads correctly if the reminder row is later removed.
  kind       String
  /// auto — went to the real recipients.
  /// manual — went to the coordinator to forward on.
  /// test — went only to the admin previewing it.
  mode       String
  /// sent | failed
  status     String
  /// Snapshot of what actually went out, so an edited send is auditable.
  subject    String
  sentTo     String[] @default([])
  sentCc     String[] @default([])
  /// Transport error when status = failed.
  error      String?
  sentById   String?
  sentByName String?
  createdAt  DateTime @default(now())

  reminder NewsletterReminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@index([reminderId, createdAt])
}

model NewsletterReminder {
  id           String    @id @default(cuid())
  cycleId      String
  /// draft_request | draft_due | approval | send_day
  kind         String
  /// "YYYY-MM-DD" — the day this fires.
  scheduledFor String
  /// auto   — the platform emails the recipients itself.
  /// manual — the platform emails only the coordinator a ready-to-send
  ///          copy and they send it by hand.
  mode         String    @default("manual")
  /// pending | sent | skipped | failed
  status       String    @default("pending")
  /// Who it went to, snapshotted at send time so the record survives a
  /// later change to the configured recipient list.
  sentTo       String[]  @default([])
  sentCc       String[]  @default([])
  sentAt       DateTime?
  /// Transport error from the last failed attempt, for the admin UI.
  error        String?
  /// Set when a human sent this reminder themselves rather than the cron.
  sentById     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cycle NewsletterCycle     @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  sends NewsletterSendLog[]

  @@unique([cycleId, kind])
  @@index([status, scheduledFor])
}

/// A review note pinned to one element of the rendered newsletter.
///
/// Anchoring deliberately mirrors ScriptComment rather than the external
/// page-review overlay's CSS path: the newsletter HTML is REGENERATED
/// every time the AI layout re-runs, so a structural selector goes stale
/// on every regenerate. A piece id plus the quoted text survives that,
/// because the piece keeps its id and the wording usually keeps its text.
/// cssPath is stored only as a last-resort fallback for locating a
/// comment whose quote no longer appears.
model NewsletterComment {
  id          String  @id @default(cuid())
  issueId     String
  /// The NewsletterPiece the note is pinned to. Null for a note about
  /// the issue as a whole (masthead, ordering, "this section is thin").
  pieceId     String?
  /// Verbatim text of the element that was clicked — the primary way a
  /// comment finds its home again after a regenerate.
  anchorQuote String?
  /// Human label for the anchor ("Headline", "Paragraph 2", "CTA").
  anchorLabel String?
  /// Structural fallback, relative to the piece wrapper.
  cssPath     String?

  body   String
  /// open | resolved
  status String @default("open")

  /// Author snapshot — a comment outlives the account that wrote it.
  authorId     String?
  authorName   String?
  /// Who last edited, if anyone. The workspace is shared: anyone may
  /// edit or delete anyone's note, and the record says who did.
  editedById   String?
  editedByName String?
  editedAt     DateTime?

  resolvedAt   DateTime?
  resolvedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issue NewsletterIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId, status, createdAt])
  @@index([issueId, pieceId])
}

// ── Website review ──────────────────────────────────────────────
// Colleagues leave threaded comments on elements of a live page
// (biohubnet.ca or anything else). The collected thread exports as a
// Markdown brief for Claude Code / Codex, and each export is stamped as
// a round so the revision history is reconstructable.

/// One page under review. Rounds increment each time a brief is exported,
/// so comments can be attributed to the revision they informed.
model PageReview {
  id           String    @id @default(cuid())
  /// Full URL under review.
  url          String
  /// Human label — "ENGAGE · Regulatory Affairs".
  title        String
  /// open | exported | closed
  status       String    @default("open")
  /// Current round. Bumped on export; comments record the round they
  /// were filed under.
  round        Int       @default(1)
  /// Optional HTML snapshot captured when the review opened — the
  /// "before" for diffing a later revision.
  snapshotHtml String?
  snapshotAt   DateTime?
  /// Share token letting colleagues comment without a platform account
  /// (the bookmarklet carries it). Null disables anonymous commenting.
  shareToken   String?   @unique
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  comments PageComment[]

  @@index([status, updatedAt])
}

/// One comment. Threading via parentId; anchors are stored at four
/// decreasing precisions so a comment survives the page being edited.
model PageComment {
  id       String  @id @default(cuid())
  reviewId String
  /// Thread parent. NULL = top-level.
  parentId String?
  /// Round this was filed under.
  round    Int     @default(1)

  // ── Anchors, most reliable first ──
  /// Text content of the element when the comment was made. The primary
  /// re-locator — survives class and structure changes.
  anchorQuote String?
  /// Nearest stable id/class, e.g. "#hero" or ".vc_custom_heading_5f3a".
  anchorKey   String?
  /// Full CSS selector path from the capture script.
  anchorPath  String?
  /// Which WPBakery raw-HTML block the element sat in, when known — the
  /// rendered selector doesn't map to source without it.
  anchorBlock String?
  /// found | orphaned — set when a later capture can't re-locate it.
  anchorState String  @default("found")

  authorUserId String?
  authorName   String    @default("Someone")
  /// user | anon — anon comments arrive via the share token.
  authorKind   String    @default("user")
  body         String
  /// open | resolved | wontfix
  status       String    @default("open")
  editCount    Int       @default(0)
  editedAt     DateTime?
  /// Who last edited the body. Any reviewer may edit any comment, so the
  /// author alone no longer accounts for the words — without this, the
  /// export brief would attribute someone else's wording to the original
  /// author. NULL means never edited, or edited before this was recorded.
  /// Deliberately denormalised (no FK): the brief and the on-page overlay
  /// need a name without joining User, and the label should survive the
  /// editor's account being removed.
  editedById   String?
  editedByName String?
  createdAt    DateTime  @default(now())

  review PageReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId, createdAt])
  @@index([parentId])
}
