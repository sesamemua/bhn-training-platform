{
  "name": "bhn-training-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "prisma generate && prisma migrate deploy && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "eval": "tsx evals/run.ts --save",
    "eval:ci": "tsx evals/run.ts --no-llm --check",
    "eval:baseline": "tsx evals/run.ts --no-llm --write-baseline",
    "test:e2e": "playwright test",
    "test:page-review": "tsx --test tests/unit/page-review-security.test.ts",
    "test:page-review:browser": "tsx tests/browser/page-review-overlay.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:outreach": "tsx --test tests/unit/outreach-send.test.ts",
    "vercel": "bash scripts/vercel.sh",
    "test:merch": "tsx --test tests/unit/merch.test.ts",
    "test:demo": "tsx --test tests/unit/demo-mode.test.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "deploy:demo": "bash scripts/deploy-demo.sh",
    "test:newsletter": "tsx --test tests/unit/newsletter-schedule.test.ts tests/unit/newsletter-config.test.ts",
    "test:ics": "tsx --test tests/unit/ics.test.ts",
    "test:decisions": "tsx --test tests/unit/decisions.test.ts",
    "test:logos": "tsx --test tests/unit/logo-options.test.ts",
    "test:form": "tsx --test tests/unit/form-fill-view.test.tsx tests/unit/formbuilder-logic.test.ts tests/unit/formbuilder-calendar.test.ts tests/unit/formbuilder-submit.test.ts tests/unit/linkify.test.ts tests/unit/throttle.test.ts tests/unit/receipt.test.ts",
    "test:email": "tsx --test tests/unit/email-templates.test.ts",
    "test:schedule": "tsx --test tests/unit/allocation-schedule.test.ts tests/unit/training-week-schedule.test.ts",
    "test:flowchart": "tsx --test tests/unit/flowchart-form.test.ts tests/unit/flowchart-route.test.ts tests/unit/flowchart-institutions.test.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1113.0",
    "@aws-sdk/s3-request-presigner": "^3.1113.0",
    "@gsap/react": "^2.1.2",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@tailwindcss/typography": "^0.5.20",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "@types/archiver": "^7.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.22",
    "@types/nodemailer": "^8.0.0",
    "@types/unzipper": "^0.10.11",
    "@types/uuid": "^10.0.0",
    "@types/xml2js": "^0.4.14",
    "algoliasearch": "^5.57.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "gsap": "^3.15.0",
    "html2canvas": "^1.4.1",
    "inngest": "^4.18.1",
    "jose": "^6.2.9",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.32.0",
    "mammoth": "^1.12.1",
    "next": "16.3.1",
    "next-auth": "^4.24.15",
    "nodemailer": "^7.0.13",
    "otplib": "^12.0.1",
    "prisma": "^6.19.3",
    "qrcode-svg": "^1.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-dropzone": "^15.0.0",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^9.0.1",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.0",
    "scorm-again": "^3.3.0",
    "stripe": "^22.5.0",
    "tailwind-merge": "^3.6.0",
    "twilio": "^6.1.0",
    "unpdf": "^1.8.1",
    "unzipper": "^0.12.5",
    "uuid": "^14.0.2",
    "xml2js": "^0.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}