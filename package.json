    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "gsap": "^3.15.0",
    "html2canvas": "^1.4.1",
    "inngest": "^4.5.1",
    "jose": "^6.2.3",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.14.0",
    "mammoth": "^1.12.0",
    "next": "16.3.4",
    "next-auth": "^4.24.15",
    "nodemailer": "^10.0.0",
    "otplib": "^12.0.1",
    "pdf-lib": "^1.17.1",
    "qrcode-svg": "^1.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-dropzone": "^15.0.0",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^9.0.1",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.0",
    "scorm-again": "^3.0.4",
    "stripe": "^22.2.0",
    "tailwind-merge": "^3.5.0",
    "twilio": "^6.0.2",
    "unpdf": "^1.6.2",
    "unzipper": "^0.12.3",
    "uuid": "^14.0.0",
    "xml2js": "^0.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
