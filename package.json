{
  "name": "bhn-training-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "prisma generate && prisma migrate deploy && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "eval": "tsx evals/run.ts --save",
    "eval:ci": "tsx evals/run.ts --no-llm --check",
    "eval:baseline": "tsx evals/run.ts --no-llm --write-baseline",
    "test:e2e": "playwright test",
    "test:page-review": "tsx --test tests/unit/page-review-security.test.ts",
    "test:page-review:browser": "tsx tests/browser/page-review-overlay.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:outreach": "tsx --test tests/unit/outreach-send.test.ts",
    "vercel": "bash scripts/vercel.sh",
    "test:equip-cap": "tsx --test tests/unit/equip-cap.test.ts",
    "test:merch": "tsx --test tests/unit/merch.test.ts",
    "test:symposium-av": "tsx --test tests/unit/symposium-av.test.ts",
    "test:demo": "tsx --test tests/unit/demo-mode.test.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "deploy:demo": "bash scripts/deploy-demo.sh",
    "test:newsletter": "tsx --test tests/unit/newsletter-handoff.test.ts tests/unit/newsletter-schedule.test.ts tests/unit/newsletter-config.test.ts",
    "test:equip": "tsx --test tests/unit/equip-delete.test.ts tests/unit/equip-institutions.test.ts tests/unit/equip-apply-entry.test.ts tests/unit/equip-connect-form.test.tsx tests/unit/equip-public-document-upload.test.ts tests/unit/equip-venture-connect-receipt.test.ts tests/unit/equip-venture-connect-packet.test.ts tests/unit/equip-innovation-fellowship-validation.test.ts tests/unit/equip-innovation-fellowship-receipt.test.ts tests/unit/equip-innovation-fellowship-packet.test.ts tests/unit/equip-submitted-view.test.tsx tests/unit/equip-copy-recipients.test.ts tests/unit/mail-recipients.test.ts",
    "test:eligibility": "tsx --test tests/unit/eligibility-email-key.test.ts tests/unit/eligibility-gate.test.ts",
    "test:speaker": "tsx --test tests/unit/speaker-limits.test.ts tests/unit/speaker-intake-form.test.tsx tests/unit/bio-shorten.test.ts tests/unit/notify.test.ts tests/unit/speaker-submission-email.test.ts",
    "test:insights": "tsx --test tests/unit/industry-insights.test.ts",
    "test:ics": "tsx --test tests/unit/ics.test.ts",
    "test:decisions": "tsx --test tests/unit/decisions.test.ts",
    "test:logos": "tsx --test tests/unit/logo-options.test.ts",
    "test:form": "tsx --test tests/unit/form-fill-view.test.tsx tests/unit/formbuilder-logic.test.ts tests/unit/formbuilder-calendar.test.ts tests/unit/formbuilder-submit.test.ts tests/unit/linkify.test.ts tests/unit/throttle.test.ts tests/unit/receipt.test.ts",
    "test:email": "tsx --test tests/unit/email-templates.test.ts",
    "test:schedule": "tsx --test tests/unit/allocation-schedule.test.ts tests/unit/training-week-schedule.test.ts",
    "test:flowchart": "tsx --test tests/unit/flowchart-form.test.ts tests/unit/flowchart-route.test.ts tests/unit/flowchart-institutions.test.ts",
    "test:campaign": "tsx --test tests/unit/campaign-attribution.test.ts tests/unit/campaign-eligibility.test.ts tests/unit/campaign-content.test.ts tests/unit/google-ads-pilot.test.ts tests/unit/google-ads-conversions.test.ts tests/unit/google-ads-workspace.test.ts tests/unit/google-ads-workspace-defaults.test.ts",
    "test:campaign:e2e": "playwright test --config=playwright.campaign.config.ts"
  },
