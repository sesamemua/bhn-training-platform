# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# eval harness run artifacts (evals/baseline.json IS committed; reports are per-run)
/evals/report.json
/evals/report.md
/evals/summary.txt

# MCP server (Python) artifacts
/mcp/.venv/
mcp/**/__pycache__/
*.pyc
/mcp/*.egg-info/
/mcp/.pytest_cache/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# database
prisma/*.db
prisma/*.db-journal

# uploaded content (user-generated, not source)
/public/uploads/scorm/
/public/uploads/thumbnails/
/public/uploads/certificates/

!.env.example
.env*.local

# Playwright — auth state holds live session cookies; reports are
# uploaded as CI artifacts so no need to keep locally.
/playwright/.auth/
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# Database dumps written by the guarded apply/seed scripts.
# They can contain registrant names and email addresses.
backups/
